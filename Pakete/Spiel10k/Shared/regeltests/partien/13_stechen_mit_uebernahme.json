{
 "name": "13_stechen_mit_uebernahme",
 "beschreibung": "Digital: keine Übernahme über den Beginn des Stechens hinweg, innerhalb der Stechrunde schon.",
 "rules": {"roundLimit": 1},
 "players": ["Anna", "Ben"],
 "dice": [1, 2, 3, 4, 6, 1, 3, 3, 4, 6, 1, 1, 2, 3, 4, 5, 2, 3, 4],
 "steps": [
  {"action": {"type": "roll", "keep": []}},
  {"action": {"type": "bank", "keep": [0]}, "expect": {"offer": {"from": 0, "points": 100, "dice": [1, 2, 3, 4, 6], "kept": [true, false, false, false, false]}}},
  {"action": {"type": "declineOffer"}},
  {"action": {"type": "roll", "keep": []}},
  {"action": {"type": "bank", "keep": [0]}, "expect": {"offer": null, "current": 0, "tiebreak": {"players": [0, 1], "round": 1, "points": []}, "scores": [100, 100]}},
  {"action": {"type": "acceptOffer"}, "error": true},
  {"action": {"type": "roll", "keep": []}},
  {"action": {"type": "bank", "keep": [0]}, "expect": {"current": 1, "offer": {"from": 0, "points": 100, "dice": [1, 1, 2, 3, 4], "kept": [true, false, false, false, false]}, "tiebreak": {"players": [0, 1], "round": 1, "points": [100]}}},
  {"action": {"type": "acceptOffer"}, "expect": {"turn": {"dice": [1, 5, 2, 3, 4], "banked": 100, "inheritedFrom": 0, "fullThrow": false}}},
  {"action": {"type": "bank", "keep": [1]}, "expect": {"winners": [1], "offer": null}}
 ],
 "expected": {"winners": [1], "scores": [200, 250], "offer": null, "tiebreak": {"players": [0, 1], "round": 1, "points": [100, 150]}, "log": [[0, 100, 0], [1, 100, 0], [0, 100, 0], [1, 150, 0]]}
}
