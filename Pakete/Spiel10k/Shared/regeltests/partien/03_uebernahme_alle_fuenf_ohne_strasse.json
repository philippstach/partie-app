  {"action": {"type": "acceptOffer"}, "expect": {"offer": null, "canUndo": false, "turn": {"dice": [1, 2, 3, 4, 5], "locked": [false, false, false, false, false], "banked": 1100, "hasRolled": true, "fullThrow": false, "inheritedFrom": 0, "inheritedPoints": 1100}}},
  {"action": {"type": "bank", "keep": [0, 1, 2, 3, 4]}, "error": true},
