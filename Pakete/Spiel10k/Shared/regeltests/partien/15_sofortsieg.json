{
 "name": "15_sofortsieg",
 "beschreibung": "Wer das Ziel erreicht, gewinnt sofort (kein Angebot). Rückgängig nach dem Sieg ist möglich.",
 "rules": {"goal": 1000},
 "players": ["Anna", "Ben"],
 "dice": [1, 1, 1, 2, 3, 2, 3],
 "steps": [
  {"action": {"type": "roll", "keep": []}},
  {"action": {"type": "bank", "keep": [0, 1, 2]}, "expect": {"winners": [0], "offer": null, "current": 0, "scores": [1000, 0]}},
  {"action": {"type": "roll", "keep": []}, "error": true},
  {"action": {"type": "acceptOffer"}, "error": true},
  {"action": {"type": "declineOffer"}, "error": true},
  {"action": {"type": "bank", "keep": [3]}, "error": true},
  {"action": {"type": "undo"}, "expect": {"winners": [], "turn": {"dice": [1, 1, 1, 2, 3], "hasRolled": true}}},
  {"action": {"type": "roll", "keep": [0, 1, 2]}, "expect": {"log": [[0, 0, 0]], "current": 1, "scores": [0, 0]}}
 ],
 "expected": {"winners": [], "scores": [0, 0], "current": 1, "players": [{"mackes": 1, "streak": 1, "bestTurn": 0}, {}]}
}
