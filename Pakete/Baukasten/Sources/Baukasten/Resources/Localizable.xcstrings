    "Eine Mitteilung pro Tag, nur wenn das Tagesrätsel noch offen ist. Keine Werbung." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Mitteilung pro Tag, nur wenn das Tagesrätsel noch offen ist. Keine Werbung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One notification a day, only if the daily puzzle is still open. No ads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notificación al día, solo si el reto diario sigue abierto. Sin publicidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une notification par jour, seulement si l’énigme du jour est encore ouverte. Pas de publicité."
          }
        }
      }
    },
    "Freiwillig. Es wird nichts freigeschaltet, alle Funktionen bleiben für alle gleich." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freiwillig. Es wird nichts freigeschaltet, alle Funktionen bleiben für alle gleich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voluntary. Nothing is unlocked; every feature stays the same for everyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voluntario. No se desbloquea nada; todas las funciones siguen siendo iguales para todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Rien n’est débloqué ; toutes les fonctions restent identiques pour tous."
          }
        }
      }
    },
