    "Alle Tagesrätsel auf einen Blick; Tippen öffnet das nächste offene.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Tagesrätsel auf einen Blick; Tippen öffnet das nächste offene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All daily puzzles at a glance; tap to open the next open one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los rompecabezas del día de un vistazo; toca para abrir el siguiente pendiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les énigmes du jour en un coup d’œil ; touchez pour ouvrir la prochaine."
