          "stringUnit": {
            "state": "translated",
            "value": "Shows whether today’s puzzle is solved, and your streak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra si el reto de hoy está resuelto y tu racha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique si l’énigme du jour est résolue, et ta série."
          }
