            "value": "Classique (9 pions)"
          }
        }
      }
    },
    "Die Gänse gewinnen, wenn der Fuchs sich nicht mehr bewegen kann. Bleiben nur drei Gänse, gewinnt der Fuchs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gänse gewinnen, wenn der Fuchs sich nicht mehr bewegen kann. Bleiben nur drei Gänse, gewinnt der Fuchs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The geese win if the fox cannot move. If only three geese remain, the fox wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ocas ganan si el zorro no puede moverse. Si quedan solo tres ocas, gana el zorro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les oies gagnent si le renard ne peut plus bouger. S’il ne reste que trois oies, le renard gagne."
          }
        }
      }
    },
    "Zahlen 1 bis 9": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlen 1 bis 9"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbers 1 to 9"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Números del 1 al 9"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres de 1 à 9"
          }
        }
      }
    },
    "Nach jedem Stich ziehen beide nach. Wer am Ende mehr als 60 Augen hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach jedem Stich ziehen beide nach. Wer am Ende mehr als 60 Augen hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After each trick both draw. Whoever has more than 60 points at the end wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras cada baza ambos roban. Gana quien al final tenga más de 60 puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après chaque pli, les deux piochent. Qui a plus de 60 points à la fin gagne."
          }
        }
      }
    },
    "Landet der letzte Stein in deinem Haus, bist du gleich noch einmal dran.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Landet der letzte Stein in deinem Haus, bist du gleich noch einmal dran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your last seed lands in your store, you play again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu última semilla cae en tu almacén, juegas otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ta dernière graine tombe dans ton grenier, tu rejoues."
          }
        }
      }
    },
    "Beste Farbe": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beste Farbe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best suit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejor palo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meilleure couleur"
          }
        }
      }
    },
    "Farbe bedienen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbe bedienen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow suit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir el palo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournir la couleur"
          }
        }
      }
    },
    "Standard (7 zieht, 8 setzt aus)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard (7 zieht, 8 setzt aus)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard (7 draws, 8 skips)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estándar (7 roba, 8 salta)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard (7 pioche, 8 passe)"
          }
        }
      }
    },
    "Sobald jemand aufgelegt hat, drücken alle schnell „Hand drauf!“. Der Letzte ist der Esel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald jemand aufgelegt hat, drücken alle schnell „Hand drauf!“. Der Letzte ist der Esel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As soon as someone has laid down, everyone taps “Hands on!”. The last one is the donkey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cuanto alguien pone la mano, todos pulsan «¡Mano encima!». El último es el burro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès que quelqu’un a posé la main, tous appuient sur « Main dessus ! ». Le dernier est l’âne."
          }
        }
      }
    },
    "Stimmte es, nimmt der Zweifler den Haufen, sonst der Lügner. Wer zuerst keine Karten hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimmte es, nimmt der Zweifler den Haufen, sonst der Lügner. Wer zuerst keine Karten hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it was true, the doubter takes the pile, otherwise the liar. The first player with no cards wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si era cierto, se lleva el montón quien dudó; si no, el mentiroso. Gana quien se quede sin cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si c’était vrai, celui qui doute prend la pile, sinon le menteur. Le premier sans cartes gagne."
          }
        }
      }
    },
    "Die Trumpffarbe zeigt die unterste Karte des Stapels. As zählt 11, Drei 10, König 4, Reiter 3, Bube 2.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Trumpffarbe zeigt die unterste Karte des Stapels. As zählt 11, Drei 10, König 4, Reiter 3, Bube 2."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bottom card of the deck shows the trump suit. Ace counts 11, three 10, king 4, knight 3, jack 2."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carta de abajo del mazo marca el triunfo. El as vale 11, el tres 10, el rey 4, el caballo 3 y la sota 2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte du dessous du talon donne l’atout. L’as vaut 11, le trois 10, le roi 4, le cavalier 3, le valet 2."
          }
        }
      }
    },
    "Du würfelst fünf Würfel bis zu dreimal. Tippe die Würfel an, die du behalten willst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du würfelst fünf Würfel bis zu dreimal. Tippe die Würfel an, die du behalten willst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You roll five dice up to three times. Tap the dice you want to keep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiras cinco dados hasta tres veces. Toca los dados que quieres guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu lances cinq dés jusqu’à trois fois. Touche les dés que tu veux garder."
          }
        }
      }
    },
