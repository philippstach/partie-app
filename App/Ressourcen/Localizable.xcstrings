      }
    },
    "Geht kein Zug mehr, zählen die offenen Zahlen als Punkte. Die wenigsten Punkte gewinnen, alles zu ist null.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geht kein Zug mehr, zählen die offenen Zahlen als Punkte. Die wenigsten Punkte gewinnen, alles zu ist null."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When no move is left, the open numbers count as points. Fewest points wins; all shut is zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando no hay jugada, los números abiertos son tus puntos. Gana el menor; todo cerrado es cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand aucun coup n’est possible, les nombres ouverts sont tes points. Le moins gagne ; tout fermé vaut zéro."
          }
        }
      }
    },
    "Ansagen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Announce"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anunciar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annoncer"
          }
        }
      }
    },
    "Vorrat leeren": {
      "localizations": {
