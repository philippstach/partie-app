    "Das Brett liegt quer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Brett liegt quer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The board is sideways"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tablero está de lado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plateau est de côté"
          }
        }
      }
    },
    "Leg das Gerät flach zwischen euch: Das Brett ist um 90° gedreht, damit beide es von ihrer Seite aus sehen. Spieler 1 sitzt unten, Spieler 2 oben.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg das Gerät flach zwischen euch: Das Brett ist um 90° gedreht, damit beide es von ihrer Seite aus sehen. Spieler 1 sitzt unten, Spieler 2 oben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay the device flat between you: the board is turned 90° so both of you see it from your side. Player 1 sits at the bottom, player 2 at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon el dispositivo plano entre los dos: el tablero está girado 90° para que ambos lo vean desde su lado. El jugador 1 se sienta abajo y el jugador 2 arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose l’appareil à plat entre vous : le plateau est tourné de 90° pour que chacun le voie de son côté. Le joueur 1 est en bas, le joueur 2 en haut."
          }
        }
      }
    },
