    "regel.rausPflicht": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit 6 raus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six brings you out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
