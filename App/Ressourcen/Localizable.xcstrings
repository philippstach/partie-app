    "Aus: Schock aus gibt nur so viele Deckel wie eine Hälfte hat, das Spiel geht weiter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: Schock out gives only as many lids as one half has, and play goes on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: Schock aus reparte solo tantas tapas como tiene una mitad y el juego continúa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : Schock aus ne donne que le nombre de couvercles d’une moitié et la partie continue."
          }
        }
      }
    },
    "1 Hälfte verloren": {
      "localizations": {
