    "Zwei Sechsen ergeben eine Eins, drei Sechsen bis zu zwei Einsen. Danach wird weitergewürfelt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two sixes make a one, three sixes up to two ones. Then you roll on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos seises valen un uno, tres seises hasta dos unos. Después se sigue tirando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux six font un as, trois six jusqu’à deux as. Ensuite on continue à lancer."
          }
        }
      }
    },
    "Zwei Sechsen! Du darfst eine davon zur Eins umdrehen – dann würfelst du weiter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two sixes! Turn one into a one – then roll again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Dos seises! Puedes girar uno a uno; luego sigues tirando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux six ! Tu peux en retourner un en as, puis tu relances."
          }
        }
      }
    },
