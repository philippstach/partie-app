    "Buchstaben raten": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchstaben raten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guess letters"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adivinar letras"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deviner des lettres"
          }
        }
      }
    },
    "Ihr werft abwechselnd einen Stein in eine Spalte. Er fällt, bis er auf dem Boden oder einem anderen Stein liegt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr werft abwechselnd einen Stein in eine Spalte. Er fällt, bis er auf dem Boden oder einem anderen Stein liegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You take turns dropping a disc into a column. It falls until it rests on the bottom or on another disc."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Echáis fichas por turnos en una columna. Cae hasta apoyarse en el fondo o en otra ficha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous lâchez à tour de rôle un jeton dans une colonne. Il tombe jusqu’au fond ou jusqu’à un autre jeton."
          }
        }
      }
    },
    "Die Zahl auf einer Insel sagt, wie viele Brücken von ihr ausgehen. Am Ende müssen alle Inseln zusammenhängen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahl auf einer Insel sagt, wie viele Brücken von ihr ausgehen. Am Ende müssen alle Inseln zusammenhängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number on an island says how many bridges leave it. In the end all islands must be connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número de una isla indica cuántos puentes salen de ella. Al final todas las islas deben estar conectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiffre d’une île indique combien de ponts en partent. À la fin, toutes les îles doivent être reliées."
          }
        }
      }
    },
    "Buchstaben eintragen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchstaben eintragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter letters"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribir letras"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisir des lettres"
          }
        }
      }
    },
    "Schiebe, bis die Zahlen der Reihe nach stehen und die Lücke unten rechts ist. Weniger Züge sind besser.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiebe, bis die Zahlen der Reihe nach stehen und die Lücke unten rechts ist. Weniger Züge sind besser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide until the numbers are in order and the gap is at the bottom right. Fewer moves are better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hasta que los números estén en orden y el hueco quede abajo a la derecha. Cuantos menos movimientos, mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser jusqu’à ce que les nombres soient dans l’ordre et que la case vide soit en bas à droite. Moins de coups, c’est mieux."
          }
        }
      }
    },
    "Je Kategorie: 10 Punkte, 5 bei gleicher Antwort mehrerer Spieler, 20 wenn nur du eine gültige Antwort hast. Fünf Runden, die meisten Punkte gewinnen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Kategorie: 10 Punkte, 5 bei gleicher Antwort mehrerer Spieler, 20 wenn nur du eine gültige Antwort hast. Fünf Runden, die meisten Punkte gewinnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per category: 10 points, 5 if several players gave the same answer, 20 if only you have a valid answer. Five rounds, most points wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por categoría: 10 puntos, 5 si varios jugadores dan la misma respuesta, 20 si solo tú tienes una respuesta válida. Cinco rondas; gana quien tenga más puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par catégorie : 10 points, 5 si plusieurs joueurs ont la même réponse, 20 si tu es seul à avoir une réponse valable. Cinq manches, le plus de points gagne."
          }
        }
      }
    },
    "Kisten schieben": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kisten schieben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push the crates"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empujar cajas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousser les caisses"
          }
        }
      }
    },
    "Dunkel und hell": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkel und hell"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark and light"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscuro y claro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Foncé et clair"
          }
        }
      }
    },
    "Ein Stein ist frei, wenn kein anderer auf ihm liegt und er links oder rechts nichts berührt. Der Tipp zeigt ein mögliches Paar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Stein ist frei, wenn kein anderer auf ihm liegt und er links oder rechts nichts berührt. Der Tipp zeigt ein mögliches Paar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tile is free when nothing lies on top of it and it touches nothing on its left or right. The hint shows a possible pair."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ficha está libre si no hay otra encima y no toca nada a izquierda o derecha. La pista muestra una pareja posible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tuile est libre si rien n’est posé dessus et si elle ne touche rien à gauche ou à droite. L’indice montre une paire possible."
          }
        }
      }
    },
    "Schläger bewegen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schläger bewegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the paddle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover la pala"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouger la raquette"
          }
        }
      }
    },
    "Gefrorenes Wasser": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefrorenes Wasser"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frozen water"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agua helada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eau gelée"
          }
        }
      }
    },
    "Wer am schlechtesten würfelt, verliert die Runde und bekommt Deckel – so viele, wie der beste Wurf wert ist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer am schlechtesten würfelt, verliert die Runde und bekommt Deckel – so viele, wie der beste Wurf wert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever rolls worst loses the round and takes chips – as many as the best roll is worth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien tire peor pierde la ronda y recibe fichas, tantas como valga la mejor tirada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui qui lance le plus mal perd la manche et reçoit des jetons – autant que vaut le meilleur lancer."
          }
        }
      }
    },
    "Ballons platzen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ballons platzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balloons pop"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los globos explotan"
          }
        },
        "fr": {
