    "regel.rauswerfen.info": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Niemand fliegt raus. Auf ein Feld mit einer fremden Figur darfst du dann nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: nobody gets knocked out. You can’t land on another player’s piece."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: nadie es expulsado. No se puede caer en la ficha de otro jugador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : personne n’est renvoyé. On ne peut pas tomber sur le pion d’un autre joueur."
          }
        }
      }
    },
    "regel.schlagpflicht": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlagpflicht"
          }
        },
        "en": {
