    "Färben für die %@: Eine Kette aus gefüllten und umrandeten Zellen. Nur eine der beiden Gruppen stimmt. Zellen, die beide sehen, verlieren die Zahl.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färben für die %@: Eine Kette aus gefüllten und umrandeten Zellen. Nur eine der beiden Gruppen stimmt. Zellen, die beide sehen, verlieren die Zahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloring for the %@: a chain of filled and outlined cells. Only one of the two groups is right. Cells that see both lose the number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloreado para el %@: una cadena de celdas rellenas y con borde. Solo uno de los dos grupos es correcto. Las celdas que ven a ambos pierden el número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloriage pour le %@ : une chaîne de cases pleines et cerclées. Un seul des deux groupes est juste. Les cases qui voient les deux perdent le chiffre."
          }
        }
      }
    },
    "Fülle das Feld so, dass in jeder Zeile, jeder Spalte und jedem der neun 3×3-Kästchen jede Zahl von 1 bis 9 genau einmal vorkommt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fülle das Feld so, dass in jeder Zeile, jeder Spalte und jedem der neun 3×3-Kästchen jede Zahl von 1 bis 9 genau einmal vorkommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill the grid so that every row, every column and each of the nine 3×3 boxes contains every number from 1 to 9 exactly once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena la cuadrícula de modo que cada fila, cada columna y cada una de las nueve cajas de 3×3 contenga todos los números del 1 al 9 exactamente una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplis la grille de sorte que chaque ligne, chaque colonne et chacun des neuf blocs de 3×3 contienne chaque chiffre de 1 à 9 exactement une fois."
          }
        }
      }
    },
