    "iPad flach auf den Tisch legen: Jede Person bekommt am Rand ein Namensschild zu sich hin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad flach auf den Tisch legen: Jede Person bekommt am Rand ein Namensschild zu sich hin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay the iPad flat on the table: each person gets a name tag at the edge, facing them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca el iPad plano sobre la mesa: cada persona tiene en el borde una etiqueta con su nombre orientada hacia ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose l’iPad à plat sur la table : chaque personne a sur le bord une étiquette à son nom, tournée vers elle."
          }
        }
      }
    },
    "Sudoku %@, %@: Schaffst du dieses Rätsel?": {
      "localizations": {
