            "state": "translated",
            "value": "Fuera el once: varias cartas por turno, robar en lugar de pasar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onze dehors : plusieurs cartes par tour, piocher au lieu de passer."
          }
