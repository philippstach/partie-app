    "Bestenlisten und Erfolge von Apple. Ohne Game Center bleiben alle Ergebnisse nur auf deinem Gerät.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestenlisten und Erfolge von Apple. Ohne Game Center bleiben alle Ergebnisse nur auf deinem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaderboards and achievements from Apple. Without Game Center all results stay on your device only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clasificaciones y logros de Apple. Sin Game Center, todos los resultados quedan solo en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Classements et succès d’Apple. Sans Game Center, tous les résultats restent sur ton appareil."
          }
        }
      }
    },
