    },
    "Stein gewählt. Jetzt den passenden zweiten Stein antippen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tile selected. Now tap the matching second tile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficha elegida. Ahora toca la segunda ficha igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuile choisie. Touche maintenant la tuile identique."
          }
        }
      }
    },
    "Scheibe von Stab %lld auf Stab %lld gelegt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disc moved from peg %lld to peg %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disco movido del poste %lld al poste %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disque déplacé de la tige %lld à la tige %lld"
          }
        }
      }
    },
    "Nicht erlaubt: keine größere Scheibe auf eine kleinere": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not allowed: no larger disc on a smaller one"
          }
        },
        "es": {
