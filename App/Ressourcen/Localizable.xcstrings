    "Öffnet das nächste Tagesrätsel, das du heute noch nicht gelöst hast.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet das nächste Tagesrätsel, das du heute noch nicht gelöst hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
