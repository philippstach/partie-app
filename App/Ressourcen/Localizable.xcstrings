          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortir de la maison"
          }
        }
      }
    },
    "regeln.sechs": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einer 6 würfelst du noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a 6 you roll again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras un 6 vuelves a lanzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après un 6, tu relances."
          }
        }
      }
    },
    "regeln.sechs.titel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs heißt nochmal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A six means again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seis significa otra vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un six, on rejoue"
          }
        }
      }
    },
