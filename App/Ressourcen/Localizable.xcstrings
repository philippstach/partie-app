    "Der Quelltext und der Baukasten für eigene Spiele liegen auf GitHub. Wer mitbauen will, reicht Spiele ein und wird als Entwickler genannt.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Quelltext und der Baukasten für eigene Spiele liegen auf GitHub. Wer mitbauen will, reicht Spiele ein und wird als Entwickler genannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source code and the toolkit for your own games are on GitHub. If you want to help build, submit games and you’ll be credited as a developer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código fuente y el kit para juegos propios están en GitHub. Quien quiera colaborar envía juegos y se le menciona como desarrollador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code source et la boîte à outils pour tes propres jeux sont sur GitHub. Qui veut participer propose des jeux et est cité comme développeur."
          }
        }
      }
    },
