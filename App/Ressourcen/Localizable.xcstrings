            "value": "Dernière synchronisation : %@"
          }
        }
      }
    },
    "Abgleich fehlgeschlagen, wird später erneut versucht": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgleich fehlgeschlagen, wird später erneut versucht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync failed, will try again later"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al sincronizar; se reintentará más tarde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la synchronisation, nouvel essai plus tard"
          }
        }
      }
    },
    "Deine Daten liegen auf deinem Gerät und, solange der iCloud-Abgleich an ist, in deinem privaten iCloud-Speicher. Partie hat keine Konten, keine eigenen Server und kein Tracking.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten liegen auf deinem Gerät und, solange der iCloud-Abgleich an ist, in deinem privaten iCloud-Speicher. Partie hat keine Konten, keine eigenen Server und kein Tracking."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is stored on your device and, while iCloud sync is on, in your private iCloud storage. Partie has no accounts, no servers of its own and no tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos están en tu dispositivo y, mientras la sincronización con iCloud esté activada, en tu almacenamiento privado de iCloud. Partie no tiene cuentas, servidores propios ni seguimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes données se trouvent sur ton appareil et, tant que la synchronisation iCloud est activée, dans ton espace iCloud privé. Partie n’a ni compte, ni serveur propre, ni suivi."
          }
        }
      }
    },
