    "Räume alle Spalten ab: Eine vollständige Reihe von König bis Ass in einer Farbe wandert automatisch ab.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear all columns: a complete run from King to Ace in one suit moves away automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despeja todas las columnas: una secuencia completa del Rey al As en un palo se retira automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videz toutes les colonnes : une suite complète du Roi à l’As dans une couleur part automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räume alle Spalten ab: Eine vollständige Reihe von König bis Ass in einer Farbe wandert automatisch ab."
          }
        }
      }
    },
