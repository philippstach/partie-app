    },
    "Eine unterbrochene Partie später fortsetzen. Die Karte oben auf der Startseite führt direkt hinein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue an interrupted game later. The card at the top of the home screen takes you straight back in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar más tarde una partida interrumpida. La tarjeta de la parte superior de la pantalla de inicio te lleva directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre plus tard une partie interrompue. La carte en haut de l’écran d’accueil te ramène directement dedans."
          }
        }
      }
    },
    "Beim Dame-Spiel ein Stein, der die letzte Reihe erreicht hat und danach in beide Richtungen zieht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Draughts, a piece that has reached the last row and then moves in both directions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En las Damas, una ficha que ha llegado a la última fila y después se mueve en ambas direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au jeu de dames, un pion qui a atteint la dernière rangée et se déplace ensuite dans les deux sens."
          }
        }
      }
    },
    "Beim Steinfall: eine volle Zeile verschwindet und bringt Punkte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Steinfall: a full row disappears and earns points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Steinfall: una fila completa desaparece y da puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À Steinfall : une ligne complète disparaît et rapporte des points."
          }
        }
      }
    },
    "Alle Würfel punkten": {
