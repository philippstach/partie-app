    "**Geübt:** Macht kaum noch Fehler, ab und zu aber einen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Geübt:** Macht kaum noch Fehler, ab und zu aber einen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Skilled:** Rarely makes mistakes, but still one now and then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Hábil:** Casi no comete errores, pero de vez en cuando uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Habile :** Fait rarement des erreurs, mais de temps en temps une."
          }
        }
      }
    },
    "**Leicht:** Gewinnt, wenn er kann, und blockt – sonst wirft er irgendwohin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Leicht:** Gewinnt, wenn er kann, und blockt – sonst wirft er irgendwohin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Easy:** Wins when it can and blocks – otherwise it drops anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Fácil:** Gana si puede y bloquea; si no, echa la ficha en cualquier sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Facile :** Gagne s’il le peut et bloque – sinon il joue n’importe où."
          }
        }
      }
    },
    "**Mittel:** Denkt ein paar Züge voraus und sieht einfache Fallen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mittel:** Denkt ein paar Züge voraus und sieht einfache Fallen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Medium:** Thinks a few moves ahead and spots simple traps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Medio:** Piensa unas jugadas por delante y ve trampas sencillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Moyen :** Voit quelques coups à l’avance et repère les pièges simples."
          }
        }
      }
    },
    "**Stark:** Rechnet sehr weit voraus. Gelegenheitsspieler gewinnen kaum.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Stark:** Rechnet sehr weit voraus. Gelegenheitsspieler gewinnen kaum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Hard:** Looks very far ahead. Casual players rarely win."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Difícil:** Calcula muy lejos. Los jugadores ocasionales casi nunca ganan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Difficile :** Calcule très loin. Les joueurs occasionnels gagnent rarement."
          }
        }
      }
    },
