          }
        }
      }
    },
    "Noch keine Partien in diesem Spiel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No games played yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay partidas de este juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune partie de ce jeu pour l’instant."
          }
        }
      }
    },
    "Die App wirft die Bohnen für dich.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app tosses the beans for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app lanza las habas por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app lance les haricots pour toi."
          }
        }
      }
    },
    "Wie viele Münzen zeigen den Punkt?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many coins show the dot?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuántas monedas muestran el punto?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de pièces montrent le point ?"
          }
        }
      }
    },
    "Du wirfst am Tisch und tippst das Ergebnis ein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You toss at the table and type in the result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanzas en la mesa y escribes el resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu lances à table et tu saisis le résultat."
          }
        }
      }
    },
    "nicht markiert": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not marked"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "sin marcar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "non marqué"
          }
        }
      }
    },
    "Bohnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beans"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haricots"
          }
        }
      }
    },
    "Bohne %lld von 5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bean %lld of 5"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haba %lld de 5"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haricot %lld sur 5"
          }
        }
      }
    },
    "Die App wirft die Münzen für dich.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app tosses the coins for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app lanza las monedas por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app lance les pièces pour toi."
          }
        }
      }
    },
    "Wie liegen deine Bohnen? Tippe die markierten an.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How did your beans land? Tap the marked ones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo cayeron tus habas? Toca las marcadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment tes haricots sont-ils tombés ? Touche les marqués."
          }
        }
      }
    },
    "Im Ruhe-Modus und im Kinder-Modus ist die Tagesaufgabe aus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In quiet mode and kids mode the daily task is off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo tranquilo y en el modo infantil la tarea diaria está desactivada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode calme et en mode enfant, le défi du jour est désactivé."
          }
        }
      }
    },
    "Zeigt auf der Startseite jeden Tag ein anderes Spiel zum Spielen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a different game to play on the home screen every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra cada día un juego distinto en la pantalla de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche chaque jour un autre jeu à jouer sur l’écran d’accueil."
          }
        }
      }
    },
    "Steckbrett: %lld Stecker übrig": {
      "localizations": {
