    "Höchste Kachel %lld, %lld Punkte": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highest tile %lld, %lld points"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficha más alta %lld, %lld puntos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus haute tuile %lld, %lld points"
          }
        }
      }
    },
    "Jetzt in Zeile %lld, Spalte %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now in row %lld, column %lld"
          }
        },
        "es": {
