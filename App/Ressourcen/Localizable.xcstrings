    "Halte Reihen möglichst einfarbig und leere früh eine Spalte – sie ist dein wichtigster Spielraum.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep runs in one suit where you can and empty a column early – it is your most valuable room to move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén las secuencias de un solo palo en lo posible y vacía una columna pronto: es tu mejor margen de maniobra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les suites dans une seule couleur autant que possible et videz tôt une colonne : c’est votre meilleure marge de manœuvre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte Reihen möglichst einfarbig und leere früh eine Spalte – sie ist dein wichtigster Spielraum."
          }
        }
      }
    },
