    "Die Partie zählt als verloren. Bei lösbaren Partien kannst du danach die Lösung ansehen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deal counts as lost. For winnable deals you can watch the solution afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La partida cuenta como perdida. En las partidas resolubles puedes ver después la solución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La partie compte comme perdue. Pour les donnes gagnables, vous pouvez ensuite voir la solution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Partie zählt als verloren. Bei lösbaren Partien kannst du danach die Lösung ansehen."
          }
        }
      }
    },
    "Die laufende Partie wird beendet. Statistik und Stufen zählen wie bei jeder lösbaren Partie, das Tagesspiel bleibt unberührt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current game ends. Statistics and levels count as for any solvable deal; the daily deal is not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La partida actual termina. Las estadísticas y los niveles cuentan como en cualquier partida resoluble; la partida diaria no se ve afectada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La partie en cours se termine. Les statistiques et les niveaux comptent comme pour toute donne gagnable ; la donne du jour n’est pas concernée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die laufende Partie wird beendet. Statistik und Stufen zählen wie bei jeder lösbaren Partie, das Tagesspiel bleibt unberührt."
          }
        }
      }
    },
