    "Hälfte 1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half 1"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitad 1"
          }
        },
        "fr": {
