    "In den Einstellungen wählst du, ob falsche Zahlen sofort rot werden, nur Doppelte markiert werden oder gar nichts angezeigt wird.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Einstellungen wählst du, ob falsche Zahlen sofort rot werden, nur Doppelte markiert werden oder gar nichts angezeigt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings you choose whether wrong numbers turn red immediately, only duplicates are marked, or nothing is shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes eliges si los números incorrectos se ponen en rojo al instante, solo se marcan los repetidos o no se muestra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les réglages, tu choisis si les chiffres faux deviennent rouges tout de suite, si seuls les doublons sont marqués ou si rien n’est affiché."
          }
        }
      }
    },
    "In einer Box liegt die %@ nur auf einer Linie. Sie fällt aus dem Rest der Linie.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer Box liegt die %@ nur auf einer Linie. Sie fällt aus dem Rest der Linie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a box, the %@ lies on only one line. It can be removed from the rest of that line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una caja, el %@ solo está en una línea. Se descarta del resto de esa línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans un bloc, le %@ n’apparaît que sur une ligne. Il est éliminé du reste de cette ligne."
          }
        }
      }
    },
    "In einer Linie liegt die %@ nur in einer Box. Sie fällt aus dem Rest der Box.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
