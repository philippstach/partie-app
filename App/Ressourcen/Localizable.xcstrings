      }
    },
    "Aufnahmen teilen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share captures"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir capturas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager les captures"
          }
        }
      }
    },
    "Das Paket konnte nicht erstellt werden. Ist genug Speicher frei?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package couldn’t be created. Is there enough free storage?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear el paquete. ¿Hay suficiente espacio libre?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet n’a pas pu être créé. Y a-t-il assez d’espace libre ?"
          }
        }
      }
    },
    "Aufnahmen löschen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete captures"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar capturas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les captures"
          }
        }
      }
    },
    "Alle gespeicherten Würfelbilder löschen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all saved dice images?"
