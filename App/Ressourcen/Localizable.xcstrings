            "state": "translated",
            "value": "En Mäxchen, la tirada más alta: un 2 y un 1. Gana a todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À Mäxchen, le meilleur lancer : un 2 et un 1. Bat tout."
          }
        }
      }
    },
    "Sprungkette": {
