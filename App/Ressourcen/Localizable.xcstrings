            "value": "¿Qué nivel compartir?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel niveau partager ?"
          }
        }
      }
    },
    "Rätsel per Link teilen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share puzzle by link"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir rompecabezas por enlace"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager le casse-tête par lien"
          }
        }
      }
    },
    "Gleicht Spieler, Fotos und Statistik zwischen deinen Geräten mit derselben Apple-ID ab, im privaten iCloud-Speicher. Es wird nur hinzugefügt: Löschen auf einem Gerät löscht nichts auf dem anderen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleicht Spieler, Fotos und Statistik zwischen deinen Geräten mit derselben Apple-ID ab, im privaten iCloud-Speicher. Es wird nur hinzugefügt: Löschen auf einem Gerät löscht nichts auf dem anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncs players, photos and statistics between your devices with the same Apple ID, in your private iCloud storage. Items are only added: deleting on one device deletes nothing on the other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza jugadores, fotos y estadísticas entre tus dispositivos con el mismo ID de Apple, en tu almacenamiento privado de iCloud. Solo se añade: borrar en un dispositivo no borra nada en el otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronise joueurs, photos et statistiques entre tes appareils avec le même identifiant Apple, dans ton espace iCloud privé. Les données sont seulement ajoutées : supprimer sur un appareil ne supprime rien sur l’autre."
          }
        }
      }
    },
    "Mit iCloud abgleichen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit iCloud abgleichen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync with iCloud"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar con iCloud"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniser avec iCloud"
          }
        }
      }
    },
    "Zuletzt abgeglichen: %@": {
      "localizations": {
