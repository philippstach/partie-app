          }
        }
      }
    },
    "Statistik, Spieler, Favoriten, Spielstände, Einstellungen und das App-Symbol werden gelöscht. Danach startet Partie wie neu installiert; beende die App und öffne sie neu.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik, Spieler, Favoriten, Spielstände, Einstellungen und das App-Symbol werden gelöscht. Danach startet Partie wie neu installiert; beende die App und öffne sie neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistics, players, favourites, saved games, settings and the app icon will be deleted. Partie then starts as if newly installed; quit the app and open it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán las estadísticas, los jugadores, los favoritos, las partidas guardadas, los ajustes y el icono de la app. Después Partie arranca como recién instalada; cierra la app y ábrela de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les statistiques, joueurs, favoris, parties en cours, réglages et l’icône de l’app seront supprimés. Partie redémarre ensuite comme neuve ; quitte l’app et rouvre-la."
          }
        }
      }
    },
