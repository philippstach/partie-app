            "state": "translated",
            "value": "Pista: juega el %lld (palo %lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indice : joue le %lld (couleur %lld)."
          }
        }
      }
    },
    "Sechs Runden, drei Würfel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six rounds, three dice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis rondas, tres dados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six manches, trois dés"
          }
        }
      }
    },
    "Runde %lld von 6 · Ziel: %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Round %lld of 6 · target: %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ronda %lld de 6 · objetivo: %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche %lld sur 6 · cible : %lld"
          }
        }
      }
    },
    "Punkte in dieser Runde · gewonnene Runden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Points this round · rounds won"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntos en esta ronda · rondas ganadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Points de cette manche · manches gagnées"
          }
        }
      }
    },
    "%@ gewinnt die Runde!": {
      "localizations": {
        "en": {
