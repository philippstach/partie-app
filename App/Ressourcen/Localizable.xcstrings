    "Damit machst du Spalte %lld für %@ frei – %@ gewinnt sofort.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit machst du Spalte %lld für %@ frei – %@ gewinnt sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That frees column %lld for %@ – %@ wins at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con eso dejas libre la columna %lld para %@ – %@ gana al instante."
