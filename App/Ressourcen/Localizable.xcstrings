    "Wer in dieser Runde die meisten Punkte macht, gewinnt. Keine Strafe im Stechen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most points this round wins. No penalty in the tiebreaker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana quien haga más puntos en esta ronda. Sin penalización en el desempate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui qui marque le plus de points dans cette manche gagne. Pas de pénalité au départage."
          }
        }
      }
    },
    "Stechen!": {
      "localizations": {
