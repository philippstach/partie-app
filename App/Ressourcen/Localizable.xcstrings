        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe die Spiele an, die du oft spielst. Sie liegen dann auf der Startseite ganz vorn. Du kannst das jederzeit ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the games you play often. They will appear first on the start page. You can change this at any time."
          }
