        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indice : touche la ligne %lld, colonne %lld"
          }
        }
      }
    },
    "Kein Zug in diese Richtung": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No move in that direction"
          }
        },
        "es": {
          "stringUnit": {
