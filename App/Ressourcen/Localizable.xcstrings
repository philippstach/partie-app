    "Wer oben steht, fängt an. Am Griff ≡ ziehen, um die Reihenfolge zu ändern. Mit ⊖ entfernen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever is on top starts. Drag the ≡ handle to change the order. Remove with ⊖."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza quien está arriba. Arrastra el asa ≡ para cambiar el orden. Quita con ⊖."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui qui est en haut commence. Fais glisser la poignée ≡ pour changer l’ordre. Retire avec ⊖."
          }
        }
      }
    },
