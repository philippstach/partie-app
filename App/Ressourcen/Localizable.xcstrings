    "Partien, Spieler, Favoriten, Spielstände und Einstellungen werden unwiderruflich entfernt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Games, players, favourites, saved games and settings will be removed permanently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán de forma permanente las partidas, los jugadores, los favoritos, las partidas guardadas y los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parties, joueurs, favoris, parties en cours et réglages seront supprimés définitivement."
          }
        }
      }
    },
    "Mulde %lld von %@, %lld Samen": {
