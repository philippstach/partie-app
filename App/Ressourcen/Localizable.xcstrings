            "state": "translated",
            "value": "Quitar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer"
          }
        }
      }
    },
    "Partie kann dich an Tagesrätsel und angefangene Partien erinnern. Das ist freiwillig und im Ruhe-Modus aus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie kann dich an Tagesrätsel und angefangene Partien erinnern. Das ist freiwillig und im Ruhe-Modus aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie can remind you of daily puzzles and games in progress. This is optional and off in quiet mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie puede recordarte los puzzles del día y las partidas empezadas. Es opcional y está desactivado en el modo tranquilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie peut te rappeler les énigmes du jour et les parties commencées. C’est facultatif et désactivé en mode calme."
          }
        }
      }
    },
