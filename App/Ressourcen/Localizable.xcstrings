            "value": "Le grand chelem compte"
          }
        }
      }
    },
    "Wer am Ende den einzelnen Pechvogel auf der Hand hat, verliert.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer am Ende den einzelnen Pechvogel auf der Hand hat, verliert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever is left holding the single unlucky bird loses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien se quede con el pájaro suelto pierde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui reste avec l’oiseau de malheur seul perd."
          }
        }
      }
    },
    "Würfel behalten": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Würfel behalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold dice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar dados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder des dés"
          }
        }
      }
    },
    "Drei eigene Steine in einer Linie sind eine Mühle. Dann nimmst du einen Stein des Gegners weg.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei eigene Steine in einer Linie sind eine Mühle. Dann nimmst du einen Stein des Gegners weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three of your pieces in a line make a mill. Then you remove one opponent piece."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres fichas tuyas en línea forman un molino. Entonces quitas una ficha rival."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois de tes pions alignés forment un moulin. Tu retires alors un pion adverse."
          }
        }
      }
    },
    "Hast du gepunktet, würfelst du weiter. Wer zuerst 21 hat, gewinnt die Runde, wer nach sechs Runden die meisten gewonnen hat, das Spiel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du gepunktet, würfelst du weiter. Wer zuerst 21 hat, gewinnt die Runde, wer nach sechs Runden die meisten gewonnen hat, das Spiel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you scored, roll again. First to 21 wins the round; most rounds after six wins the game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si puntúas, tiras otra vez. Quien llega antes a 21 gana la ronda; quien gane más rondas tras seis gana el juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu as marqué, tu relances. Le premier à 21 gagne la manche ; le plus de manches après six gagne la partie."
          }
        }
      }
    },
    "Die Eins": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Eins"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El uno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le un"
          }
        }
      }
    },
    "Jeder hat drei Karten. Wer zwei Stiche gewinnt, gewinnt die Hand. Die stärksten Karten sind Schwerter-Ass, Stäbe-Ass und die beiden Siebener.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder hat drei Karten. Wer zwei Stiche gewinnt, gewinnt die Hand. Die stärksten Karten sind Schwerter-Ass, Stäbe-Ass und die beiden Siebener."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each player has three cards. Win two tricks to win the hand. The strongest cards are the ace of swords, ace of clubs and the two sevens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada uno tiene tres cartas. Quien gana dos bazas gana la mano. Las más fuertes son el as de espadas, el as de bastos y los dos sietes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacun a trois cartes. Gagne la main qui prend deux plis. Les plus fortes : as d’épées, as de bâtons et les deux sept."
          }
        }
      }
    },
    "Sammle vier gleiche Karten. Wer sie hat, legt sofort die Hand auf den Tisch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle vier gleiche Karten. Wer sie hat, legt sofort die Hand auf den Tisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect four of a kind. Whoever has them puts their hand on the table at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reúne cuatro cartas iguales. Quien las tiene pone la mano sobre la mesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rassemble quatre cartes identiques. Qui les a pose aussitôt la main sur la table."
          }
        }
      }
    },
    "Jeder würfelt verdeckt unter einem Becher und sieht nur die eigenen Würfel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder würfelt verdeckt unter einem Becher und sieht nur die eigenen Würfel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone rolls hidden under a cup and sees only their own dice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos tiran ocultos bajo un cubilete y solo ven sus propios dados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacun lance caché sous un gobelet et ne voit que ses propres dés."
          }
        }
      }
    },
    "Mit Truco erhöhst du den Handwert auf 2, der Gegner antwortet mit Retruco (3) oder Vale cuatro (4) oder gibt auf. Wer 15 Punkte hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Truco erhöhst du den Handwert auf 2, der Gegner antwortet mit Retruco (3) oder Vale cuatro (4) oder gibt auf. Wer 15 Punkte hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With truco you raise the hand to 2; the opponent may answer retruco (3), vale cuatro (4) or fold. 15 points win."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con truco subes la mano a 2; el rival puede responder retruco (3), vale cuatro (4) o retirarse. Gana quien llegue a 15 puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec truco tu montes la main à 2 ; l’adversaire peut répondre retruco (3), vale cuatro (4) ou abandonner. 15 points gagnent."
          }
        }
      }
    },
    "Lege eine Karte, die in Farbe oder Zahl zur obersten Karte passt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege eine Karte, die in Farbe oder Zahl zur obersten Karte passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a card that matches the top card in suit or number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega una carta que coincida en palo o número con la de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose une carte de la même couleur ou du même nombre que celle du dessus."
          }
        }
      }
    },
    "Alle reichen gleichzeitig eine Karte an den Nachbarn weiter und bekommen eine vom anderen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle reichen gleichzeitig eine Karte an den Nachbarn weiter und bekommen eine vom anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone passes a card to a neighbour at the same time and receives one from the other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos pasan una carta al vecino a la vez y reciben otra del otro lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde passe une carte au voisin en même temps et en reçoit une de l’autre côté."
          }
        }
      }
    },
    "Kein Unentschieden": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Unentschieden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No draws"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin empates"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de nul"
          }
        }
      }
    },
    "Wer in einer Runde die beste Hand hat, bekommt einen Punkt. Nach fünf Runden gewinnt, wer die meisten hat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer in einer Runde die beste Hand hat, bekommt einen Punkt. Nach fünf Runden gewinnt, wer die meisten hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The best hand in a round scores a point. After five rounds the most points win."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mejor mano de cada ronda gana un punto. Tras cinco rondas gana quien tenga más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La meilleure main de la manche marque un point. Après cinq manches, le plus de points gagne."
          }
        }
      }
    },
    "Du würfelst und ziehst so viele Felder, wie der Würfel zeigt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du würfelst und ziehst so viele Felder, wie der Würfel zeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You roll and move as many squares as the die shows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiras y avanzas tantas casillas como marque el dado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu lances et avances d’autant de cases que le dé."
          }
        }
      }
    },
    "Gegen die Bank": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegen die Bank"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Against the bank"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contra la banca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contre la banque"
          }
        }
      }
    },
    "Reihum ziehst du verdeckt eine Karte aus der Hand deines Nachbarn. Passt sie, kommt das Paar weg.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reihum ziehst du verdeckt eine Karte aus der Hand deines Nachbarn. Passt sie, kommt das Paar weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In turn, draw a card face down from your neighbour’s hand. If it pairs, the pair goes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por turnos robas una carta boca abajo de la mano de tu vecino. Si hace pareja, se retira."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À tour de rôle, tu tires une carte face cachée de la main de ton voisin. Si elle fait une paire, elle part."
          }
        }
      }
    },
    "Ergibt die Summe die Zielzahl, bekommst du so viele Punkte wie die Zielzahl, bei einem Pasch doppelt. Dann endet dein Zug.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergibt die Summe die Zielzahl, bekommst du so viele Punkte wie die Zielzahl, bei einem Pasch doppelt. Dann endet dein Zug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the sum matches the target you score that many points, double for a pair. Then your turn ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la suma coincide con el objetivo, ganas esos puntos, el doble con un par. Luego termina tu turno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la somme égale la cible, tu marques autant de points, le double avec un doublé. Ton tour s’arrête."
          }
        }
      }
    },
    "Fangen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fangen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturer"
          }
        }
      }
    },
    "Vor dem ersten Stich kannst du Envido rufen: zwei Karten gleicher Farbe zählen 20 plus ihre Werte.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem ersten Stich kannst du Envido rufen: zwei Karten gleicher Farbe zählen 20 plus ihre Werte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before the first trick you can call envido: two cards of one suit count 20 plus their values."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de la primera baza puedes cantar envido: dos cartas del mismo palo valen 20 más sus valores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant le premier pli tu peux annoncer envido : deux cartes de la même couleur valent 20 plus leurs valeurs."
          }
        }
      }
    },
    "Alle eingeklemmten Steine wechseln zu deiner Farbe. Kannst du nicht setzen, passt du.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle eingeklemmten Steine wechseln zu deiner Farbe. Kannst du nicht setzen, passt du."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All sandwiched discs turn to your colour. If you cannot place, you pass."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las fichas atrapadas cambian a tu color. Si no puedes colocar, pasas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les pions encadrés prennent ta couleur. Si tu ne peux pas poser, tu passes."
          }
        }
      }
    },
    "Der Joker passt immer und wählt die Farbe. Wer zuerst keine Karten mehr hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Joker passt immer und wählt die Farbe. Wer zuerst keine Karten mehr hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wild card always fits and picks the colour. The first player with no cards wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comodín siempre vale y elige el color. Gana quien se quede sin cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le joker va toujours et choisit la couleur. Le premier sans cartes gagne."
          }
        }
      }
    },
    "Escoba": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Escoba"
          }
        },
        "en": {
