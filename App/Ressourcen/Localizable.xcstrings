    },
    "Du würfelst zwei Würfel verdeckt und siehst nur selbst, was gefallen ist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du würfelst zwei Würfel verdeckt und siehst nur selbst, was gefallen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You roll two dice hidden and only you see the result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiras dos dados ocultos y solo tú ves el resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
