            "value": "No permitido: ningún disco grande sobre uno pequeño"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interdit : pas de grand disque sur un plus petit"
          }
        }
      }
    },
    "Tipp: Zeile %lld, Spalte %lld antippen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hint: tap row %lld, column %lld"
          }
        },
        "es": {
          "stringUnit": {
