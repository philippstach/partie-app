    },
    "Errate das versteckte Wort Buchstabe für Buchstabe. Tippe einen Buchstaben: Kommt er vor, steht er überall im Wort.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Errate das versteckte Wort Buchstabe für Buchstabe. Tippe einen Buchstaben: Kommt er vor, steht er überall im Wort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guess the hidden word letter by letter. Tap a letter: if it occurs, it appears everywhere in the word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adivina la palabra oculta letra a letra. Toca una letra: si aparece, se muestra en todos los sitios de la palabra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devine le mot caché lettre par lettre. Touche une lettre : si elle y est, elle apparaît partout dans le mot."
          }
        }
      }
    },
    "Zahlen am Rand": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlen am Rand"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbers at the edge"
          }
        },
        "es": {
