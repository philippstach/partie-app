    "regel.startMitFigur": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start mit einer Figur draußen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with one piece out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar con una ficha fuera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer avec un pion dehors"
          }
        }
      }
    },
    "regel.startMitFigur.info": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Beginn steht schon eine Figur auf deinem Startfeld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of your pieces starts on your start square."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una de tus fichas empieza en tu casilla de salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un de tes pions démarre sur ta case de départ."
          }
        }
      }
    },
    "regel.startfeldRaeumen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startfeld räumen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the start"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despejar la salida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérer le départ"
          }
        }
      }
    },
    "regel.startfeldRaeumen.info": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange noch Figuren im Haus warten und die Figur auf deinem Startfeld mit der gewürfelten Zahl ziehen kann, muss sie zuerst weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While pieces wait at home and the piece on your start square can move with the number rolled, it must move on first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras haya fichas en casa y la ficha de tu casilla de salida pueda mover con el número sacado, debe avanzar primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que des pions attendent à la maison et que le pion sur ta case de départ peut jouer avec le nombre obtenu, il doit d’abord avancer."
          }
        }
      }
    },
    "regel.teams": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teams (2 gegen 2)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Teams (2 vs 2)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equipos (2 contra 2)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équipes (2 contre 2)"
          }
        }
      }
    },
    "regel.teams.info": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur mit 4 Spielern: Gegenübersitzende bilden ein Team (1+3, 2+4). Den Partner schlägst du nicht. Das Team gewinnt, sobald beide alle Figuren im Ziel haben. Wer fertig ist, setzt aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only with 4 players: players sitting opposite each other form a team (1+3, 2+4). You never capture your partner. The team wins as soon as both have all pieces in the goal. Whoever is finished skips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo con 4 jugadores: los que se sientan enfrente forman un equipo (1+3, 2+4). No capturas a tu compañero. El equipo gana en cuanto ambos tienen todas las fichas en la meta. Quien ha terminado pasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement à 4 joueurs : ceux assis en face forment une équipe (1+3, 2+4). Tu ne captures pas ton partenaire. L’équipe gagne dès que les deux ont tous leurs pions à l’arrivée. Celui qui a fini passe."
          }
        }
      }
    },
    "regel.zielUeberspringen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Ziel überspringen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump in the goal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saltar en la meta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauter dans l’arrivée"
          }
        }
      }
    },
    "regel.zielUeberspringen.info": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Ziel darfst du über deine eigenen Figuren springen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your goal you may jump over your own pieces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu meta puedes saltar por encima de tus propias fichas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans ton arrivée, tu peux sauter par-dessus tes propres pions."
          }
        }
