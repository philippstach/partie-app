    "Der Spielstand geht verloren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game in progress will be lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderá la partida en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La partie en cours sera perdue."
          }
        }
      }
    },
    "Der Stock ist leer. Jetzt gibt der Gewinner seine Deckel ab. Wer keine mehr hat, ist raus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pot is empty. Now the winner hands over lids. No lids left = you’re out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bote está vacío. Ahora el ganador reparte sus tapas. Quien se queda sin tapas, queda fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pot est vide. Maintenant le gagnant donne ses couvercles. Qui n’en a plus est éliminé."
          }
        }
      }
    },
    "Der Vorleger hat %lld Würfe gebraucht – mehr hast du diese Runde nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The leader used %lld rolls – that’s your limit this round."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien abre necesitó %lld tiradas: no tienes más en esta ronda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ouvreur a eu besoin de %lld lancers – tu n’en as pas plus cette manche."
          }
        }
      }
    },
    "Der schlechteste Wurf bekommt Deckel. Wie viele, bestimmt der beste Wurf.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The worst roll takes lids. The best roll decides how many."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La peor tirada se lleva tapas. Cuántas lo decide la mejor tirada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pire lancer prend des couvercles. Leur nombre dépend du meilleur lancer."
          }
        }
      }
    },
    "Die Bilanz von heute wird gelöscht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonight’s tally will be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrará el balance de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bilan du jour sera effacé."
          }
        }
      }
    },
