    "Es wird nichts automatisch gesendet. Du kannst die Mail vor dem Absenden ansehen und ändern.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is sent automatically. You can review and edit the email before sending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se envía nada automáticamente. Puedes revisar y cambiar el correo antes de enviarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est envoyé automatiquement. Tu peux relire et modifier l’e-mail avant de l’envoyer."
          }
        }
      }
    },
