    },
    "Zwei Knöpfe: Weiterwürfeln mit %lld Würfeln oder Aufhören mit 150": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two buttons: keep rolling with %lld dice or stop with 150"
          }
        },
