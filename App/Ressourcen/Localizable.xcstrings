      }
    },
    "Zelle zuerst: erst die Zelle antippen, dann die Ziffer. Ziffer zuerst: erst die Ziffer wählen, dann Zellen antippen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelle zuerst: erst die Zelle antippen, dann die Ziffer. Ziffer zuerst: erst die Ziffer wählen, dann Zellen antippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cell first: tap the cell, then the digit. Digit first: pick the digit, then tap cells."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero la celda: toca la celda y luego el dígito. Primero el dígito: elige el dígito y luego toca celdas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Case d’abord : touche la case, puis le chiffre. Chiffre d’abord : choisis le chiffre, puis touche des cases."
          }
        }
      }
    },
    "Ziffer zuerst": {
      "localizations": {
        "de": {
