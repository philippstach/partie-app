    "Apple Intelligence ist gerade nicht verfügbar. Vorschlag nach Spielart, Spielerzahl, Zeit und Anspruch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence isn’t available right now. Suggestion by type, number of players, time and difficulty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence no está disponible ahora. Sugerencia según tipo, número de jugadores, tiempo y dificultad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence n’est pas disponible pour le moment. Suggestion selon le type, le nombre de joueurs, la durée et la difficulté."
          }
        }
      }
    },
    "Die Behauptung des Vorgängers nicht glauben. Wer recht hat, gewinnt die Runde, wer falsch liegt, verliert sie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not believing the previous player’s claim. Whoever is right wins the round, whoever is wrong loses it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No creer la afirmación del jugador anterior. Quien tiene razón gana la ronda y quien se equivoca la pierde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas croire l’affirmation du joueur précédent. Celui qui a raison gagne la manche, celui qui se trompe la perd."
          }
        }
      }
    },
    "Jede 1 bringt 100, jede 5 bringt 50. Drei Einsen und drei Fünfen bringen je 500, andere Drillinge zählen nicht. Eine Straße bringt 1.000.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every 1 scores 100, every 5 scores 50. Three ones and three fives score 500 each, other triples don’t count. A straight scores 1,000."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 1 vale 100 y cada 5 vale 50. Tres unos y tres cincos valen 500 cada uno; otros tríos no cuentan. Una escalera vale 1.000."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque 1 rapporte 100, chaque 5 rapporte 50. Trois 1 et trois 5 rapportent 500 chacun, les autres brelans ne comptent pas. Une suite rapporte 1 000."
          }
        }
      }
    },
