      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10,000 points, all triples count, penalty 500"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "10.000 puntos, cuentan todos los tríos, penalización 500"
          }
