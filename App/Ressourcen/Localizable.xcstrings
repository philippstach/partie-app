    "Nur drei Einsen (500) und drei Fünfen (500) zählen als Drilling": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only three ones (500) and three fives (500) count as three of a kind"
          }
