    "regel.dreiVersuche.info": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kannst du mit keiner Zahl von 1 bis 5 ziehen, darfst du bis zu dreimal würfeln, um eine 6 zu bekommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If no number from 1 to 5 lets you move, you get up to three rolls to get a 6."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ningún número del 1 al 5 te permite mover, tienes hasta tres lanzamientos para sacar un 6."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aucun nombre de 1 à 5 ne te permet de jouer, tu as jusqu’à trois lancers pour faire un 6."
          }
        }
      }
    },
    "regel.figuren": {
      "localizations": {
