    "Tippe ein Rätsel aus Zeitung oder Buch ab. Die App prüft, ob es genau eine Lösung hat, und du spielst es mit Tipps und Notizen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe ein Rätsel aus Zeitung oder Buch ab. Die App prüft, ob es genau eine Lösung hat, und du spielst es mit Tipps und Notizen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type in a puzzle from a newspaper or book. The app checks that it has exactly one solution, and you play it with hints and notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia un puzzle de un periódico o libro. La app comprueba que tenga exactamente una solución y lo juegas con pistas y notas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis une grille d’un journal ou d’un livre. L’appli vérifie qu’elle a exactement une solution, et tu la joues avec indices et notes."
          }
        }
      }
    },
