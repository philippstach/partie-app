    "Strafmarken beim Schocken. Wer am Ende alle Deckel hat, verliert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Penalty tokens in Schocken. Whoever ends up with all the lids loses."
