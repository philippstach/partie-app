    "Ein vollständiges Spiel vom Start bis zum Ende. Partie zählt jede beendete Runde in der Statistik.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A complete game from start to finish. Partie counts every finished round in the statistics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una partida completa de principio a fin. Partie cuenta cada ronda terminada en las estadísticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie complète du début à la fin. Partie compte chaque manche terminée dans les statistiques."
          }
        }
      }
    },
    "Drei eigene Steine in einer Reihe. Wer eine Mühle schließt, nimmt einen gegnerischen Stein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three of your own pieces in a row. Whoever closes a mill takes an opponent’s piece."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres fichas propias en línea. Quien cierra un molino quita una ficha del rival."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois pions à soi alignés. Celui qui ferme un moulin prend un pion adverse."
          }
        }
      }
    },
