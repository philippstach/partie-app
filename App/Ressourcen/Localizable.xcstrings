    },
    "Die Zahlen %@ passen nur in dieselben Zellen. Dort fallen alle anderen Zahlen raus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlen %@ passen nur in dieselben Zellen. Dort fallen alle anderen Zahlen raus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The numbers %@ fit only in the same cells. All other numbers can be removed from those cells."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números %@ solo caben en las mismas celdas. Allí se descartan todos los demás números."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chiffres %@ ne vont que dans les mêmes cases. Tous les autres chiffres y sont éliminés."
          }
        }
      }
    },
    "Die fest gedruckten Zahlen sind vorgegeben und lassen sich nicht ändern. Jedes Rätsel hat genau eine Lösung – du musst nie raten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die fest gedruckten Zahlen sind vorgegeben und lassen sich nicht ändern. Jedes Rätsel hat genau eine Lösung – du musst nie raten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The printed numbers are givens and cannot be changed. Every puzzle has exactly one solution – you never have to guess."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números impresos son datos fijos y no se pueden cambiar. Cada puzzle tiene exactamente una solución: nunca tienes que adivinar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chiffres imprimés sont donnés et ne peuvent pas être modifiés. Chaque grille a exactement une solution – tu n’as jamais à deviner."
          }
        }
      }
    },
    "Diese Woche: %lld von 7 Tagesrätseln gelöst": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Woche: %lld von 7 Tagesrätseln gelöst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week: %lld of 7 daily puzzles solved"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana: %lld de 7 puzzles diarios resueltos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette semaine : %lld grilles du jour sur 7 résolues"
          }
        }
      }
    },
    "Diese Zahl stimmt nicht. Probier eine andere oder lösche sie.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zahl stimmt nicht. Probier eine andere oder lösche sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This number is wrong. Try another one or erase it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este número no es correcto. Prueba otro o bórralo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce chiffre est faux. Essaie-en un autre ou efface-le."
          }
        }
      }
    },
    "Dieses Rätsel von vorn beginnen?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
