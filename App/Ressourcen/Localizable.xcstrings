    "Mehrere Spiele nacheinander, eine Gesamtwertung. Platz 1 bekommt so viele Punkte wie Mitspieler, der Letzte einen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Spiele nacheinander, eine Gesamtwertung. Platz 1 bekommt so viele Punkte wie Mitspieler, der Letzte einen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several games in a row, one overall ranking. First place gets as many points as there are players, last place gets one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varios juegos seguidos, una clasificación general. El primer puesto recibe tantos puntos como jugadores; el último, uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs jeux d’affilée, un classement général. La 1re place rapporte autant de points que de joueurs, la dernière un seul."
          }
        }
      }
    },
