    "Fülle alle Felder der Wertungstabelle mit möglichst vielen Punkten. Wer am Ende die meisten hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fülle alle Felder der Wertungstabelle mit möglichst vielen Punkten. Wer am Ende die meisten hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill every box of the score sheet with as many points as you can. Whoever has the most at the end wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena todas las casillas de la tabla con tantos puntos como puedas. Gana quien tenga más al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplis toutes les cases de la feuille avec le plus de points possible. Celui qui en a le plus à la fin gagne."
          }
        }
      }
    },
