    "Treffer! Der Computer schießt …": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Treffer! Der Computer schießt …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hit! The computer fires …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Acierto! El ordenador dispara …"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touché ! L’ordinateur tire …"
          }
        }
      }
    },
    "Wer am Ende die meisten Steine hat, gewinnt. Ecken kann niemand zurückdrehen. Mit „Verkehrt“ im Mehr-Menü gewinnt, wer die wenigsten hat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer am Ende die meisten Steine hat, gewinnt. Ecken kann niemand zurückdrehen. Mit „Verkehrt“ im Mehr-Menü gewinnt, wer die wenigsten hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most discs at the end wins. Nobody can flip a corner. With “Reverse” in the More menu, fewest discs wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana quien tenga más fichas al final. Las esquinas no se pueden voltear. Con «Inverso» en el menú Más gana quien tenga menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus de pions à la fin gagne. Un coin ne peut pas être retourné. Avec « Inversé » dans le menu Plus, le moins de pions gagne."
          }
        }
      }
    },
    "Farbe oder Zahl": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbe oder Zahl"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colour or number"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Color o número"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleur ou nombre"
          }
        }
      }
    },
    "Du ziehst vom Stapel oder nimmst die oberste Ablagekarte und legst dann eine Karte ab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ziehst vom Stapel oder nimmst die oberste Ablagekarte und legst dann eine Karte ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You draw from the deck or take the top discard, then discard one card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Robas del mazo o tomas el descarte de arriba y luego descartas una carta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu piches ou prends la carte du dessus de la défausse, puis tu défausses une carte."
          }
        }
      }
    },
    "Passt nichts, ziehst du bis zu drei Karten. Wer zuerst keine Karten mehr hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt nichts, ziehst du bis zu drei Karten. Wer zuerst keine Karten mehr hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If nothing fits, draw up to three cards. The first player with no cards wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si nada encaja, robas hasta tres cartas. Gana quien se quede sin cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rien ne va, tu piches jusqu’à trois cartes. Le premier sans cartes gagne."
          }
        }
      }
    },
    "Leiter und Rutsche": {
      "localizations": {
        "de": {
