        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para 1 a 6 jugadores (iPad: 8): con los dados de la app, con dados reales en la mesa o contra el ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour 1 à 6 joueurs (iPad : 8) – avec les dés de l’app, avec de vrais dés à table ou contre l’ordinateur."
