        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un símbolo para cada tipo de juego y patrones para los colores de los jugadores, para personas con daltonismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
