    "Face ID schützt den Kinder-Modus, damit Kinder ihn nicht selbst ausschalten.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID schützt den Kinder-Modus, damit Kinder ihn nicht selbst ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID protects Kids mode so children can’t switch it off themselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID protege el modo infantil para que los niños no puedan desactivarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID protège le mode enfants afin que les enfants ne puissent pas le désactiver."
          }
        }
      }
    },
    "Die Auswahl ändern geht nur mit Face ID oder dem Gerätecode.": {
      "extractionState": "manual",
      "localizations": {
