          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturer"
          }
        }
      }
    },
    "Wer zuerst alle Steine gelegt hat, gewinnt die Runde.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer zuerst alle Steine gelegt hat, gewinnt die Runde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first to play all tiles wins the round."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana la ronda quien coloque antes todas sus fichas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier à poser tous ses dominos gagne la manche."
          }
        }
      }
    },
    "Paar gefunden": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Paar gefunden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair found"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pareja encontrada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paire trouvée"
          }
        }
      }
    },
    "Liegen zwei gleiche Bilder übereinander, drückt jeder so schnell wie möglich auf „Schnapp!“.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liegen zwei gleiche Bilder übereinander, drückt jeder so schnell wie möglich auf „Schnapp!“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When two identical pictures lie on top of each other, everyone taps “Snap!” as fast as possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando hay dos imágenes iguales una sobre otra, todos pulsan «¡Zas!» lo más rápido posible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand deux images identiques se suivent, tout le monde appuie sur « Attrape ! » le plus vite possible."
          }
        }
      }
    },
    "Die Bank zieht bis mindestens 17. Wer mehr hat, gewinnt den Einsatz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank zieht bis mindestens 17. Wer mehr hat, gewinnt den Einsatz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank draws to at least 17. Whoever has more wins the stake."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca pide hasta al menos 17. Gana la apuesta quien tenga más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque tire jusqu’à 17 au moins. Qui a plus gagne la mise."
          }
        }
      }
    },
    "Wirf zum Schluss eine Karte ab. Wer zuerst keine Karten mehr hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirf zum Schluss eine Karte ab. Wer zuerst keine Karten mehr hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish by discarding a card. The first player with no cards wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina descartando una carta. Gana quien se quede sin cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine en défaussant une carte. Le premier sans cartes gagne."
          }
        }
      }
    },
    "Lege eine Handkarte auf einen Mittelstapel, wenn sie genau einen Wert höher oder niedriger ist. Das Ass liegt zwischen König und Zwei.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege eine Handkarte auf einen Mittelstapel, wenn sie genau einen Wert höher oder niedriger ist. Das Ass liegt zwischen König und Zwei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a hand card on a middle pile if it is exactly one higher or lower. The ace sits between king and two."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega una carta sobre un montón central si es exactamente un valor mayor o menor. El as va entre el rey y el dos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose une carte sur une pile centrale si elle est juste au-dessus ou en dessous. L’as est entre le roi et le deux."
          }
        }
      }
    },
    "Tippe ein Feld der gegnerischen Flotte an. Bei einem Treffer darfst du noch einmal, bei Wasser ist der andere dran.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe ein Feld der gegnerischen Flotte an. Bei einem Treffer darfst du noch einmal, bei Wasser ist der andere dran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a square of the enemy fleet. On a hit you go again; on water it is the other’s turn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una casilla de la flota enemiga. Si aciertas, repites; si es agua, juega el otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche une case de la flotte adverse. Touché, tu rejoues ; à l’eau, c’est à l’autre."
          }
        }
      }
    },
    "Jeder hat fünf Schiffe, die sich nicht berühren. Du siehst nur deine eigenen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder hat fünf Schiffe, die sich nicht berühren. Du siehst nur deine eigenen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each side has five ships that do not touch. You only see your own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada uno tiene cinco barcos que no se tocan. Solo ves los tuyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacun a cinq navires qui ne se touchent pas. Tu ne vois que les tiens."
          }
        }
      }
    },
    "Ohne Schlagzwang": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Schlagzwang"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No forced capture"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin captura obligatoria"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans prise obligatoire"
          }
        }
      }
    },
    "Paare ablegen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Paare ablegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay down pairs"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soltar parejas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poser les paires"
          }
        }
      }
    },
    "Vier Münzen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier Münzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four coins"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro monedas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre pièces"
          }
        }
      }
    },
    "Dein Stein läuft einmal um den Ring. Landest du auf einem gegnerischen Stein, muss er zurück ins Haus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Stein läuft einmal um den Ring. Landest du auf einem gegnerischen Stein, muss er zurück ins Haus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your piece runs once around the ring. If you land on an opponent’s piece, it goes back home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ficha da una vuelta al anillo. Si caes sobre una rival, vuelve a casa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton pion fait un tour de l’anneau. Si tu tombes sur un pion adverse, il retourne à la maison."
          }
        }
      }
    },
    "Elf Runden mit den Zielzahlen 2 bis 12. Du wirfst zwei Würfel, bis zu dreimal pro Runde.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Elf Runden mit den Zielzahlen 2 bis 12. Du wirfst zwei Würfel, bis zu dreimal pro Runde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleven rounds with target numbers 2 to 12. You throw two dice, up to three times a round."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Once rondas con números objetivo del 2 al 12. Tiras dos dados, hasta tres veces por ronda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onze manches avec les cibles 2 à 12. Tu lances deux dés, trois fois au plus par manche."
          }
        }
      }
    },
    "Fünf Runden": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Runden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five rounds"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco rondas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq manches"
          }
        }
      }
    },
    "Kurz (3 Samen, Ziel 19)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz (3 Samen, Ziel 19)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short (3 seeds, goal 19)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corto (3 semillas, meta 19)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Court (3 graines, but 19)"
          }
        }
      }
    },
    "Ass setzt aus": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ass setzt aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ace skips"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El as salta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’as fait passer"
          }
        }
      }
    },
    "Die Herz-Elf (Bube) liegt zuerst. Jede Farbe beginnt mit ihrer Elf.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Herz-Elf (Bube) liegt zuerst. Jede Farbe beginnt mit ihrer Elf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The jack of hearts lies first. Every suit starts with its jack."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sota de corazones va primero. Cada palo empieza con su sota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le valet de cœur ouvre. Chaque couleur commence par son valet."
          }
        }
      }
    },
    "Du ziehst einen Stein ein Feld in beliebiger Richtung.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ziehst einen Stein ein Feld in beliebiger Richtung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move a piece one square in any direction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve una ficha una casilla en cualquier dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace un pion d’une case dans n’importe quelle direction."
          }
        }
      }
    },
    "Ziehe eine Karte vom Stapel oder nimm die oberste Ablagekarte.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe eine Karte vom Stapel oder nimm die oberste Ablagekarte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a card from the deck or take the top discard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Roba una carta del mazo o toma el descarte de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pioche une carte ou prends celle du dessus de la défausse."
          }
        }
      }
    },
    "Danach zieht ihr auf freie Nachbarpunkte. Mit nur noch drei Steinen darfst du springen. Die Regelart wählst du im Mehr-Menü.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach zieht ihr auf freie Nachbarpunkte. Mit nur noch drei Steinen darfst du springen. Die Regelart wählst du im Mehr-Menü."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then you move to free neighbouring points. With only three pieces left you may jump. Choose the rule set in the More menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después movéis a puntos vecinos libres. Con solo tres fichas puedes saltar. La variante se elige en el menú Más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite vous avancez sur un point voisin libre. Avec seulement trois pions, tu peux sauter. Choisis la variante dans le menu Plus."
          }
        }
      }
    },
    "Ein Feld ziehen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Feld ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step one square"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover una casilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancer d’une case"
          }
        }
      }
    },
    "Nicht die dritte Seite": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht die dritte Seite"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not the third side"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No el tercer lado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas le troisième côté"
          }
        }
      }
    },
    "Rosetten": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosettes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosaces"
          }
        }
      }
    },
    "Gleichzeitig": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichzeitig"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the same time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En même temps"
          }
        }
      }
    },
    "Fegst du den Tisch leer, bekommst du eine Escoba und einen Punkt. Geht das Einsammeln, musst du es tun.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fegst du den Tisch leer, bekommst du eine Escoba und einen Punkt. Geht das Einsammeln, musst du es tun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the table and you score an escoba, worth a point. If you can collect, you must."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si dejas la mesa vacía, haces escoba y ganas un punto. Si puedes recoger, debes hacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu vides la table, tu fais une escoba et marques un point. Si tu peux ramasser, tu dois le faire."
          }
        }
      }
    },
    "Wer zuerst seinen Vorrat von 15 Karten leer hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer zuerst seinen Vorrat von 15 Karten leer hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first player to empty their stock of 15 cards wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana quien vacíe primero su reserva de 15 cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier à vider sa réserve de 15 cartes gagne."
          }
        }
      }
    },
    "Ein Fuchs spielt gegen 13 Gänse. Die Gänse beginnen und ziehen ein Feld nach vorn oder zur Seite.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fuchs spielt gegen 13 Gänse. Die Gänse beginnen und ziehen ein Feld nach vorn oder zur Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One fox plays against 13 geese. The geese start and move one square forward or sideways."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un zorro juega contra 13 ocas. Las ocas empiezan y avanzan una casilla hacia delante o de lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un renard joue contre 13 oies. Les oies commencent et avancent d’une case devant ou de côté."
          }
        }
      }
    },
    "Du wirfst fünf Bohnen. So viele markierte Seiten oben liegen, so viele Felder ziehst du.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirfst fünf Bohnen. So viele markierte Seiten oben liegen, so viele Felder ziehst du."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You throw five beans. As many marked sides as show up, that many squares you move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanzas cinco frijoles. Avanzas tantas casillas como lados marcados salgan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu lances cinq haricots. Tu avances d’autant de cases que de faces marquées."
          }
        }
      }
    },
    "Bube nicht als letzte Karte": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bube nicht als letzte Karte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No jack as last card"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin jota como última carta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de valet en dernière carte"
          }
        }
      }
    },
    "Du brauchst der Reihe nach eine 6, dann eine 5, dann eine 4. Sie werden automatisch festgelegt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brauchst der Reihe nach eine 6, dann eine 5, dann eine 4. Sie werden automatisch festgelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need a 6, then a 5, then a 4, in that order. They lock in automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitas un 6, luego un 5 y luego un 4, por ese orden. Se fijan solos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il te faut un 6, puis un 5, puis un 4, dans cet ordre. Ils se verrouillent automatiquement."
          }
        }
      }
    },
    "Linie ziehen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linie ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a line"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trazar una línea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracer un trait"
          }
        }
      }
    },
    "Verdeckt legen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdeckt legen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play face down"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jugar boca abajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poser face cachée"
          }
        }
      }
    },
    "Setzen oder ziehen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzen oder ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter or move"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrar o mover"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrer ou avancer"
          }
        }
      }
    },
    "Zwei gegnerische Steine sperren einen Punkt, ein einzelner wird geschlagen und muss über die Bar neu einsteigen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei gegnerische Steine sperren einen Punkt, ein einzelner wird geschlagen und muss über die Bar neu einsteigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two opposing pieces block a point; a single one is hit and must re-enter from the bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos fichas rivales bloquean un punto; una sola es golpeada y debe reentrar desde la barra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux pions adverses bloquent un point ; un seul est frappé et doit rentrer par la barre."
          }
        }
      }
    },
    "Oder springe über einen angrenzenden Stein auf das freie Feld dahinter, auch mehrfach in einer Kette.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder springe über einen angrenzenden Stein auf das freie Feld dahinter, auch mehrfach in einer Kette."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or jump over an adjacent piece to the free square behind it, even several times in a chain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O salta sobre una ficha contigua a la casilla libre de detrás, incluso varias veces seguidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou saute par-dessus un pion voisin sur la case libre derrière, même plusieurs fois à la suite."
          }
        }
      }
    },
    "Auf Startfeldern und Rautenfeldern kann niemand geschlagen werden. Wer zuerst alle vier Steine ins Ziel bringt, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Startfeldern und Rautenfeldern kann niemand geschlagen werden. Wer zuerst alle vier Steine ins Ziel bringt, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody can be captured on start and diamond squares. The first to bring all four pieces home wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En las casillas de salida y de rombo nadie puede ser capturado. Gana quien lleve primero sus cuatro fichas a la meta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur les cases de départ et les losanges, personne ne peut être pris. Le premier à amener ses quatre pions au but gagne."
          }
        }
      }
    },
    "Ziehen und springen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen und springen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving and jumping"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover y saltar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer et sauter"
          }
        }
      }
    },
    "Karten weiterreichen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten weiterreichen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass cards"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar cartas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer des cartes"
          }
        }
      }
    },
    "Achter sind Joker": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achter sind Joker"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eights are wild"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ochos son comodines"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les huit sont jokers"
          }
        }
      }
    },
    "Standard (4 Samen, Ziel 25)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard (4 Samen, Ziel 25)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard (4 seeds, goal 25)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estándar (4 semillas, meta 25)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard (4 graines, but 25)"
          }
        }
      }
    },
    "Beide spielen gleichzeitig, es gibt keine Reihenfolge.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide spielen gleichzeitig, es gibt keine Reihenfolge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both play at the same time; there is no turn order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos juegan a la vez; no hay orden de turnos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux jouent en même temps, sans ordre de tour."
          }
        }
      }
    },
    "Landet dein letzter Samen in einer gegnerischen Mulde mit dann zwei oder drei Samen, gehören sie dir, ebenso davor liegende Mulden mit zwei oder drei.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Landet dein letzter Samen in einer gegnerischen Mulde mit dann zwei oder drei Samen, gehören sie dir, ebenso davor liegende Mulden mit zwei oder drei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your last seed makes an opposing pit hold two or three, you capture it and any preceding pits holding two or three."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu última semilla deja un hoyo rival con dos o tres, te lo quedas, y también los anteriores con dos o tres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ta dernière graine porte un trou adverse à deux ou trois, tu le prends, ainsi que les précédents à deux ou trois."
          }
        }
      }
    },
    "Schlicht (ohne 7 und 8)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlicht (ohne 7 und 8)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain (no 7 or 8 effects)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple (sin efectos de 7 y 8)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple (sans effets du 7 et du 8)"
          }
        }
      }
    },
    "Würfel wählen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Würfel wählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick dice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir dados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir des dés"
          }
        }
      }
    },
    "Ziehen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Robar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piocher"
          }
        }
      }
    },
    "Wer zuerst eine durchgehende Kette hat, gewinnt. Unentschieden gibt es nicht.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer zuerst eine durchgehende Kette hat, gewinnt. Unentschieden gibt es nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first to complete an unbroken chain wins. There are no draws."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana quien complete primero una cadena continua. No hay empates."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier à réaliser une chaîne continue gagne. Il n’y a pas de nul."
          }
        }
      }
    },
    "Du würfelst zwei Würfel und ziehst Steine um die Augenzahlen, bei einem Pasch viermal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du würfelst zwei Würfel und ziehst Steine um die Augenzahlen, bei einem Pasch viermal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll two dice and move pieces by the pips, four times on doubles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira dos dados y mueve fichas según los puntos, cuatro veces con dobles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance deux dés et avance tes pions du nombre de points, quatre fois sur un double."
          }
        }
      }
    },
    "Deutsch (fliegende Dame)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deutsch (fliegende Dame)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "German (flying kings)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alemana (dama voladora)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allemande (dame volante)"
          }
        }
      }
    },
    "Es gibt sechs Runden. In Runde 1 zählt die Eins, in Runde 2 die Zwei und so weiter. Du würfelst drei Würfel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt sechs Runden. In Runde 1 zählt die Eins, in Runde 2 die Zwei und so weiter. Du würfelst drei Würfel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are six rounds. In round 1 ones count, in round 2 twos and so on. You roll three dice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay seis rondas. En la ronda 1 cuentan los unos, en la 2 los doses y así. Tiras tres dados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a six manches. À la manche 1 les un comptent, à la 2 les deux, etc. Tu lances trois dés."
          }
        }
      }
    },
    "Trumpf und Augen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trumpf und Augen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trumps and points"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Triunfo y puntos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atout et points"
          }
        }
      }
    },
    "Beste Punkte": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beste Punkte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best score"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejor puntuación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meilleur score"
          }
        }
      }
    },
    "Der Nächste glaubt dir oder zweifelt an. Wer sich irrt, verliert ein Leben. Wer nach drei Leben übrig bleibt, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Nächste glaubt dir oder zweifelt an. Wer sich irrt, verliert ein Leben. Wer nach drei Leben übrig bleibt, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next player believes you or doubts. Whoever is wrong loses a life. The last player standing wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El siguiente te cree o duda. Quien se equivoca pierde una vida. Gana quien quede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivant te croit ou doute. Celui qui se trompe perd une vie. Le dernier en jeu gagne."
          }
        }
      }
    },
    "Fuchs gegen Gänse": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuchs gegen Gänse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fox and geese"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El zorro y las ocas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renard et oies"
          }
        }
      }
    },
    "Zweifle das Gebot an: Wer sich irrt, verliert einen Würfel. Wer als Letzter Würfel hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweifle das Gebot an: Wer sich irrt, verliert einen Würfel. Wer als Letzter Würfel hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Challenge the bid: whoever is wrong loses a die. The last player with dice wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duda de la apuesta: quien se equivoca pierde un dado. Gana quien conserve dados el último."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteste l’enchère : celui qui se trompe perd un dé. Le dernier avec des dés gagne."
          }
        }
      }
    },
    "Lege Sätze (gleicher Wert) und Folgen (aufsteigend, eine Farbe) aus. Joker ersetzen jede Karte. Die erste Auslage braucht 40 Augen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Sätze (gleicher Wert) und Folgen (aufsteigend, eine Farbe) aus. Joker ersetzen jede Karte. Die erste Auslage braucht 40 Augen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay down sets (same value) and runs (ascending, one suit). Jokers replace any card. Your first meld needs 40 points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja grupos (mismo valor) y escaleras (ascendentes, un palo). Los comodines sustituyen cualquier carta. La primera bajada necesita 40 puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose des brelans (même valeur) et des suites (croissantes, une couleur). Les jokers remplacent toute carte. Le premier étalement demande 40 points."
          }
        }
      }
    },
    "Noch einmal dran": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch einmal dran"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another turn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Turno extra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejouer"
          }
        }
      }
    },
    "Jeder Würfel mit der Rundenzahl gibt 1 Punkt. Drei davon sind ein Bunco mit 21 Punkten, drei andere Gleiche ein Mini-Bunco mit 5.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Würfel mit der Rundenzahl gibt 1 Punkt. Drei davon sind ein Bunco mit 21 Punkten, drei andere Gleiche ein Mini-Bunco mit 5."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each die showing the round number scores 1. Three of them are a Bunco worth 21; three of any other kind a mini Bunco worth 5."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dado con el número de la ronda da 1 punto. Tres son un Bunco de 21; tres iguales de otro número, un mini Bunco de 5."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque dé du numéro de la manche vaut 1 point. Trois font un Bunco à 21 ; trois autres identiques, un mini-Bunco à 5."
          }
        }
      }
    },
