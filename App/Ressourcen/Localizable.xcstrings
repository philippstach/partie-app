          }
        }
      }
    },
    "Deckel verteilen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckel verteilen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand out chips"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repartir fichas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuer les jetons"
          }
        }
      }
    },
    "Jedes Brett lässt sich durch Nachdenken lösen, und der erste Zug ist immer sicher.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Brett lässt sich durch Nachdenken lösen, und der erste Zug ist immer sicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every board can be solved by thinking, and the first move is always safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada tablero se puede resolver pensando, y la primera jugada es siempre segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque grille se résout par la réflexion, et le premier coup est toujours sûr."
          }
        }
      }
    },
    "Ein Tipp, fünf Felder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp, fünf Felder"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One tap, five squares"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque, cinco casillas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toucher, cinq cases"
          }
        }
      }
    },
    "Füllen und markieren": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllen und markieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill and mark"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellenar y marcar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplir et marquer"
          }
        }
      }
    },
    "Eine größere Scheibe darf nie auf einer kleineren liegen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine größere Scheibe darf nie auf einer kleineren liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A larger disc may never lie on a smaller one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un disco mayor nunca puede estar sobre uno menor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grand disque ne doit jamais reposer sur un plus petit."
          }
        }
      }
    },
    "Entferne alle Steine, indem du zwei gleiche freie Steine antippst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne alle Steine, indem du zwei gleiche freie Steine antippst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove all tiles by tapping two matching free tiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita todas las fichas tocando dos fichas libres iguales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire toutes les tuiles en touchant deux tuiles libres identiques."
          }
        }
      }
    },
    "Die Kacheln bilden einen sanften Farbverlauf zwischen den vier Ecken. Jemand hat sie durcheinandergebracht – stelle den Verlauf wieder her.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kacheln bilden einen sanften Farbverlauf zwischen den vier Ecken. Jemand hat sie durcheinandergebracht – stelle den Verlauf wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tiles form a smooth gradient between the four corners. Someone mixed them up – restore the gradient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fichas forman un degradado suave entre las cuatro esquinas. Alguien las ha desordenado: restaura el degradado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tuiles forment un dégradé doux entre les quatre coins. Quelqu’un les a mélangées – rétablis le dégradé."
          }
        }
      }
    },
    "Stein einwerfen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stein einwerfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop a disc"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Echar una ficha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lâcher un jeton"
          }
        }
      }
    },
    "Sammle die Perlen auf dem Weg, jede bringt zehn Punkte extra. Stößt du an oder fällst du in ein Loch, ist der Lauf vorbei.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle die Perlen auf dem Weg, jede bringt zehn Punkte extra. Stößt du an oder fällst du in ein Loch, ist der Lauf vorbei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect the pearls on the way, each is worth ten extra points. If you hit something or fall into a gap, the run is over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recoge las perlas del camino, cada una da diez puntos extra. Si chocas o caes en un hueco, la carrera termina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramasse les perles sur le chemin, chacune rapporte dix points de plus. Si tu heurtes un obstacle ou tombes dans un trou, la course est finie."
          }
        }
      }
    },
    "Ein dunkler Punkt heißt: richtige Farbe an der richtigen Stelle. Ein heller Punkt: richtige Farbe, aber an der falschen Stelle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein dunkler Punkt heißt: richtige Farbe an der richtigen Stelle. Ein heller Punkt: richtige Farbe, aber an der falschen Stelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dark dot means: right colour in the right place. A light dot: right colour, wrong place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto oscuro significa: color correcto en el sitio correcto. Un punto claro: color correcto, pero en el sitio equivocado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un point foncé signifie : bonne couleur au bon endroit. Un point clair : bonne couleur, mais au mauvais endroit."
          }
        }
      }
    },
    "Kisten kannst du nicht ziehen und nur einzeln schieben. Steckt eine Kiste fest, hilft der Neustart.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kisten kannst du nicht ziehen und nur einzeln schieben. Steckt eine Kiste fest, hilft der Neustart."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot pull crates and can only push one at a time. If a crate gets stuck, restart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes tirar de las cajas y solo puedes empujar de una en una. Si una caja se atasca, reinicia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ne peux pas tirer les caisses et seulement en pousser une à la fois. Si une caisse est coincée, recommence."
          }
        }
      }
    },
    "Der Computer denkt sich einen Code aus Farbpunkten aus. Lege mit den Farben unten einen Tipp und tippe auf „Prüfen“.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Computer denkt sich einen Code aus Farbpunkten aus. Lege mit den Farben unten einen Tipp und tippe auf „Prüfen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer thinks up a code of coloured dots. Place a guess with the colours below and tap “Check”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ordenador inventa un código de puntos de colores. Coloca una propuesta con los colores de abajo y toca «Comprobar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinateur invente un code de points de couleur. Place une proposition avec les couleurs du bas et touche « Vérifier »."
          }
        }
      }
    },
    "Tippe ein Feld an, dann die Ziffer. Die fest gedruckten Zahlen bleiben, und jedes Rätsel hat genau eine Lösung.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe ein Feld an, dann die Ziffer. Die fest gedruckten Zahlen bleiben, und jedes Rätsel hat genau eine Lösung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a cell, then the digit. The printed numbers stay, and every puzzle has exactly one solution."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una casilla y luego la cifra. Los números impresos no cambian y cada puzle tiene una única solución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche une case, puis le chiffre. Les chiffres imprimés restent, et chaque grille a exactement une solution."
          }
        }
      }
    },
    "Würfeln und rauslegen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Würfeln und rauslegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll and set aside"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirar y apartar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer et mettre de côté"
          }
        }
      }
    },
    "Mit n Scheiben schaffst du es in mindestens 2ⁿ − 1 Zügen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit n Scheiben schaffst du es in mindestens 2ⁿ − 1 Zügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With n discs you need at least 2ⁿ − 1 moves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con n discos lo logras como mínimo en 2ⁿ − 1 movimientos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec n disques, il faut au moins 2ⁿ − 1 coups."
          }
        }
      }
    },
    "Würfle mit den übrigen Würfeln weiter oder schreibe die Punkte gut. Bringt ein Wurf keinen Punkt, sind alle Punkte dieses Zugs weg.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Würfle mit den übrigen Würfeln weiter oder schreibe die Punkte gut. Bringt ein Wurf keinen Punkt, sind alle Punkte dieses Zugs weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep rolling with the remaining dice or bank your points. If a roll scores nothing, all points of this turn are lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue tirando con los dados restantes o anota los puntos. Si una tirada no puntúa, se pierden todos los puntos de este turno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue avec les dés restants ou note tes points. Si un lancer ne rapporte rien, tous les points du tour sont perdus."
          }
        }
      }
    },
    "Wer alle Deckel hat, verliert": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer alle Deckel hat, verliert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever has all the chips loses"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien tenga todas las fichas pierde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui qui a tous les jetons perd"
          }
        }
      }
    },
    "Mit der Glühbirne deckst du einen Buchstaben auf, ohne einen Ballon zu verlieren – zweimal pro Wort. Mit „Lösen“ tippst du das ganze Wort ein.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Glühbirne deckst du einen Buchstaben auf, ohne einen Ballon zu verlieren – zweimal pro Wort. Mit „Lösen“ tippst du das ganze Wort ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The light bulb reveals a letter without losing a balloon – twice per word. With “Solve” you type the whole word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la bombilla descubres una letra sin perder un globo, dos veces por palabra. Con «Resolver» escribes la palabra entera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ampoule révèle une lettre sans perdre de ballon – deux fois par mot. Avec « Résoudre », tu saisis le mot entier."
          }
        }
      }
    },
    "Wische nach unten, um dich zu ducken, wenn ein Balken in der Luft hängt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische nach unten, um dich zu ducken, wenn ein Balken in der Luft hängt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe down to duck when a bar hangs in the air."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia abajo para agacharte cuando hay una barra en el aire."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse vers le bas pour te baisser quand une barre est suspendue en l’air."
          }
        }
      }
    },
    "Die Flut beginnt oben links. Tippe unten eine Farbe an: Die ganze Flut nimmt sie an und schluckt angrenzende Felder in dieser Farbe.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Flut beginnt oben links. Tippe unten eine Farbe an: Die ganze Flut nimmt sie an und schluckt angrenzende Felder in dieser Farbe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The flood starts at the top left. Tap a colour below: the whole flood takes it and swallows adjacent squares of that colour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La inundación empieza arriba a la izquierda. Toca un color abajo: toda la inundación lo adopta y absorbe las casillas contiguas de ese color."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’inondation commence en haut à gauche. Touche une couleur en bas : toute la zone la prend et avale les cases voisines de cette couleur."
          }
        }
      }
    },
