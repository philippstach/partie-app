    },
    "regel.schlagpflicht.info": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer schlagen kann, muss schlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you can knock someone out, you must."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si puedes echar a alguien, tienes que hacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu peux renvoyer un pion, tu dois le faire."
          }
        }
      }
    },
    "regel.sechsNochmal": {
