    "Zug %lld: Mit Spalte %lld hätte %@ in %lld Zügen gewonnen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zug %lld: Mit Spalte %lld hätte %@ in %lld Zügen gewonnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move %lld: With column %lld, %@ would have won in %lld moves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jugada %lld: con la columna %lld, %@ habría ganado en %lld jugadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coup %lld : avec la colonne %lld, %@ aurait gagné en %lld coups."
          }
        }
      }
    },
