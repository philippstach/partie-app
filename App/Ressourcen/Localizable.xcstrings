            "value": "Sudoku %@, %@: ¿Puedes resolver este rompecabezas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudoku %@, %@ : Tu sais résoudre cette grille ?"
          }
        }
      }
    },
    "Du bekommst einen Link. Wer ihn öffnet, löst dasselbe Brett.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You get a link. Whoever opens it solves the same board."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibes un enlace. Quien lo abra resuelve el mismo tablero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu obtiens un lien. Qui l’ouvre résout la même grille."
          }
        }
      }
    },
    "Minensuche, Stufe %@: Schaffst du dieses Brett?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minesweeper, level %@: Can you clear this board?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscaminas, nivel %@: ¿Puedes con este tablero?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démineur, niveau %@ : Tu peux finir cette grille ?"
          }
        }
      }
    },
    "Welche Stufe teilen?": {
      "localizations": {
        "en": {
