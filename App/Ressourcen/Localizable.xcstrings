    "Tipp vom Computer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp vom Computer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hint from the computer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pista del ordenador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil de l’ordinateur"
          }
        }
      }
    },
    "Danach trägst du das Ergebnis in ein freies Feld der Wertungstabelle ein. Passt nichts, streichst du ein Feld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach trägst du das Ergebnis in ein freies Feld der Wertungstabelle ein. Passt nichts, streichst du ein Feld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then you enter the result in a free box of the score sheet. If nothing fits, you cross out a box."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego anotas el resultado en una casilla libre de la tabla. Si nada encaja, tachas una casilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite tu inscris le résultat dans une case libre de la feuille. Si rien ne convient, tu barres une case."
          }
        }
      }
    },
    "Schläger lenken": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schläger lenken"
          }
        },
        "en": {
