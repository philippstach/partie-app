    "Lege dich selbst an, am besten mit Foto – du stehst dann in jedem Spiel bereit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege dich selbst an, am besten mit Foto – du stehst dann in jedem Spiel bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add yourself, ideally with a photo – you will then be ready in every game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añádete, mejor con foto: así estarás listo en cada juego."
          }
        },
