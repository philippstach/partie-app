          }
        }
      }
    },
    "Ihr werft abwechselnd einen Stein in eine Spalte. Der Stein fällt nach unten, bis er auf dem Boden oder einem anderen Stein liegt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr werft abwechselnd einen Stein in eine Spalte. Der Stein fällt nach unten, bis er auf dem Boden oder einem anderen Stein liegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take turns dropping a disc into a column. The disc falls until it rests on the bottom or on another disc."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Echáis por turnos una ficha en una columna. La ficha cae hasta quedar sobre el fondo o sobre otra ficha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous lâchez à tour de rôle un pion dans une colonne. Le pion tombe jusqu’à reposer sur le fond ou sur un autre pion."
          }
        }
      }
    },
    "Ist das Brett voll und niemand hat vier in einer Reihe, endet die Partie unentschieden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist das Brett voll und niemand hat vier in einer Reihe, endet die Partie unentschieden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the board is full and nobody has four in a row, the game ends in a draw."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el tablero está lleno y nadie tiene cuatro en línea, la partida termina en empate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le plateau est plein et que personne n’a quatre alignés, la partie se termine par un match nul."
          }
        }
      }
    },
    "Jetzt zählt jeder Stein.": {
      "localizations": {
