    "Doppeltippen, dann eine zweite Insel in gerader Linie antippen, um eine Brücke zu bauen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap, then tap a second island in a straight line to build a bridge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces y luego toca otra isla en línea recta para construir un puente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois, puis une deuxième île en ligne droite pour construire un pont."
          }
        }
      }
    },
    "Schiebt die Kachel in Richtung der Lücke, wenn sie in derselben Reihe oder Spalte liegt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slides the tile toward the gap if it is in the same row or column."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza la ficha hacia el hueco si está en la misma fila o columna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait glisser la tuile vers le vide si elle est dans la même ligne ou colonne."
          }
        }
      }
    },
    "Zum Auswählen doppeltippen, dann den passenden zweiten Stein antippen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to select, then tap the matching second tile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para seleccionar y luego toca la segunda ficha igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour sélectionner, puis touchez la deuxième tuile assortie."
          }
        }
      }
    },
    "Dieser Stein ist blockiert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tile is blocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ficha está bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tuile est bloquée."
          }
        }
      }
    },
    "Zum Auswählen doppeltippen, dann eine Ziffer eintragen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to select, then enter a digit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para seleccionar y luego escribe una cifra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour sélectionner, puis saisissez un chiffre."
          }
        }
      }
    },
    "Zum Füllen doppeltippen. Mit der Aktion „Markieren“ setzt du ein Kreuz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to fill. Use the \"Mark\" action to place a cross."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para rellenar. Con la acción «Marcar» pones una cruz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour remplir. Avec l’action « Marquer », vous placez une croix."
          }
        }
      }
    },
