          }
        }
      }
    },
    "Warte auf den Scanner …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the scanner …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando al escáner …"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente du scanner …"
          }
        }
      }
    },
    "Öffne auf dem anderen Gerät „Als Würfelscanner nutzen“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the other device, open “Use as dice scanner”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el otro dispositivo, abre «Usar como escáner de dados»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’autre appareil, ouvre « Utiliser comme scanner de dés »."
          }
        }
      }
    },
    "Verbindung": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion"
          }
        }
      }
    },
    "Funk ist aus oder nicht erlaubt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wireless is off or not allowed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión inalámbrica está desactivada o no permitida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sans-fil est désactivé ou non autorisé"
          }
        }
      }
    },
    "Erlaube Partie in den iOS-Einstellungen das lokale Netzwerk und schalte WLAN und Bluetooth ein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Partie to use the local network in the iOS settings and turn on Wi-Fi and Bluetooth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a Partie usar la red local en los ajustes de iOS y activa el Wi-Fi y el Bluetooth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise Partie à utiliser le réseau local dans les réglages iOS et active le Wi-Fi et le Bluetooth."
          }
        }
      }
    },
    "Bekannte Geräte": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known devices"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos conocidos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareils connus"
          }
        }
      }
    },
    "Verbunden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté"
          }
        }
      }
    },
    "Vergessen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier"
          }
        }
      }
    },
    "Bekannte Geräte verbinden sich von selbst und fragen nicht mehr nach. Nach „Vergessen“ musst du die Verbindung wieder bestätigen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known devices connect by themselves and no longer ask. After “Forget” you have to confirm the connection again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos conocidos se conectan solos y ya no preguntan. Tras «Olvidar» tendrás que volver a confirmar la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils connus se connectent d’eux-mêmes et ne demandent plus rien. Après « Oublier », tu devras de nouveau confirmer la connexion."
          }
        }
      }
    },
    "Scanner „%@“: Verbindung wird wiederhergestellt …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanner “%@”: reconnecting …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escáner «%@»: restableciendo la conexión …"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanner « %@ » : reconnexion en cours …"
          }
        }
      }
    },
    "Scanner „%@“ verbunden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanner “%@” connected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escáner «%@» conectado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanner « %@ » connecté"
          }
        }
      }
    },
    "Lege die Würfel unter das andere Gerät. Der Wurf erscheint hier.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place the dice under the other device. The roll appears here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca los dados debajo del otro dispositivo. La tirada aparece aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place les dés sous l’autre appareil. Le lancer apparaît ici."
          }
        }
      }
    },
    "Lern-Aufnahme (Test)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learning capture (test)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura de aprendizaje (prueba)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture d’apprentissage (test)"
          }
        }
      }
    },
    "Speichert Würfelbilder auf diesem Gerät, damit die Erkennung daraus lernen kann.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves dice images on this device so the recognition can learn from them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda imágenes de dados en este dispositivo para que el reconocimiento pueda aprender de ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre des images de dés sur cet appareil pour que la reconnaissance puisse en tirer des enseignements."
          }
        }
      }
    },
    "Bei jedem bestätigten Wurf werden das Standbild, die Rahmen, die bestätigten Augenzahlen und einige Bilder davor gespeichert, auch die Fotos deiner Umgebung. Die Bilder bleiben auf diesem Gerät und werden nicht gesendet. Sie verlassen es nur, wenn du „Aufnahmen teilen“ wählst. Zum Ausschalten genügt der Schalter, schon gespeicherte Bilder bleiben, bis du sie löschst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With every confirmed roll, the still image, the frames, the confirmed pip counts and a few images before it are saved, including the photos of your surroundings. The images stay on this device and are not sent. They only leave it if you choose “Share captures”. To turn it off, the switch is enough; images already saved stay until you delete them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con cada tirada confirmada se guardan la imagen fija, los recuadros, los puntos confirmados y algunas imágenes anteriores, incluidas las fotos de tu entorno. Las imágenes permanecen en este dispositivo y no se envían. Solo salen de él si eliges «Compartir capturas». Para desactivarlo basta con el interruptor; las imágenes ya guardadas se conservan hasta que las borres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À chaque lancer confirmé, l’image fixe, les cadres, les points confirmés et quelques images précédentes sont enregistrés, y compris les photos de ton environnement. Les images restent sur cet appareil et ne sont pas envoyées. Elles ne le quittent que si tu choisis « Partager les captures ». Pour désactiver, il suffit d’utiliser l’interrupteur ; les images déjà enregistrées restent jusqu’à ce que tu les supprimes."
          }
        }
      }
    },
    "Gespeicherte Würfe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved rolls"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiradas guardadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancers enregistrés"
          }
        }
      }
    },
    "Keine": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun"
          }
        }
      }
    },
    "%lld, davon %lld korrigiert": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld, of which %lld corrected"
          }
        },
        "es": {
