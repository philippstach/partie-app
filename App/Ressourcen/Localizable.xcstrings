    "regeln.raus": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Figuren starten im Haus. Mit einer 6 kommt eine Figur auf dein Startfeld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All pieces start at home. A 6 brings one onto your start square."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las fichas empiezan en casa. Un 6 saca una a tu casilla de salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les pions commencent à la maison. Un 6 en fait sortir un sur ta case de départ."
          }
        }
      }
    },
    "regeln.raus.titel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rauskommen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
