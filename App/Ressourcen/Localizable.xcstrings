    "Gemischt hat das Tagesziel mit Krone und Pokal. Leicht und Schwer zählen nur als gewonnen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixed has the daily goal with crown and trophy. Easy and Hard only count as won."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixto tiene el objetivo diario con corona y trofeo. Fácil y Difícil solo cuentan como ganada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixte comporte l’objectif du jour avec couronne et trophée. Facile et Difficile comptent seulement comme gagnée."
          }
        },
