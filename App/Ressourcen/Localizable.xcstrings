    },
    "Lege nach oben und unten an, immer die nächste Zahl. So viele Karten du kannst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add upwards and downwards, always the next number. As many cards as you can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade hacia arriba y hacia abajo, siempre el número siguiente. Tantas cartas como puedas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose vers le haut et le bas, toujours le chiffre suivant. Autant de cartes que tu peux."
          }
        }
      }
    },
    "Neue Verteilung?": {
