    "Reihum denkt sich einer ein Wort aus, der Nächste rät. Wer scheitert, gibt dem Wortgeber 3 Punkte.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reihum denkt sich einer ein Wort aus, der Nächste rät. Wer scheitert, gibt dem Wortgeber 3 Punkte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In turn one person thinks of a word, the next one guesses. If the guesser fails, the word-giver gets 3 points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por turnos uno piensa una palabra y el siguiente adivina. Si falla, quien la pensó recibe 3 puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À tour de rôle l’un pense à un mot, le suivant devine. S’il échoue, celui qui a choisi le mot reçoit 3 points."
          }
        }
      }
    },
