            "state": "translated",
            "value": "Danach hilft nur Probieren: Diese Zelle hat die wenigsten Möglichkeiten (%lld)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After that, only trying helps: this cell has the fewest possibilities (%lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después solo ayuda probar: esta celda tiene menos posibilidades (%lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, seul l’essai aide : cette case a le moins de possibilités (%lld)."
          }
        }
      }
    },
