    "Steht im Yacht-Feld 50 Punkte, bringt jedes weitere Yacht, das du mit dem Joker einträgst, 100 Punkte extra. Der Yacht-Bonus schaltet den Joker immer mit ein.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steht im Yacht-Feld 50 Punkte, bringt jedes weitere Yacht, das du mit dem Joker einträgst, 100 Punkte extra. Der Yacht-Bonus schaltet den Joker immer mit ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the Yacht box shows 50 points, every further Yacht you score with the joker earns 100 extra points. The Yacht bonus always switches the joker on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la casilla Yacht tiene 50 puntos, cada Yacht adicional que anotes con el comodín da 100 puntos extra. El bonus Yacht activa siempre el comodín."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la case Yacht affiche 50 points, chaque Yacht supplémentaire marqué avec le joker rapporte 100 points en plus. Le bonus Yacht active toujours le joker."
          }
        }
      }
    },
