          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est parti"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Los geht’s"
          }
        }
      }
    },
    "Man will nicht verlieren. Wer am Ende einer Hälfte alle Deckel hat, verliert diese Hälfte. Wer zwei Hälften oder das Finale verliert, verliert die Partie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The aim is not to lose. Whoever holds all the lids at the end of a half loses that half. Whoever loses two halves, or the final, loses the game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se trata de no perder. Quien tiene todas las tapas al final de una mitad pierde esa mitad. Quien pierde dos mitades o la final pierde la partida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le but est de ne pas perdre. Celui qui a tous les couvercles à la fin d’une moitié perd cette moitié. Qui perd deux moitiés ou la finale perd la partie."
          }
        }
      }
    },
