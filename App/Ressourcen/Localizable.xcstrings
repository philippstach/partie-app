    "Doppeltippen baut oder ändert die Brücke von der gewählten Insel hierher.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to build or change the bridge from the selected island to here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para construir o cambiar el puente desde la isla elegida hasta aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche deux fois pour construire ou modifier le pont depuis l’île choisie jusqu’ici."
          }
        }
      }
    },
    "Zu viele Brücken": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many bridges"
