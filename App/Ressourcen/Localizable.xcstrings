    "Noch keine Spieler. Lege die erste Person an, am besten mit Foto – sie steht dann in jedem Spiel bereit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Spieler. Lege die erste Person an, am besten mit Foto – sie steht dann in jedem Spiel bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No players yet. Add the first person, ideally with a photo – they will be ready in every game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay jugadores. Añade a la primera persona, mejor con foto: estará lista en todos los juegos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de joueurs. Ajoutez la première personne, de préférence avec photo : elle sera prête dans chaque jeu."
          }
        }
      }
    },
    "Im Modus „Pechvogel“ verliert, wer das letzte Hölzchen nehmen muss.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Modus „Pechvogel“ verliert, wer das letzte Hölzchen nehmen muss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In “Booby” mode, whoever has to take the last stick loses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo «Pichón» pierde quien tenga que coger el último palillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode « Malchanceux », celui qui doit prendre la dernière allumette perd."
          }
        }
      }
    },
    "Keine Ziffer doppelt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Ziffer doppelt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No digit twice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna cifra repetida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun chiffre en double"
          }
        }
      }
    },
    "Karten anlegen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten anlegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move cards"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar cartas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poser des cartes"
          }
        }
      }
    },
    "Ziel: Am Ende soll nur ein einziger Stecker übrig sein. Gehen keine Sprünge mehr, ist das Spiel zu Ende.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel: Am Ende soll nur ein einziger Stecker übrig sein. Gehen keine Sprünge mehr, ist das Spiel zu Ende."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goal: only a single peg should be left at the end. When no jumps remain, the game is over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo: al final debe quedar una sola clavija. Cuando ya no hay saltos, el juego termina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "But : à la fin, il ne doit rester qu’une seule cheville. Quand plus aucun saut n’est possible, la partie est terminée."
          }
        }
      }
    },
    "Einer bleibt übrig": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einer bleibt übrig"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One is left"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda una"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’en reste qu’une"
          }
        }
      }
    },
    "Gaben fangen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaben fangen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Catch the gifts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrapar regalos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attraper les bonus"
          }
        }
      }
    },
    "Jeder falsche Buchstabe lässt einen Ballon platzen. Sind alle 8 weg, ist die Runde vorbei.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder falsche Buchstabe lässt einen Ballon platzen. Sind alle 8 weg, ist die Runde vorbei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every wrong letter pops a balloon. When all 8 are gone, the round is over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada letra equivocada hace explotar un globo. Cuando desaparecen los 8, la ronda termina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mauvaise lettre fait éclater un ballon. Quand les 8 ont disparu, la manche est terminée."
          }
        }
      }
    },
    "Wer zuerst sieben Punkte hat, gewinnt. Zu zweit zieht der zweite Spieler im oberen Feld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer zuerst sieben Punkte hat, gewinnt. Zu zweit zieht der zweite Spieler im oberen Feld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first to seven points wins. With two players, the second one drags in the upper half."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana quien consiga primero siete puntos. Entre dos, el segundo jugador arrastra en la mitad de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier à sept points gagne. À deux, le second joueur glisse dans la moitié du haut."
          }
        }
      }
    },
    "Dein Läufer rennt von allein und wird schneller. Tippe aufs Feld, um zu springen: über Hürden und über Löcher.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Läufer rennt von allein und wird schneller. Tippe aufs Feld, um zu springen: über Hürden und über Löcher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your runner runs by itself and gets faster. Tap the screen to jump: over hurdles and over gaps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu corredor corre solo y cada vez más rápido. Toca la pantalla para saltar: sobre vallas y huecos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton coureur court tout seul et accélère. Touche l’écran pour sauter : par-dessus les haies et les trous."
          }
        }
      }
    },
    "Innerhalb einer Summe darf keine Ziffer doppelt vorkommen. Doppelte oder zu große Summen werden rot markiert.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Innerhalb einer Summe darf keine Ziffer doppelt vorkommen. Doppelte oder zu große Summen werden rot markiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Within one sum no digit may appear twice. Duplicates or sums that are too large are marked red."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dentro de una suma no puede repetirse ninguna cifra. Los duplicados o las sumas demasiado grandes se marcan en rojo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans une somme, aucun chiffre ne peut apparaître deux fois. Les doublons ou les sommes trop grandes sont marqués en rouge."
          }
        }
      }
    },
    "Verschiebe die Teile, drehe sie und lass sie landen. Ein gelandetes Teil lässt sich noch kurz verschieben.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebe die Teile, drehe sie und lass sie landen. Ein gelandetes Teil lässt sich noch kurz verschieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the pieces, rotate them and let them land. A landed piece can still be moved briefly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve las piezas, gíralas y déjalas caer. Una pieza ya aterrizada aún se puede mover un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace les pièces, tourne-les et laisse-les tomber. Une pièce posée peut encore être déplacée un court instant."
          }
        }
      }
    },
    "Tippe eine Kachel in der Reihe der Lücke, um sie (und alle dazwischen) zu verschieben.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe eine Kachel in der Reihe der Lücke, um sie (und alle dazwischen) zu verschieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a tile in the row of the gap to slide it (and all tiles in between)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una pieza de la fila del hueco para moverla (y todas las que hay entre medias)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche une tuile dans la rangée de la case vide pour la faire glisser (avec toutes celles entre les deux)."
          }
        }
      }
    },
    "Von Wolke zu Wolke": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Wolke zu Wolke"
          }
