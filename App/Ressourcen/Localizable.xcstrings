          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire 15"
          }
        }
      }
    },
    "Setze einen Stein so, dass gegnerische Steine zwischen deinem neuen und einem deiner Steine liegen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze einen Stein so, dass gegnerische Steine zwischen deinem neuen und einem deiner Steine liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a disc so that opponent discs lie between your new disc and one of yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca una ficha de modo que fichas rivales queden entre la nueva y otra tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose un pion pour que des pions adverses se trouvent entre le nouveau et l’un des tiens."
          }
        }
      }
    },
