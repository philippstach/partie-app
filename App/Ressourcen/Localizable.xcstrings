    "Ihr würfelt am Tisch und tippt nach jedem Wurf die Augen ein. Die App rechnet die Punkte aus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr würfelt am Tisch und tippt nach jedem Wurf die Augen ein. Die App rechnet die Punkte aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You roll at the table and enter the pips after each roll. The app works out the points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiráis en la mesa e introducís los puntos de los dados tras cada tirada. La app calcula los puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous lancez les dés sur la table et saisissez les points après chaque lancer. L’appli calcule les points."
          }
        }
      }
    },
