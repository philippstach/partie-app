    "Lösbare Partien hat ein Computer vorab bis zum Sieg durchgespielt. Zufällige Partien sind manchmal nicht zu gewinnen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Winnable deals have been played through to a win by a computer in advance. Random deals sometimes can’t be won."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una computadora ha jugado antes las partidas resolubles hasta ganar. Las partidas aleatorias a veces no se pueden ganar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ordinateur a joué d’avance les donnes gagnables jusqu’à la victoire. Les donnes aléatoires ne sont parfois pas gagnables."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösbare Partien hat ein Computer vorab bis zum Sieg durchgespielt. Zufällige Partien sind manchmal nicht zu gewinnen."
          }
        }
      }
    },
