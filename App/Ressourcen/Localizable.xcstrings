    "regeln.versuche": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kannst du gar nicht ziehen, hast du drei Versuche für eine 6."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you can’t move at all, you get three tries for a 6."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no puedes mover en absoluto, tienes tres intentos para sacar un 6."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu ne peux pas du tout jouer, tu as trois essais pour faire un 6."
          }
        }
      }
    },
    "regeln.versuche.titel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Versuche"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three tries"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres intentos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois essais"
          }
        }
      }
    },
    "regeln.ziehen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh eine Figur so viele Felder vor, wie der Würfel zeigt. Landest du auf einer fremden Figur, fliegt sie zurück in ihr Haus. Auf ein Feld mit deiner eigenen Figur darfst du nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move a piece as many squares as the die shows. Land on another player’s piece and it goes back home. You can’t land on your own piece."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve una ficha tantas casillas como indique el dado. Si caes en la ficha de otro jugador, vuelve a casa. No puedes caer en una ficha propia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avance un pion d’autant de cases que le dé indique. Si tu tombes sur le pion d’un autre joueur, il retourne à la maison. Tu ne peux pas tomber sur ton propre pion."
          }
        }
      }
    },
    "regeln.ziehen.titel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen und schlagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving and knocking out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover y echar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancer et renvoyer"
          }
        }
      }
    },
    "regeln.ziel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring alle vier Figuren als Erster in dein Ziel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to get all four pieces into your goal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en llevar las cuatro fichas a tu meta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à amener tes quatre pions dans ton arrivée."
          }
        }
      }
    },
    "regeln.ziel.n": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring alle %lld Figuren als Erster in dein Ziel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to get all %lld pieces into your goal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en llevar las %lld fichas a tu meta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à amener tes %lld pions dans ton arrivée."
          }
        }
      }
    },
    "regeln.ziel.titel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goal"
          }
        },
