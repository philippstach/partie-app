          "stringUnit": {
            "state": "translated",
            "value": "Lance les %lld dés libres et touche ceux que tu mets de côté."
          }
        }
      }
    },
    "Beim Mäxchen der höchste Wurf: eine 2 und eine 1. Schlägt alles.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Mäxchen the highest roll: a 2 and a 1. Beats everything."
          }
        },
