          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser les suggestions de noms ?"
          }
        }
      }
    },
    "Beim Schocken ein Wurf mit zwei Einsen; „Schock aus“ (drei Einsen) beendet die Runde sofort.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Schocken a roll with two ones; “Schock out” (three ones) ends the round immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Schocken, una tirada con dos unos; «Schock aus» (tres unos) termina la ronda de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À Schocken, un lancer avec deux as ; « Schock aus » (trois as) termine la manche aussitôt."
          }
        }
      }
    },
    "nach Partien": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "by games"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "por partidas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "par parties"
          }
        }
      }
    },
    "Danach entscheidest du: aufhören und die Punkte sichern, oder mit den übrigen Würfeln weiterwürfeln und mehr riskieren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then you decide: stop and bank the points, or keep rolling the remaining dice and risk more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después decides: parar y asegurar los puntos, o seguir tirando con los dados restantes y arriesgar más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, tu décides : t’arrêter et sécuriser les points, ou continuer avec les dés restants et risquer davantage."
          }
        }
      }
    },
    "Liste löschen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete list"
          }
        },
        "es": {
