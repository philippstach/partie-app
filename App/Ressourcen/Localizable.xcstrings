    "Wische auf dem Brett oder nutze die Pfeile. Zurück: noch %lld×": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe on the board or use the arrows. Undo: %lld left"
          }
        },
        "es": {
