    "Startet eine neue Partie eines Spiels, auf Wunsch mit Spielerzahl und Computergegnern.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet eine neue Partie eines Spiels, auf Wunsch mit Spielerzahl und Computergegnern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a new game of a title, optionally with a number of players and computer opponents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza una partida nueva de un juego, si quieres con número de jugadores y rivales del ordenador."
          }
        },
