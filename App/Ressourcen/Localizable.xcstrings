          }
        }
      }
    },
    "Niete: Die 150 aus diesem Zug sind weg": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bust: the 150 from this turn are gone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulo: se pierden los 150 de este turno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raté : les 150 de ce tour sont perdus"
          }
        }
      }
    },
    "Alle Karten einer Runde zusammen. Die höchste Karte (oder der Trumpf) gewinnt den Stich.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All cards of one round together. The highest card (or the trump) wins the trick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las cartas de una ronda juntas. La carta más alta (o el triunfo) gana la baza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les cartes d’un tour ensemble. La carte la plus haute (ou l’atout) remporte le pli."
          }
        }
      }
    },
    "Rochade": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Castling"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enroque"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Roque"
          }
        }
      }
    },
    "Alles löschen": {
      "localizations": {
