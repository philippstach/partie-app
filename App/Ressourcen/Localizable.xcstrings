            "value": "Brelans et suite"
          }
        }
      }
    },
    "Drei gleiche zählen Augenzahl mal 100, drei Einsen 1.000. Eine Straße bringt 1.000.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei gleiche zählen Augenzahl mal 100, drei Einsen 1.000. Eine Straße bringt 1.000."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three of a kind score the number times 100, three 1s score 1,000. A straight scores 1,000."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres iguales valen el número por 100, tres unos 1.000. Una escalera vale 1.000."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois dés identiques valent le chiffre fois 100, trois 1 valent 1 000. Une suite vaut 1 000."
          }
        }
      }
    },
    "Aufhören oder weiter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufhören oder weiter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop or go on"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar o seguir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’arrêter ou continuer"
          }
        }
      }
    },
    "Schreibe die Punkte an oder würfle weiter. Eine Niete löscht den Zug. Wer zuerst das Ziel erreicht, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe die Punkte an oder würfle weiter. Eine Niete löscht den Zug. Wer zuerst das Ziel erreicht, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank your points or keep rolling. A bust wipes the turn. First to the target wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota los puntos o sigue tirando. Un fallo borra el turno. Gana quien llegue primero al objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez vos points ou continuez à lancer. Un raté annule le tour. Le premier à atteindre l’objectif gagne."
          }
        }
      }
    },
