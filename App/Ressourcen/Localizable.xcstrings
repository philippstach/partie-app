    "Beim Escoba: alle Karten vom Tisch auf einmal nehmen, indem sie zusammen 15 ergeben. Gibt einen Extrapunkt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Escoba: take all cards from the table at once by making a total of 15. Earns an extra point."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la Escoba: llevarse todas las cartas de la mesa de una vez sumando 15. Da un punto extra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’Escoba : prendre toutes les cartes de la table d’un coup en faisant 15. Rapporte un point en plus."
          }
        }
      }
    },
