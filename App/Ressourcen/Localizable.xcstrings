    "Leicht, Mittel und Schwer hängen vom Wort ab: Kurze Wörter mit seltenen Buchstaben sind oft schwerer als lange mit häufigen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easy, Medium and Hard depend on the word: short words with rare letters are often harder than long ones with common letters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fácil, Medio y Difícil dependen de la palabra: las palabras cortas con letras poco frecuentes suelen ser más difíciles que las largas con letras comunes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facile, Moyen et Difficile dépendent du mot : les mots courts avec des lettres rares sont souvent plus durs que les longs avec des lettres courantes."
          }
        }
      }
    },
