          "stringUnit": {
            "state": "translated",
            "value": "Resumes this game"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúa esta partida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprend cette partie"
          }
        }
      }
    },
    "Neuen Stein einsetzen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a new piece"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar una ficha nueva"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poser un nouveau pion"
          }
        }
      }
    },
    "Stein von Feld %lld nach Feld %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move piece from square %1$lld to square %2$lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover ficha de la casilla %1$lld a la casilla %2$lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer le pion de la case %1$lld à la case %2$lld"
          }
        }
      }
    },
    "Kein Würfel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Würfel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a die"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es un dado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas un dé"
          }
        }
      }
    },
    "Neu scannen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neu scannen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear de nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanner à nouveau"
          }
        }
      }
    },
    "Noch einen Moment ruhig halten": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch einen Moment ruhig halten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold still a moment longer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén quieto un momento más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne bougez pas encore un instant"
          }
        }
      }
    },
    "Die Ansage ist auf diesem Gerät gerade nicht verfügbar. Tippe die Augen ein.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ansage ist auf diesem Gerät gerade nicht verfügbar. Tippe die Augen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice entry is not available on this device right now. Type in the pips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrada por voz no está disponible ahora en este dispositivo. Escribe los puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée n’est pas disponible sur cet appareil pour le moment. Saisis les points."
          }
        }
      }
    },
    "Nichts verstanden. Sag die Augen einzeln und deutlich, oder tippe sie ein.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts verstanden. Sag die Augen einzeln und deutlich, oder tippe sie ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing understood. Say the pips one by one and clearly, or type them in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se entendió nada. Di los puntos uno a uno y con claridad, o escríbelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien compris. Dis les points un par un et clairement, ou saisis-les."
          }
        }
      }
    },
    "Nicht alle Würfel verstanden. Ergänze die fehlenden mit den Zifferntasten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht alle Würfel verstanden. Ergänze die fehlenden mit den Zifferntasten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not all dice understood. Fill in the missing ones with the number keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se entendieron todos los dados. Completa los que faltan con las teclas numéricas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les dés n’ont pas été compris. Complète les manquants avec les touches numériques."
          }
        }
      }
    },
    "%lld von %lld Würfeln erkannt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld von %lld Würfeln erkannt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of %lld dice recognised"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld dados reconocidos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dés reconnus sur %lld"
          }
        }
      }
    },
    "Angehalten. Tippe auf einen Würfel, um ihn zu ändern.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angehalten. Tippe auf einen Würfel, um ihn zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused. Tap a die to change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa. Toca un dado para cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause. Touchez un dé pour le modifier."
          }
        }
      }
    },
    "Anhalten": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre en pause"
          }
        }
      }
    },
    "Welche Augenzahl zeigt der Würfel?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Augenzahl zeigt der Würfel?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which number does the die show?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué número muestra el dado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel nombre le dé affiche-t-il ?"
          }
        }
      }
    },
    "Alle Würfel erkannt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Würfel erkannt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All dice recognised"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los dados reconocidos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les dés sont reconnus"
          }
        }
      }
    },
    "Ich höre zu. Sag die Augen, zum Beispiel: drei, fünf, eins.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich höre zu. Sag die Augen, zum Beispiel: drei, fünf, eins."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening. Say the pips, for example: three, five, one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te escucho. Di los puntos, por ejemplo: tres, cinco, uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’écoute. Dis les points, par exemple : trois, cinq, un."
          }
        }
      }
    },
    "Kein Zugriff auf Mikrofon oder Spracherkennung. Erlaube beides in den iOS-Einstellungen unter Partie.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf Mikrofon oder Spracherkennung. Erlaube beides in den iOS-Einstellungen unter Partie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access to the microphone or speech recognition. Allow both in iOS Settings under Partie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso al micrófono o al reconocimiento de voz. Permite ambos en Ajustes de iOS, en Partie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès au micro ou à la reconnaissance vocale. Autorise les deux dans les Réglages iOS, sous Partie."
          }
        }
      }
    },
    "Sag die Augen deiner Würfel der Reihe nach, zum Beispiel: drei, fünf, eins.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag die Augen deiner Würfel der Reihe nach, zum Beispiel: drei, fünf, eins."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say the pips of your dice one after another, for example: three, five, one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di los puntos de tus dados uno tras otro, por ejemplo: tres, cinco, uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis les points de tes dés l’un après l’autre, par exemple : trois, cinq, un."
          }
        }
      }
    },
    "Halte das iPhone über die Würfel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte das iPhone über die Würfel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your iPhone above the dice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el iPhone sobre los dados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez l’iPhone au-dessus des dés."
          }
        }
      }
    },
    "Jeder Mensch braucht einen Namen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Mensch braucht einen Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone needs a name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada persona necesita un nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque personne doit avoir un nom."
          }
        }
      }
    },
    "Ausgewählt: %@ = %@ · Zug %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected: %@ = %@ · Turn %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegido: %@ = %@ · Turno %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisi : %@ = %@ · Tour %@"
          }
        }
      }
    },
    "Jeder weitere gleiche Würfel verdoppelt den Drilling: vier Vieren = 800, fünf Vieren = 1.600.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each further matching die doubles the triple: four fours = 800, five fours = 1,600."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dado igual adicional duplica el trío: cuatro cuatros = 800, cinco cuatros = 1.600."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque dé identique en plus double le brelan : quatre quatre = 800, cinq quatre = 1 600."
          }
        }
      }
    },
    "Vier gleiche Würfel = 1.000, fünf = 2.000, sechs = 3.000.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four of a kind = 1,000, five = 2,000, six = 3,000."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro iguales = 1.000, cinco = 2.000, seis = 3.000."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre identiques = 1 000, cinq = 2 000, six = 3 000."
          }
        }
      }
    },
    "Niete = −%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bust = −%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nula = −%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raté = −%@"
          }
        }
      }
    },
    "Drei Paare = %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three pairs = %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres pares = %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois paires = %@"
          }
        }
      }
    },
    "Es zählt der Drilling, weitere Würfel nur als Einsen oder Fünfen (vier Vieren = 400).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The triple counts, further dice only as ones or fives (four fours = 400)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta el trío; los demás dados solo como unos o cincos (cuatro cuatros = 400)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le brelan compte, les autres dés seulement comme as ou cinq (quatre quatre = 400)."
          }
        }
      }
    },
    "Wurf %lld von 3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll %lld of 3"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirada %lld de 3"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer %lld sur 3"
          }
        }
      }
    },
    "Ohne Namen weiter?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Namen weiter?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue without a name?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguir sin nombre?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer sans nom ?"
          }
        }
      }
    },
    "Mit deinem Namen stehst du in jedem Spiel gleich bereit. Das geht auch später unter Spieler.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deinem Namen stehst du in jedem Spiel gleich bereit. Das geht auch später unter Spieler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With your name you are ready in every game. You can also add it later under Players."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con tu nombre estás listo en cada juego. También puedes añadirlo más tarde en Jugadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec ton nom, tu es prêt dans chaque jeu. Tu peux aussi l’ajouter plus tard sous Joueurs."
          }
        }
      }
    },
    "Namen eingeben": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen eingeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter name"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribir nombre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisir le nom"
          }
        }
      }
    },
    "Ohne Namen weiter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Namen weiter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue without name"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir sin nombre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer sans nom"
          }
        }
      }
    },
    "Wer spielt?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer spielt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who’s playing?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quién juega?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui joue ?"
          }
        }
      }
    },
    "Lege dich einmal an, mit Name und auf Wunsch Foto. Du stehst dann in jedem Spiel schon bereit. Es gibt kein Konto, alles bleibt auf deinem Gerät.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege dich einmal an, mit Name und auf Wunsch Foto. Du stehst dann in jedem Spiel schon bereit. Es gibt kein Konto, alles bleibt auf deinem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set yourself up once with a name and, if you like, a photo. You will then be ready in every game. There is no account; everything stays on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Créate una vez con tu nombre y, si quieres, una foto. Así estarás listo en todos los juegos. No hay cuenta; todo se queda en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée-toi une fois, avec ton nom et, si tu veux, une photo. Tu seras alors prêt dans chaque jeu. Il n’y a pas de compte, tout reste sur ton appareil."
          }
        }
      }
    },
    "Du kannst auch später unter „Spieler“ anlegen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst auch später unter „Spieler“ anlegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also do this later under “Players”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes hacerlo más tarde en «Jugadores»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux aussi le faire plus tard sous « Joueurs »."
          }
        }
      }
    },
    "Als Würfelscanner nutzen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Würfelscanner nutzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use as dice scanner"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar como escáner de dados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser comme scanner de dés"
          }
        }
      }
    },
    "Würfel vom Scanner empfangen": {
      "localizations": {
        "de": {
