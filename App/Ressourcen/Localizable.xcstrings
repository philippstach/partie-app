    "Bei Kalaha und Oware: die Steine einer Mulde einzeln reihum in die folgenden Mulden verteilen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Kalaha and Oware: distribute the seeds of a pit one by one into the following pits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Kalaha y Oware: repartir las semillas de un hoyo de una en una por los hoyos siguientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À Kalaha et Oware : distribuer les graines d’une fosse une par une dans les fosses suivantes."
          }
        }
      }
    },
    "Beim Schwimmen: ansagen, dass die letzte Runde läuft. Danach ist jeder noch einmal dran.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Schwimmen: announce that the last round has started. Then everyone gets one more turn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Schwimmen: anunciar que empieza la última ronda. Después cada uno juega una vez más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À Schwimmen : annoncer que le dernier tour commence. Ensuite, chacun joue encore une fois."
          }
        }
      }
    },
    "Höchste je erreichte Punktzahl in einem Arcade-Spiel. Steht auf der Startseite des Spiels.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highest score ever reached in an arcade game. Shown on the game’s home screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La puntuación más alta alcanzada en un juego arcade. Aparece en la pantalla de inicio del juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le meilleur score jamais atteint dans un jeu d’arcade. Affiché sur l’écran d’accueil du jeu."
          }
        }
      }
    },
    "Tipp: Karte %lld von %lld, %@ %@ anlegen.": {
      "localizations": {
