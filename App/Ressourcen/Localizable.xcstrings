    "Löse Wort für Wort mit drei Leben. Wer ein Wort gut löst, gewinnt ein Leben zurück, und die Wörter werden schwerer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löse Wort für Wort mit drei Leben. Wer ein Wort gut löst, gewinnt ein Leben zurück, und die Wörter werden schwerer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve word after word with three lives. Solve a word well and you win a life back, and the words get harder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve palabra tras palabra con tres vidas. Si resuelves bien una palabra, recuperas una vida, y las palabras se vuelven más difíciles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résous les mots l’un après l’autre avec trois vies. Un mot bien résolu rapporte une vie, et les mots deviennent plus difficiles."
          }
        }
      }
    },
