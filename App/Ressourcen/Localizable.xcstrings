    "Aus Steinen fallen manchmal Gaben: breiter Schläger, drei Bälle oder ein Extraleben. Fange sie mit dem Schläger.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Steinen fallen manchmal Gaben: breiter Schläger, drei Bälle oder ein Extraleben. Fange sie mit dem Schläger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bricks sometimes drop gifts: a wider paddle, three balls or an extra life. Catch them with the paddle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De los ladrillos caen a veces regalos: pala más ancha, tres pelotas o una vida extra. Atrápalos con la pala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les briques lâchent parfois des bonus : raquette plus large, trois balles ou une vie en plus. Attrape-les avec la raquette."
          }
        }
      }
    },
    "10k": {
      "localizations": {
