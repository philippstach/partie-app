    "Wirf die %lld offenen Würfel und tippe die an, die du rauslegst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll the %lld open dice and tap the ones you set aside."
          }
        },
        "es": {
