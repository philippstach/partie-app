    "Summen bilden": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Summen bilden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the sums"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
