    "Ein Wurf ohne zählende Würfel. Bei Zehntausend sind dann alle Punkte der Runde weg.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wurf ohne zählende Würfel. Bei Zehntausend sind dann alle Punkte der Runde weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A roll with no scoring dice. In Ten Thousand, all points of the round are then lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tirada sin dados que puntúen. En Diez mil se pierden entonces todos los puntos de la ronda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lancer sans dé qui compte. À Dix mille, tous les points du tour sont alors perdus."
          }
        }
      }
    },
    "Die bisherige Wertung geht verloren.": {
