    "Verliere nicht: Wer am Ende der Partie die meisten Hälften verloren hat, verliert die Partie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don’t lose: whoever loses the most halves loses the game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pierdas: quien pierde más mitades pierde la partida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne perds pas : celui qui perd le plus de moitiés perd la partie."
          }
        }
      }
    },
    "Würfeln, Deckel verteilen, nicht verlieren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
