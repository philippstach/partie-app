          }
        }
      }
    },
    "Lege alle Karten nach Farben sortiert von Ass bis König auf die vier Zielstapel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege alle Karten nach Farben sortiert von Ass bis König auf die vier Zielstapel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build all cards onto the four foundation piles by suit, from ace to king."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca todas las cartas por palos en los cuatro montones de salida, del as al rey."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose toutes les cartes par couleur, de l’as au roi, sur les quatre piles de base."
          }
        }
      }
    },
    "Gutschreiben": {
      "localizations": {
