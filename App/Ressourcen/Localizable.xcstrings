    },
    "regeln.zielfelder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einer Runde geht es in dein Ziel. Du musst genau passen – über das letzte Feld hinaus geht es nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After one lap your piece enters your goal. The roll must fit – you can’t go past the last square."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras una vuelta, tu ficha entra en tu meta. El número tiene que encajar: no puedes pasar de la última casilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après un tour, ton pion entre dans ton arrivée. Le dé doit tomber juste – tu ne peux pas dépasser la dernière case."
          }
        }
      }
    },
    "regeln.zielfelder.titel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ins Ziel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Into the goal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacia la meta"
          }
        },
        "fr": {
