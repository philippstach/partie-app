            "value": "Autoriser les notifications dans les Réglages de l’iPhone"
          }
        }
      }
    },
    "Eine Mitteilung auf diesem iPhone, nur wenn du zustimmst. Sie entfällt, wenn du das Tagesrätsel schon gelöst hast.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A notification on this iPhone, only if you agree. It is skipped if you already solved today’s puzzle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notificación en este iPhone, solo si estás de acuerdo. No se envía si ya has resuelto el pasatiempo de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification sur cet iPhone, seulement si tu es d’accord. Elle n’est pas envoyée si tu as déjà résolu la grille du jour."
          }
        }
      }
    },
    "Dein Tagesrätsel wartet – eine Runde?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
