          }
        }
      }
    },
    "Eine Farbe, die in dieser Partie alle anderen Farben schlägt, egal wie hoch die Karte ist.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A suit that beats all other suits in this game, no matter how high the card is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un palo que en esta partida gana a todos los demás, sin importar lo alta que sea la carta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une couleur qui bat toutes les autres dans cette partie, quelle que soit la valeur de la carte."
          }
        }
      }
    },
    "Goldener Blitz, alle Würfel kommen zurück": {
