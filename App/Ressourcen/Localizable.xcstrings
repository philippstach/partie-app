    "Öffnet die Hausregeln": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the house rules"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre las reglas de la casa"
          }
        },
        "fr": {
