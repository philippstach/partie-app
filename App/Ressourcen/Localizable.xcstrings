    "Tippen = springen · nach unten wischen = ducken": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen = springen · nach unten wischen = ducken"
          }
        },
        "en": {
          "stringUnit": {
