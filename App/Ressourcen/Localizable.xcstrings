    "Mit Finale: zwei Hälften, bei zwei verschiedenen Verlierern ein Finale. Sonst zählt eine einzige Hälfte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With final: two halves, and a final if the losers differ. Otherwise a single half decides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con final: dos mitades y, si los perdedores son distintos, una final. Si no, decide una sola mitad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec finale : deux moitiés, et une finale si les perdants diffèrent. Sinon, une seule moitié compte."
          }
        }
      }
    },
