    "Zieh nicht zu früh vom Stapel: Schau erst, welche Paare in der Pyramide schon gehen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don’t draw from the stock too early: first look at which pairs the pyramid already allows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No robes del mazo demasiado pronto: mira primero qué parejas permite ya la pirámide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne piochez pas trop tôt : regardez d’abord quelles paires la pyramide permet déjà."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh nicht zu früh vom Stapel: Schau erst, welche Paare in der Pyramide schon gehen."
          }
        }
      }
    },
