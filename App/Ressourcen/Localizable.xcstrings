            "value": "Recommencer cette grille ?"
          }
        }
      }
    },
    "Drei Fehler": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Fehler"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three mistakes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres errores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois erreurs"
          }
        }
      }
    },
    "Du hast das Fehlerlimit erreicht. Du kannst trotzdem weiterspielen oder neu starten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das Fehlerlimit erreicht. Du kannst trotzdem weiterspielen oder neu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have reached the mistake limit. You can keep playing anyway or start over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado el límite de errores. Puedes seguir jugando igualmente o empezar de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as atteint la limite d’erreurs. Tu peux quand même continuer ou recommencer."
          }
        }
      }
    },
    "Durchschnitt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchschnitt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Promedio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moyenne"
          }
        }
      }
    },
    "Ein Schwertfisch für die %@: Die Zahl liegt in drei Linien nur in denselben drei Kreuzungslinien. Sie fällt dort aus allen anderen Zellen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schwertfisch für die %@: Die Zahl liegt in drei Linien nur in denselben drei Kreuzungslinien. Sie fällt dort aus allen anderen Zellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A swordfish for the %@: In three lines the number lies only in the same three crossing lines. It can be removed from all other cells there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Swordfish para el %@: en tres líneas el número solo está en las mismas tres líneas que las cruzan. Se descarta de todas las demás celdas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Swordfish pour le %@ : dans trois lignes, le chiffre n’apparaît que dans les mêmes trois lignes croisées. Il est éliminé de toutes les autres cases."
          }
        }
      }
    },
    "Ein X-Wing für die %@: Die Zahl liegt in zwei Linien nur in denselben zwei Kreuzungen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein X-Wing für die %@: Die Zahl liegt in zwei Linien nur in denselben zwei Kreuzungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An X-Wing for the %@: In two lines, the number appears only in the same two crossings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un X-Wing para el %@: en dos líneas el número solo está en los mismos dos cruces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un X-Wing pour le %@ : dans deux lignes, le chiffre n’apparaît que dans les mêmes deux croisements."
          }
        }
      }
    },
    "Ein XY-Flügel: Drei Zellen mit je zwei Möglichkeiten. Die %@ fällt aus jeder Zelle, die beide Zangen sehen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein XY-Flügel: Drei Zellen mit je zwei Möglichkeiten. Die %@ fällt aus jeder Zelle, die beide Zangen sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An XY-Wing: three cells with two possibilities each. The %@ can be removed from every cell that both pincers see."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un XY-Wing: tres celdas con dos posibilidades cada una. El %@ se descarta de toda celda que vean ambas pinzas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une aile XY : trois cases avec chacune deux possibilités. Le %@ est éliminé de toute case vue par les deux pinces."
          }
        }
      }
    },
    "Eine Zahl passt in ihrer Einheit nur an eine Stelle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zahl passt in ihrer Einheit nur an eine Stelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A number fits in only one place within its row, column or box."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un número solo cabe en un lugar de su fila, columna o caja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chiffre ne va qu’à un seul endroit de sa ligne, colonne ou bloc."
          }
        }
      }
    },
