    },
    "Zeigen beide dasselbe Bild, gehört dir das Paar und du darfst noch einmal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen beide dasselbe Bild, gehört dir das Paar und du darfst noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If both show the same picture, the pair is yours and you go again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ambas muestran la misma imagen, la pareja es tuya y juegas otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les deux montrent la même image, la paire est à toi et tu rejoues."
          }
        }
      }
    },
    "Bauer ein Feld vor, Springer in L-Form, Läufer diagonal, Turm gerade, Dame beides, König ein Feld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bauer ein Feld vor, Springer in L-Form, Läufer diagonal, Turm gerade, Dame beides, König ein Feld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawn one square forward, knight in an L, bishop diagonally, rook straight, queen both, king one square."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peón una casilla adelante, caballo en L, alfil en diagonal, torre en recto, dama ambos, rey una casilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pion d’une case, cavalier en L, fou en diagonale, tour en ligne droite, dame les deux, roi d’une case."
          }
        }
      }
    },
    "Es zählt nur die Farbe mit der höchsten Summe. Ass 11, Bilder 10, drei Gleiche 30,5, 31 beendet die Runde.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es zählt nur die Farbe mit der höchsten Summe. Ass 11, Bilder 10, drei Gleiche 30,5, 31 beendet die Runde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your best suit counts. Ace 11, faces 10, three of a kind 30.5, 31 ends the round."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuenta el palo con mayor suma. As 11, figuras 10, tres iguales 30,5, 31 termina la ronda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la meilleure couleur compte. As 11, figures 10, trois identiques 30,5, 31 termine la manche."
          }
        }
      }
    },
    "Aktionskarten": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktionskarten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Action cards"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartas de acción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartes d’action"
          }
        }
      }
    },
    "Lege eine Karte mit gleicher Farbe oder gleichem Wert wie die oberste Karte. Sonst ziehst du eine.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege eine Karte mit gleicher Farbe oder gleichem Wert wie die oberste Karte. Sonst ziehst du eine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a card of the same suit or value as the top card. Otherwise draw one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega una carta del mismo palo o valor que la de arriba. Si no, roba una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose une carte de la même couleur ou valeur que celle du dessus. Sinon, pioche."
          }
        }
      }
    },
    "Lege einen Stein so an, dass die Augen an einem Ende der Reihe übereinstimmen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege einen Stein so an, dass die Augen an einem Ende der Reihe übereinstimmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a tile so its pips match one end of the line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega una ficha cuyos puntos coincidan con un extremo de la fila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose un domino dont les points correspondent à une extrémité de la chaîne."
          }
        }
      }
    },
    "Mit vollständiger Besatzung zählen die übrigen zwei Würfel als Fracht, höchstens 12. Sonst ist sie null.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit vollständiger Besatzung zählen die übrigen zwei Würfel als Fracht, höchstens 12. Sonst ist sie null."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a full crew the other two dice count as cargo, at most 12. Otherwise it is zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la tripulación completa, los otros dos dados son la carga, como mucho 12. Si no, cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec l’équipage complet, les deux autres dés forment la cargaison, 12 au plus. Sinon zéro."
          }
        }
      }
    },
    "Steine einklemmen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steine einklemmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandwich pieces"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrapar fichas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encadrer des pions"
          }
        }
      }
    },
    "Würfeln und ziehen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Würfeln und ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll and move"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirar y avanzar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer et avancer"
          }
        }
      }
    },
    "Bei zwei gleichen Karten legt jeder drei verdeckt dazu und deckt noch eine auf. Die höhere nimmt alles.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei zwei gleichen Karten legt jeder drei verdeckt dazu und deckt noch eine auf. Die höhere nimmt alles."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With two equal cards, each adds three face down and flips another. The higher one takes everything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con dos cartas iguales, cada uno añade tres boca abajo y descubre otra. La más alta se lo lleva todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec deux cartes égales, chacun en pose trois face cachée et en retourne une autre. La plus haute prend tout."
          }
        }
      }
    },
    "Lege eine Karte mit derselben Farbe oder Zahl wie die oberste. Passt nichts, ziehst du.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege eine Karte mit derselben Farbe oder Zahl wie die oberste. Passt nichts, ziehst du."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a card of the same colour or number as the top one. If nothing fits, draw."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega una carta del mismo color o número que la de arriba. Si nada encaja, robas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose une carte de la même couleur ou du même nombre que celle du dessus. Sinon, pioche."
          }
        }
      }
    },
    "Gebot abgeben": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebot abgeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make a bid"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer una apuesta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire une enchère"
          }
        }
      }
    },
    "Hast du höchstens 5 Punkte außerhalb von Kombinationen, darfst du schließen. Wer 100 Punkte erreicht, scheidet aus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du höchstens 5 Punkte außerhalb von Kombinationen, darfst du schließen. Wer 100 Punkte erreicht, scheidet aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With at most 5 points outside combinations you may close. Reaching 100 points knocks you out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con 5 puntos o menos fuera de combinaciones puedes cerrar. Quien llega a 100 puntos queda eliminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec 5 points au plus hors combinaisons, tu peux fermer. Qui atteint 100 points est éliminé."
          }
        }
      }
    },
    "Holt ein Spieler alle 26 Punkte, bekommen die anderen je 26. Wer am wenigsten hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Holt ein Spieler alle 26 Punkte, bekommen die anderen je 26. Wer am wenigsten hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If one player takes all 26 points, the others get 26 each. The lowest score wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un jugador se lleva los 26 puntos, los demás reciben 26 cada uno. Gana quien tenga menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un joueur prend les 26 points, les autres en reçoivent 26. Le plus petit total gagne."
          }
        }
      }
    },
    "Sperren und schlagen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperren und schlagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking and hitting"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear y golpear"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquer et frapper"
          }
        }
      }
    },
    "Zuerst leer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst leer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First to empty"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primero en vaciar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier à finir"
          }
        }
      }
    },
    "Wer zuerst drückt, bekommt den Stapel. Zu Unrecht gedrückt kostet eine Karte. Am Ende gewinnt, wer alle hat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer zuerst drückt, bekommt den Stapel. Zu Unrecht gedrückt kostet eine Karte. Am Ende gewinnt, wer alle hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever taps first takes the pile. Tapping wrongly costs a card. In the end whoever has all the cards wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien pulsa primero se lleva el montón. Pulsar sin motivo cuesta una carta. Gana quien al final los tenga todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus rapide prend la pile. Appuyer à tort coûte une carte. À la fin, qui a toutes les cartes gagne."
          }
        }
      }
    },
    "Landet der letzte Stein in einer leeren eigenen Mulde, gehören dir die Steine gegenüber. Wer am Ende mehr im Haus hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Landet der letzte Stein in einer leeren eigenen Mulde, gehören dir die Steine gegenüber. Wer am Ende mehr im Haus hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your last seed lands in an empty pit of yours, you take the seeds opposite. Most seeds in the store wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu última semilla cae en un hoyo vacío tuyo, te quedas las del hoyo opuesto. Gana quien tenga más en su almacén."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ta dernière graine tombe dans un de tes trous vides, tu prends celles d’en face. Le plus de graines au grenier gagne."
          }
        }
      }
    },
    "Es gibt Rochade, „en passant“ und Umwandlung in eine Dame. Kann man nicht ziehen und steht nicht im Schach, ist es Patt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt Rochade, „en passant“ und Umwandlung in eine Dame. Kann man nicht ziehen und steht nicht im Schach, ist es Patt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is castling, en passant and promotion to a queen. If you cannot move and are not in check, it is stalemate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay enroque, captura al paso y coronación en dama. Si no puedes mover y no estás en jaque, son tablas por rey ahogado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a le roque, la prise en passant et la promotion en dame. Sans coup possible et hors échec, c’est pat."
          }
        }
      }
    },
    "Eine Sieben lässt den Nächsten zwei Karten ziehen, eine Acht lässt ihn aussetzen. Mit dem Buben wünschst du dir eine Farbe.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sieben lässt den Nächsten zwei Karten ziehen, eine Acht lässt ihn aussetzen. Mit dem Buben wünschst du dir eine Farbe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A seven makes the next player draw two, an eight makes them skip. A jack lets you wish for a suit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un siete hace robar dos al siguiente, un ocho le hace perder el turno. Con la jota eliges un palo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sept fait piocher deux cartes au suivant, un huit le fait passer. Avec le valet, tu choisis une couleur."
          }
        }
      }
    },
    "Streit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "War"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guerra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bataille"
          }
        }
      }
    },
    "Lege nach oben bis zum Ass und nach unten bis zur Sieben an.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege nach oben bis zum Ass und nach unten bis zur Sieben an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build up to the ace and down to the seven."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca hacia arriba hasta el as y hacia abajo hasta el siete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complète vers le haut jusqu’à l’as et vers le bas jusqu’au sept."
          }
        }
      }
    },
    "Du musst die ausgespielte Farbe bedienen. Hast du sie nicht, wirfst du eine beliebige Karte ab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst die ausgespielte Farbe bedienen. Hast du sie nicht, wirfst du eine beliebige Karte ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You must follow the suit led. If you have none, discard any card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes seguir el palo jugado. Si no lo tienes, descartas cualquier carta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dois fournir la couleur demandée. Sinon, défausse n’importe quelle carte."
          }
        }
      }
    },
    "Zielzahl": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zielzahl"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target number"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Número objetivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre cible"
          }
        }
      }
    },
    "Ihr setzt abwechselnd je einen Stein auf ein freies Sechseck.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr setzt abwechselnd je einen Stein auf ein freies Sechseck."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take turns placing one stone on a free hexagon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por turnos colocáis una piedra en un hexágono libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À tour de rôle, posez un pion sur un hexagone libre."
          }
        }
      }
    },
    "Sind alle Steine im Heimfeld, trägst du sie ab. Wer zuerst alle abgetragen hat, gewinnt. Varianten zeigt die Spielauswahl.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind alle Steine im Heimfeld, trägst du sie ab. Wer zuerst alle abgetragen hat, gewinnt. Varianten zeigt die Spielauswahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With all pieces home you bear them off. The first to bear off all wins. Variants are in the game list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con todas las fichas en casa las sacas. Gana quien saque todas primero. Las variantes están en la lista de juegos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec tous les pions à la maison, tu les sors. Le premier à tout sortir gagne. Les variantes sont dans la liste des jeux."
          }
        }
      }
    },
    "Stapel gewinnen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stapel gewinnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win the pile"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganar el montón"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagner la pile"
          }
        }
      }
    },
    "Sprung lässt den Nächsten aussetzen, Wende dreht die Richtung, Zwei ziehen lässt ihn zwei Karten nehmen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprung lässt den Nächsten aussetzen, Wende dreht die Richtung, Zwei ziehen lässt ihn zwei Karten nehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip makes the next player miss a turn, reverse flips the direction, draw two makes them take two cards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto hace perder turno al siguiente, el cambio invierte el sentido, robar dos le hace coger dos cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe son tour fait passer le suivant, le sens inverse change la direction, +2 lui fait piocher deux cartes."
          }
        }
      }
    },
    "Über 60 gewinnt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über 60 gewinnt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 60 wins"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más de 60 gana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de 60 gagne"
          }
        }
      }
    },
    "Steine setzen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steine setzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Placing pieces"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar fichas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poser les pions"
          }
        }
      }
    },
    "Achter passen immer, und du wünschst dir eine Farbe.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achter passen immer, und du wünschst dir eine Farbe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eights always fit, and you choose a suit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ochos siempre valen y eliges un palo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les huit vont toujours et tu choisis une couleur."
          }
        }
      }
    },
    "Wer alle Karten hat, gewinnt. Tippe auf die Karten oder schalte „Automatisch“ ein.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer alle Karten hat, gewinnt. Tippe auf die Karten oder schalte „Automatisch“ ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever has all the cards wins. Tap the cards or switch on “Automatic”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana quien tenga todas las cartas. Toca las cartas o activa «Automático»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui a toutes les cartes gagne. Touche les cartes ou active « Automatique »."
          }
        }
      }
    },
    "Sage einen Wert an, ehrlich oder geblufft. Er muss höher sein als die letzte Ansage. Mäxchen (2 und 1) ist am höchsten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sage einen Wert an, ehrlich oder geblufft. Er muss höher sein als die letzte Ansage. Mäxchen (2 und 1) ist am höchsten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Announce a value, honest or bluffed. It must beat the last announcement. Mäxchen (2 and 1) is highest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuncia un valor, sincero o farol. Debe superar el anterior. Mäxchen (2 y 1) es el más alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonce une valeur, honnête ou bluffée. Elle doit dépasser la précédente. Mäxchen (2 et 1) est la plus haute."
          }
        }
      }
    },
    "Jede Figur zieht anders": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Figur zieht anders"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every piece moves differently"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pieza mueve distinto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque pièce bouge autrement"
          }
        }
      }
    },
    "Schlicht (ohne Fangen und Extrazug)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlicht (ohne Fangen und Extrazug)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain (no capture, no extra turn)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple (sin captura ni turno extra)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple (sans capture ni tour bonus)"
          }
        }
      }
    },
    "Sonderzüge": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonderzüge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Special moves"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jugadas especiales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coups spéciaux"
          }
        }
      }
    },
    "Tippe eine deiner Mulden an. Die Steine daraus verteilst du reihum, jeweils einen pro Mulde.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe eine deiner Mulden an. Die Steine daraus verteilst du reihum, jeweils einen pro Mulde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap one of your pits. Its seeds are sown one by one around the board."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca uno de tus hoyos. Sus semillas se reparten una a una alrededor del tablero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un de tes trous. Ses graines sont semées une à une tout autour."
          }
        }
      }
    },
    "Englisch (Dame zieht ein Feld)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Englisch (Dame zieht ein Feld)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "English (kings move one square)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inglesa (la dama avanza una casilla)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anglaise (la dame avance d’une case)"
          }
        }
      }
    },
    "Ihr setzt abwechselnd Steine auf die Punkte des Brettes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr setzt abwechselnd Steine auf die Punkte des Brettes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You take turns placing pieces on the points of the board."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocáis fichas por turnos en los puntos del tablero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous posez à tour de rôle des pions sur les points du plateau."
          }
        }
      }
    },
    "Fuchs muss springen, wenn er kann": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuchs muss springen, wenn er kann"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fox must jump when it can"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El zorro debe saltar si puede"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le renard doit sauter s’il le peut"
          }
        }
      }
    },
    "Es zählen Escobas, die Sieben der Münzen, die meisten Karten, Münzen und Siebener.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es zählen Escobas, die Sieben der Münzen, die meisten Karten, Münzen und Siebener."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Escobas, the seven of coins, most cards, most coins and most sevens all score."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuentan las escobas, el siete de oros, más cartas, más oros y más sietes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptent les escobas, le sept de deniers, le plus de cartes, de deniers et de sept."
          }
        }
      }
    },
    "Du würfelst so oft du willst und zählst die Augen zusammen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du würfelst so oft du willst und zählst die Augen zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll as often as you like and add up the pips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira tantas veces como quieras y suma los puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance autant que tu veux et additionne les points."
          }
        }
      }
    },
    "Drei Stiche": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Stiche"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three tricks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres bazas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois plis"
          }
        }
      }
    },
    "Deine Steine ziehen ein Feld schräg vorwärts, nur auf den dunklen Feldern.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Steine ziehen ein Feld schräg vorwärts, nur auf den dunklen Feldern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pieces move one square diagonally forward, on the dark squares only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fichas avanzan una casilla en diagonal, solo por las casillas oscuras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes pions avancent d’une case en diagonale, uniquement sur les cases foncées."
          }
        }
      }
    },
    "Du legst eine Karte, der andere antwortet. Die höhere Karte derselben Farbe oder ein Trumpf gewinnt den Stich.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du legst eine Karte, der andere antwortet. Die höhere Karte derselben Farbe oder ein Trumpf gewinnt den Stich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You play a card, the other answers. The higher card of the same suit or a trump wins the trick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juegas una carta y el otro responde. Gana la carta más alta del mismo palo o un triunfo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu joues une carte, l’autre répond. La plus haute de la même couleur ou un atout gagne le pli."
          }
        }
      }
    },
    "Ziehen und ablegen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen und ablegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw and discard"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Robar y descartar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piocher et défausser"
          }
        }
      }
    },
    "Klappe offene Zahlen zu, deren Summe genau der Würfelsumme entspricht. Sind 7, 8 und 9 zu, würfelst du mit einem Würfel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klappe offene Zahlen zu, deren Summe genau der Würfelsumme entspricht. Sind 7, 8 und 9 zu, würfelst du mit einem Würfel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shut open numbers whose sum equals the dice total. Once 7, 8 and 9 are shut you roll one die."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra números abiertos cuya suma sea la de los dados. Con 7, 8 y 9 cerrados tiras un solo dado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rabats des nombres ouverts dont la somme égale celle des dés. Une fois 7, 8 et 9 fermés, tu lances un seul dé."
          }
        }
      }
    },
    "Versenken": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versenken"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinking"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hundir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couler"
          }
        }
      }
    },
    "Felder ankreuzen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Felder ankreuzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross out squares"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tachar casillas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocher des cases"
          }
        }
      }
    },
    "Chips": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chips"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chips"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetons"
          }
        }
      }
    },
    "Die niedrigste Hand verliert ein Leben. Wer übrig bleibt, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die niedrigste Hand verliert ein Leben. Wer übrig bleibt, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lowest hand loses a life. The last player standing wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mano más baja pierde una vida. Gana quien quede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La main la plus faible perd une vie. Le dernier en jeu gagne."
          }
        }
      }
    },
    "Biete, wie viele Würfel mit einer Augenzahl am ganzen Tisch liegen. Jedes Gebot muss das letzte übertreffen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Biete, wie viele Würfel mit einer Augenzahl am ganzen Tisch liegen. Jedes Gebot muss das letzte übertreffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bid how many dice of one value are on the whole table. Each bid must beat the last."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apuesta cuántos dados de un valor hay en toda la mesa. Cada apuesta debe superar la anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonce combien de dés d’une valeur il y a sur toute la table. Chaque enchère doit dépasser la précédente."
          }
        }
      }
    },
    "Wer zuerst keine Karten mehr hat, gewinnt. Hausregeln wählst du im Mehr-Menü.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer zuerst keine Karten mehr hat, gewinnt. Hausregeln wählst du im Mehr-Menü."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first player with no cards left wins. Choose house rules in the More menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana quien se quede primero sin cartas. Las reglas de la casa se eligen en el menú Más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier sans cartes gagne. Choisis les règles maison dans le menu Plus."
          }
        }
      }
    },
    "Ecken sichern": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecken sichern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure corners"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegurar esquinas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder les coins"
          }
        }
      }
    },
    "Ziehe Karten, um möglichst nah an 21 zu kommen. Wer darüber liegt, verliert.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe Karten, um möglichst nah an 21 zu kommen. Wer darüber liegt, verliert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw cards to get as close to 21 as possible. Go over and you lose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide cartas para acercarte a 21. Si te pasas, pierdes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire des cartes pour t’approcher de 21. Au-dessus, tu perds."
          }
        }
      }
    },
    "Wer nach elf Runden die meisten Punkte hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer nach elf Runden die meisten Punkte hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever has the most points after eleven rounds wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana quien tenga más puntos tras once rondas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui a le plus de points après onze manches gagne."
          }
        }
      }
    },
    "Wenden": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flipping"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltear"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retourner"
          }
        }
      }
    },
    "Wer die vierte Seite eines Kästchens schließt, bekommt es und darf gleich noch eine Linie ziehen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer die vierte Seite eines Kästchens schließt, bekommt es und darf gleich noch eine Linie ziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever closes the fourth side of a box takes it and draws again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien cierra el cuarto lado de un cuadro se lo queda y traza otra línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui ferme le quatrième côté d’une case la gagne et trace encore un trait."
          }
        }
      }
    },
    "Verdeckte Würfel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdeckte Würfel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden dice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados ocultos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dés cachés"
          }
        }
      }
    },
    "Ass plus Zehnwert zahlt 1,5-fach. Ohne Chips scheidest du aus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ass plus Zehnwert zahlt 1,5-fach. Ohne Chips scheidest du aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ace plus a ten-value card pays 1.5 times. With no chips left you are out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "As más figura de valor diez paga 1,5 veces. Sin fichas quedas eliminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "As plus carte de valeur dix paie 1,5 fois. Sans jetons, tu es éliminé."
          }
        }
      }
    },
    "Sieben und Acht": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieben und Acht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevens and eights"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sietes y ochos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sept et huit"
          }
        }
      }
    },
    "Setze einen Stein aus dem Vorrat aufs Brett oder ziehe einen weiter. Auf ein Feld mit eigenem Stein darfst du nicht.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze einen Stein aus dem Vorrat aufs Brett oder ziehe einen weiter. Auf ein Feld mit eigenem Stein darfst du nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a piece from your stock or move one on. You cannot land on your own piece."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra una ficha de la reserva o mueve una. No puedes caer en una casilla con ficha propia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre un pion de la réserve ou avance-en un. Tu ne peux pas tomber sur ton propre pion."
          }
        }
      }
    },
    "Wer 25 Samen erobert hat, gewinnt. Hat der Gegner keine Samen, musst du ihm möglichst welche geben.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer 25 Samen erobert hat, gewinnt. Hat der Gegner keine Samen, musst du ihm möglichst welche geben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever captures 25 seeds wins. If the opponent has no seeds, you must give them some if you can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana quien capture 25 semillas. Si el rival no tiene semillas, debes darle si puedes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui capture 25 graines gagne. Si l’adversaire n’a plus de graines, tu dois lui en donner si possible."
          }
        }
      }
    },
    "Kannst du nicht anlegen, ziehst du aus dem Vorrat oder passt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kannst du nicht anlegen, ziehst du aus dem Vorrat oder passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you cannot play, draw from the boneyard or pass."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no puedes jugar, robas del pozo o pasas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu ne peux pas jouer, tu piches ou tu passes."
          }
        }
      }
    },
    "Alle Karten liegen verdeckt. Du deckst zwei auf.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Karten liegen verdeckt. Du deckst zwei auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All cards lie face down. You flip two."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las cartas están boca abajo. Descubres dos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les cartes sont face cachée. Tu en retournes deux."
          }
        }
      }
    },
    "Im mittleren Streifen kannst du Gegner schlagen. Rosetten geben einen Extrazug, die mittlere schützt. Wer zuerst alle sieben Steine hinausbringt, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im mittleren Streifen kannst du Gegner schlagen. Rosetten geben einen Extrazug, die mittlere schützt. Wer zuerst alle sieben Steine hinausbringt, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the middle lane you can capture. Rosettes give an extra turn, the central one protects. The first to bring all seven pieces off wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el carril central puedes capturar. Las rosetas dan turno extra, la central protege. Gana quien saque antes las siete fichas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la voie centrale tu peux prendre. Les rosaces donnent un tour de plus, la centrale protège. Le premier à sortir ses sept pions gagne."
          }
        }
      }
    },
    "Pokerhände": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokerhände"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poker hands"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manos de póker"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mains de poker"
          }
        }
      }
    },
    "Erreicht ein Stein die letzte Reihe, wird er Dame und darf weiter ziehen. Die Regelart wählst du im Mehr-Menü.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreicht ein Stein die letzte Reihe, wird er Dame und darf weiter ziehen. Die Regelart wählst du im Mehr-Menü."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A piece that reaches the last row becomes a king and may move further. Choose the rule set in the More menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ficha que llega a la última fila se corona y puede moverse más. La variante se elige en el menú Más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pion qui atteint la dernière rangée devient dame et peut aller plus loin. Choisis la variante dans le menu Plus."
          }
        }
      }
    },
    "Schiffe dürfen sich berühren": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiffe dürfen sich berühren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ships may touch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los barcos pueden tocarse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les navires peuvent se toucher"
          }
        }
      }
    },
    "Flotte": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flotte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fleet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flota"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flotte"
          }
        }
      }
    },
    "In der Mitte baust du Stapel von 1 aufwärts bis 10. Der Stern ersetzt jede Zahl.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Mitte baust du Stapel von 1 aufwärts bis 10. Der Stern ersetzt jede Zahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the middle you build piles from 1 up to 10. The star replaces any number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el centro construyes montones del 1 al 10. La estrella sustituye cualquier número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au centre tu construis des piles de 1 à 10. L’étoile remplace n’importe quel nombre."
          }
        }
      }
    },
    "Die Zahlen 1 bis 9 stehen offen. Du würfelst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlen 1 bis 9 stehen offen. Du würfelst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The numbers 1 to 9 stand open. You roll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números del 1 al 9 están abiertos. Tiras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nombres de 1 à 9 sont ouverts. Tu lances."
          }
        }
      }
    },
    "Jedes Herz zählt 1 Minuspunkt, die Pik-Dame 13. Die höchste Karte der Farbe gewinnt den Stich.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Herz zählt 1 Minuspunkt, die Pik-Dame 13. Die höchste Karte der Farbe gewinnt den Stich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each heart is 1 penalty point, the queen of spades 13. The highest card of the suit wins the trick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada corazón vale 1 punto negativo, la dama de picas 13. La carta más alta del palo gana la baza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque cœur vaut 1 point de pénalité, la dame de pique 13. La plus haute carte de la couleur gagne le pli."
          }
        }
      }
    },
    "Strafpunkte": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Strafpunkte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Penalty points"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntos de castigo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Points de pénalité"
          }
        }
      }
    },
    "Joker und Punkte": {
      "localizations": {
