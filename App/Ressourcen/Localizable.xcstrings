    "Passt nichts, ziehst du eine Karte. Wer zuerst keine Karten mehr hat, gewinnt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If nothing fits, you draw a card. Whoever has no cards left first wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si nada encaja, robas una carta. Gana quien se quede primero sin cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rien ne convient, tu piches une carte. Le premier sans cartes gagne."
          }
        }
      }
    },
    "Elfer raus: mehrere Karten je Zug, Karte ziehen statt passen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleven Out: several cards per turn, draw a card instead of passing."
