          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Former une chaîne"
          }
        }
      }
    },
    "Verkehrt: wenige Steine gewinnen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkehrt: wenige Steine gewinnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverse: fewest discs wins"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inverso: gana quien tenga menos fichas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inversé : le moins de pions gagne"
          }
        }
      }
    },
    "Baue aus Vorrat, Hand oder der Spitze deiner Ablagen. Dein Zug endet mit einer Karte auf einer Ablage.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baue aus Vorrat, Hand oder der Spitze deiner Ablagen. Dein Zug endet mit einer Karte auf einer Ablage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build from your stock, hand or the top of your discard piles. Your turn ends with a card on a discard pile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construye desde tu reserva, tu mano o lo alto de tus descartes. Tu turno acaba con una carta en un descarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construis depuis ta réserve, ta main ou le haut de tes défausses. Ton tour finit par une carte sur une défausse."
          }
        }
      }
    },
    "Nimm alle Samen aus einer deiner Mulden und säe sie gegen den Uhrzeigersinn einzeln aus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm alle Samen aus einer deiner Mulden und säe sie gegen den Uhrzeigersinn einzeln aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take all seeds from one of your pits and sow them one by one counter-clockwise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma todas las semillas de uno de tus hoyos y siémbralas una a una en sentido antihorario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prends toutes les graines d’un de tes trous et sème-les une à une dans le sens antihoraire."
          }
        }
      }
    },
    "Mühle bilden": {
      "localizations": {
