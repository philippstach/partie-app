    "Mitteilungen in den iPhone-Einstellungen erlauben": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications in iPhone Settings"
          }
        },
        "es": {
          "stringUnit": {
