            "state": "translated",
            "value": "Recommencer"
          }
        }
      }
    },
    "Alle Rätsel dieser Stufe sind gelöst. Du kannst sie noch einmal von vorn spielen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All puzzles of this level are solved. You can play them again from the start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has resuelto todos los pasatiempos de este nivel. Puedes jugarlos otra vez desde el principio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les grilles de ce niveau sont résolues. Tu peux les rejouer depuis le début."
          }
        }
      }
    },
