    "Noch %lld Siege ohne Tipp für die nächste Stufe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld more wins without a hint for the next level"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld victorias más sin pista para el siguiente nivel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encore %lld victoires sans indice pour le niveau suivant"
          }
        }
      }
    },
    "offen, %lld von %lld Siegen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "open, %lld of %lld wins"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "abierto, %lld de %lld victorias"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ouvert, %lld victoires sur %lld"
          }
        }
      }
    },
    "Alle Stufen offen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All levels unlocked"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los niveles abiertos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les niveaux ouverts"
          }
        }
      }
    },
    "Dann ist keine Stufe gesperrt. Im Kinder-Modus sind ohnehin alle offen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then no level is locked. In Kids mode all levels are open anyway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entonces ningún nivel está bloqueado. En el modo infantil todos están abiertos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alors aucun niveau n’est verrouillé. En mode enfant, tous sont ouverts."
          }
        }
      }
    },
    "Jede Stufe öffnet sich, wenn du %lld Mal ohne Tipp auf der Stufe davor gewinnst. Tagesrätsel zählen nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each level opens when you win %lld times without a hint on the level before. Daily puzzles don’t count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada nivel se abre cuando ganas %lld veces sin pista en el nivel anterior. Los retos diarios no cuentan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque niveau s’ouvre quand tu gagnes %lld fois sans indice au niveau précédent. Les défis du jour ne comptent pas."
          }
        }
      }
    },
    "Gesperrt. Gewinne %lld Mal ohne Tipp auf der Stufe davor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked. Win %lld times without a hint on the level before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado. Gana %lld veces sin pista en el nivel anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillé. Gagne %lld fois sans indice au niveau précédent."
          }
        }
      }
    },
