    "Wer schon 50 Punkte im Yacht-Feld hat, bekommt für jedes weitere Yacht 100 Punkte extra. Schaltet den Joker mit ein.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer schon 50 Punkte im Yacht-Feld hat, bekommt für jedes weitere Yacht 100 Punkte extra. Schaltet den Joker mit ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you already have 50 points in the Yacht box, every further Yacht earns 100 extra points. Also switches the joker on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien ya tiene 50 puntos en la casilla Yacht recibe 100 puntos extra por cada Yacht adicional. Activa también el comodín."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui qui a déjà 50 points dans la case Yacht reçoit 100 points en plus pour chaque Yacht supplémentaire. Active aussi le joker."
          }
        }
      }
    },
