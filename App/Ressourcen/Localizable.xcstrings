    },
    "Der Spielstand konnte nicht gespeichert werden. Ist der Speicher des Geräts voll? Das Spiel läuft weiter, geht beim Beenden der App aber eventuell verloren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game state could not be saved. Is the device storage full? The game keeps running but may be lost when the app is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la partida. ¿Está lleno el almacenamiento del dispositivo? El juego continúa, pero puede perderse al cerrar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La partie n’a pas pu être enregistrée. Le stockage de l’appareil est-il plein ? Le jeu continue, mais peut être perdu à la fermeture de l’app."
          }
        }
      }
    },
    "Person %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Person %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne %lld"
          }
        }
      }
    },
    "Eine 1 = 100 · Eine 5 = 50\n": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 1 = 100 · A 5 = 50\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un 1 = 100 · Un 5 = 50\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un 1 = 100 · Un 5 = 50\n"
          }
        }
      }
    },
    "Drei Einsen = 1.000\nDrei gleiche = Augenzahl × 100 (z. B. drei Vieren = 400)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three ones = 1,000\nThree of a kind = pips × 100 (e.g. three fours = 400)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres unos = 1.000\nTres iguales = puntos × 100 (p. ej., tres cuatros = 400)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois as = 1 000\nTrois identiques = valeur × 100 (p. ex. trois quatre = 400)"
          }
        }
      }
    },
    "Drei Einsen = 500 · Drei Fünfen = 500\nAndere Drillinge zählen in diesem Spiel nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three ones = 500 · Three fives = 500\nOther triples don’t count in this game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres unos = 500 · Tres cincos = 500\nOtros tríos no cuentan en esta partida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois as = 500 · Trois cinq = 500\nLes autres brelans ne comptent pas dans cette partie."
          }
        }
      }
    },
    "Drei Einsen = 1.000\nDrei gleiche = Augenzahl × 100 (z. B. drei Vieren = 400)\nVariante „Nur Einsen und Fünfen“: nur drei Einsen und drei Fünfen zählen als Drilling, je 500.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three ones = 1,000\nThree of a kind = pips × 100 (e.g. three fours = 400)\nVariant “Ones and fives only”: only three ones and three fives count as a triple, 500 each."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres unos = 1.000\nTres iguales = puntos × 100 (p. ej., tres cuatros = 400)\nVariante «Solo unos y cincos»: solo cuentan como trío tres unos y tres cincos, 500 cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois as = 1 000\nTrois identiques = valeur × 100 (p. ex. trois quatre = 400)\nVariante « Seulement as et cinq » : seuls trois as et trois cinq comptent comme brelan, 500 chacun."
          }
        }
      }
    },
    "\nGroße Straße 1–6 = %@ (nur mit allen 6 in einem Wurf)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nBig straight 1–6 = %@ (only with all 6 in one roll)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\nEscalera grande 1–6 = %@ (solo con los 6 en una tirada)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nGrande suite 1–6 = %@ (seulement avec les 6 dés en un lancer)"
          }
        }
      }
    },
    "\n5er-Straße 1–5 oder 2–6 = 1.000; ein sechster Würfel zählt als 1 oder 5 dazu (1-2-3-4-5-5 = 1.050)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n5-straight 1–5 or 2–6 = 1,000; a sixth die counts as 1 or 5 extra (1-2-3-4-5-5 = 1,050)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\nEscalera de 5: 1–5 o 2–6 = 1.000; un sexto dado cuenta como 1 o 5 adicional (1-2-3-4-5-5 = 1.050)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nSuite de 5 : 1–5 ou 2–6 = 1 000 ; un sixième dé compte en plus comme 1 ou 5 (1-2-3-4-5-5 = 1 050)"
          }
        }
      }
    },
    "\nStraße 1–5 oder 2–6 = 1.000": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nStraight 1–5 or 2–6 = 1,000"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\nEscalera 1–5 o 2–6 = 1.000"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nSuite 1–5 ou 2–6 = 1 000"
          }
        }
      }
    },
    "\nMit 6 Würfeln (Variante): 5er-Straße = 1.000 plus sechster Würfel, oder große Straße 1–6 = %@, je nach Einstellung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nWith 6 dice (variant): 5-straight = 1,000 plus sixth die, or big straight 1–6 = %@, depending on the setting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\nCon 6 dados (variante): escalera de 5 = 1.000 más el sexto dado, o escalera grande 1–6 = %@, según el ajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nAvec 6 dés (variante) : suite de 5 = 1 000 plus le sixième dé, ou grande suite 1–6 = %@, selon le réglage."
          }
        }
      }
    },
    "Wer zuerst die Zielpunkte (%@) erreicht, gewinnt nicht sofort: Die anderen spielen die Runde noch zu Ende, dann gewinnt, wer vorne liegt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever first reaches the target points (%@) doesn’t win immediately: the others finish the round, then whoever is ahead wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien alcanza primero los puntos objetivo (%@) no gana de inmediato: los demás terminan la ronda y después gana quien vaya en cabeza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui qui atteint le premier les points objectifs (%@) ne gagne pas tout de suite : les autres terminent la manche, puis celui qui est en tête gagne."
          }
        }
      }
    },
    "Wer zuerst die Zielpunkte (%@) erreicht, gewinnt sofort – außer im Stechen, dort zählt nur der Zug im Stechen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever first reaches the target points (%@) wins immediately – except in a tiebreak, where only the tiebreak turn counts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien alcanza primero los puntos objetivo (%@) gana de inmediato, salvo en el desempate, donde solo cuenta el turno de desempate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui qui atteint le premier les points objectifs (%@) gagne immédiatement – sauf lors du départage, où seul le tour de départage compte."
          }
        }
      }
    },
    "Du würfelst mit %lld Würfeln. Nach jedem Wurf musst du mindestens einen Würfel mit Punkten rauslegen. Dann aufhören und die Punkte gutschreiben – oder mit den übrigen Würfeln weiterwürfeln.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You roll with %lld dice. After every roll you must set aside at least one scoring die. Then stop and bank the points – or keep rolling with the remaining dice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiras %lld dados. Después de cada tirada debes apartar al menos un dado que puntúe. Luego puedes plantarte y apuntar los puntos, o seguir tirando con los dados restantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu lances %lld dés. Après chaque lancer, tu dois mettre de côté au moins un dé qui marque. Ensuite, arrête-toi et note les points – ou continue avec les dés restants."
          }
        }
      }
    },
    "Pro Wurf": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per roll"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por tirada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par lancer"
          }
        }
      }
    },
    "Gewertet wird nur, was in einem Wurf fällt. Drillinge und Straßen können nicht über mehrere Würfe zusammengesetzt werden. Eine Straße zählt nur, wenn alle %lld Würfel gleichzeitig geworfen wurden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only what lands in a single roll counts. Triples and straights cannot be put together over several rolls. A straight only counts if all %lld dice were rolled at the same time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuenta lo que sale en una misma tirada. Los tríos y las escaleras no pueden formarse a lo largo de varias tiradas. Una escalera solo cuenta si los %lld dados se tiraron a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul compte ce qui tombe en un seul lancer. Les brelans et les suites ne peuvent pas se former sur plusieurs lancers. Une suite ne compte que si les %lld dés ont été lancés en même temps."
          }
        }
      }
    },
    "Bringt ein Wurf keinen einzigen Punkt, ist der Zug vorbei und alle Punkte dieses Zugs sind verloren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a roll scores no points at all, the turn is over and all points of that turn are lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si una tirada no da ningún punto, el turno termina y se pierden todos los puntos de ese turno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un lancer ne rapporte aucun point, le tour est terminé et tous les points de ce tour sont perdus."
          }
        }
      }
    },
    "Alle %lld punkten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All %lld score"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los %lld puntúan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld comptent"
          }
        }
      }
    },
    "Hast du alle %lld Würfel rausgelegt, darfst du mit allen %lld weiterwürfeln – die Punkte bleiben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have set aside all %lld dice, you may keep rolling with all %lld – the points stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si has apartado los %lld dados, puedes seguir tirando con los %lld; los puntos se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu as mis de côté les %lld dés, tu peux continuer avec les %lld – les points restent."
          }
        }
      }
    },
    "Hört jemand auf und lässt Würfel offen, darf die nächste Person diese Würfel samt Punkten übernehmen und weiterwürfeln.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If someone stops and leaves dice open, the next player may take over those dice with their points and keep rolling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si alguien se detiene y deja dados abiertos, el siguiente jugador puede quedarse con esos dados y sus puntos y seguir tirando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si quelqu’un s’arrête et laisse des dés ouverts, le joueur suivant peut reprendre ces dés avec leurs points et continuer à lancer."
          }
        }
      }
    },
    " Sind alle %lld rausgelegt, übernimmst du mit allen %lld Würfeln.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " If all %lld have been set aside, you take over with all %lld dice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Si los %lld se han apartado, te quedas con los %lld dados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Si les %lld ont été mis de côté, tu reprends avec les %lld dés."
          }
        }
      }
    },
    " Sind alle %lld rausgelegt, gibt es in diesem Spiel nichts zu übernehmen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " If all %lld have been set aside, there is nothing to take over in this game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Si los %lld se han apartado, en esta partida no hay nada que recoger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Si les %lld ont été mis de côté, il n’y a rien à reprendre dans cette partie."
          }
        }
      }
    },
    " Beim ersten Wurf nach einer Übernahme zählt keine Straße. Bei einer Niete ist alles weg.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " On the first roll after a take-over, no straight counts. On a bust, everything is lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " En la primera tirada tras recoger no cuenta ninguna escalera. Con un fallo se pierde todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Au premier lancer après une reprise, aucune suite ne compte. Avec un zéro, tout est perdu."
          }
        }
      }
    },
    "In diesem Spiel gibt es keine Strafe für Nieten in Folge.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In this game there is no penalty for busts in a row."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta partida no hay penalización por fallos seguidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans cette partie, il n’y a pas de pénalité pour les zéros d’affilée."
          }
        }
      }
    },
    "Wer noch nicht angeschrieben hat, darf erst aufhören, wenn der Zug mindestens %@ Punkte bringt. Bis dahin weiterwürfeln – oder eine Niete in Kauf nehmen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever hasn’t scored yet may only stop once the turn brings at least %@ points. Until then keep rolling – or risk a bust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien aún no ha anotado puntos solo puede plantarse cuando el turno suma al menos %@ puntos. Hasta entonces sigue tirando, o asume el riesgo de un fallo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui qui n’a pas encore marqué ne peut s’arrêter que lorsque le tour rapporte au moins %@ points. D’ici là, continue à lancer – ou accepte un zéro."
          }
        }
      }
    },
    "Vier, fünf oder sechs gleiche Würfel: Der Drilling verdoppelt sich mit jedem weiteren Würfel. Beispiel: vier Vieren = 800, fünf Vieren = 1.600.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four, five or six of a kind: the triple doubles with every further die. Example: four fours = 800, five fours = 1,600."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro, cinco o seis iguales: el trío se duplica con cada dado adicional. Ejemplo: cuatro cuatros = 800, cinco cuatros = 1.600."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre, cinq ou six dés identiques : le brelan double à chaque dé supplémentaire. Exemple : quatre quatre = 800, cinq quatre = 1 600."
          }
        }
      }
    },
    "Vier gleiche Würfel zählen 1.000, fünf gleiche 2.000, sechs gleiche 3.000.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four of a kind count 1,000, five 2,000, six 3,000."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro iguales valen 1.000, cinco 2.000, seis 3.000."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre dés identiques valent 1 000, cinq 2 000, six 3 000."
          }
        }
      }
    },
    "Drei Paare": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three pairs"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres parejas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois paires"
          }
        }
      }
    },
    "Drei verschiedene Paare in einem Wurf mit allen 6 Würfeln = %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three different pairs in one roll with all 6 dice = %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres parejas distintas en una tirada con los 6 dados = %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois paires différentes en un lancer avec les 6 dés = %@."
          }
        }
      }
    },
    "Ist ein Limit eingestellt, gewinnt nach der letzten Runde, wer die meisten Punkte hat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a limit is set, whoever has the most points after the last round wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hay un límite, tras la última ronda gana quien tenga más puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si une limite est fixée, celui qui a le plus de points après la dernière manche gagne."
          }
        }
      }
    },
    "Erreicht jemand das Ziel, spielen die anderen die Runde noch zu Ende. Danach gewinnt, wer vorne liegt; bei Gleichstand gibt es ein Stechen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If someone reaches the target, the others finish the round. Then whoever is ahead wins; if tied, there is a tiebreak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si alguien alcanza el objetivo, los demás terminan la ronda. Después gana quien vaya en cabeza; si hay empate, hay desempate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si quelqu’un atteint l’objectif, les autres terminent la manche. Ensuite, celui qui est en tête gagne ; en cas d’égalité, il y a un départage."
          }
        }
      }
    },
    "Faire Schlussrunde (Variante)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fair final round (variant)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ronda final justa (variante)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière manche équitable (variante)"
          }
        }
      }
    },
    "Wahlweise gewinnt nicht sofort, wer das Ziel erreicht: Die anderen spielen die Runde noch zu Ende, dann gewinnt, wer vorne liegt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionally, whoever reaches the target doesn’t win immediately: the others finish the round, then whoever is ahead wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionalmente, quien alcanza el objetivo no gana de inmediato: los demás terminan la ronda y después gana quien vaya en cabeza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En option, celui qui atteint l’objectif ne gagne pas tout de suite : les autres terminent la manche, puis celui qui est en tête gagne."
          }
        }
      }
    },
    "Liegen nach der letzten Runde mehrere vorne gleichauf, gibt es ein Stechen: Nur sie haben je einen Zug, in der normalen Reihenfolge. Wer dabei die meisten Punkte macht, gewinnt – bei erneutem Gleichstand folgt die nächste Stechrunde. Das Erreichen der Zielpunkte beendet das Stechen nicht vorzeitig – es zählen nur die Punkte des Stechzugs. Im Stechen gibt es keine Strafe, und übernommen werden kann nur innerhalb der Stechrunde.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If several players are tied for the lead after the last round, there is a tiebreak: only they get one turn each, in the normal order. Whoever scores the most points wins – if tied again, the next tiebreak round follows. Reaching the target points does not end the tiebreak early – only the points of the tiebreak turn count. There is no penalty in the tiebreak, and only takeovers within the tiebreak round are possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tras la última ronda varios jugadores van igualados en cabeza, hay desempate: solo ellos tienen un turno cada uno, en el orden normal. Gana quien consiga más puntos; si vuelve a haber empate, sigue otra ronda de desempate. Alcanzar los puntos objetivo no termina el desempate antes de tiempo: solo cuentan los puntos del turno de desempate. En el desempate no hay penalización y solo se puede recoger dentro de la ronda de desempate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si plusieurs joueurs sont à égalité en tête après la dernière manche, il y a un départage : seuls eux ont un tour chacun, dans l’ordre normal. Celui qui marque le plus de points gagne – en cas de nouvelle égalité, une nouvelle manche de départage suit. Atteindre les points objectifs ne met pas fin au départage prématurément – seuls comptent les points du tour de départage. Il n’y a pas de pénalité lors du départage, et on ne peut reprendre qu’au sein de la manche de départage."
          }
        }
      }
    },
    "Liegen nach der letzten Runde mehrere vorne gleichauf, gewinnen sie gemeinsam (kein Stechen).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If several players are tied for the lead after the last round, they win together (no tiebreak)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tras la última ronda varios jugadores van igualados en cabeza, ganan juntos (sin desempate)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si plusieurs joueurs sont à égalité en tête après la dernière manche, ils gagnent ensemble (pas de départage)."
          }
        }
      }
    },
    "vier Einsen sind 500 + 100 = 600, fünf Einsen 700.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "four ones are 500 + 100 = 600, five ones 700."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cuatro unos son 500 + 100 = 600, cinco unos 700."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "quatre as font 500 + 100 = 600, cinq as 700."
          }
        }
      }
    },
    "bei vier Vieren zählen nur drei (400), vier Einsen sind 1.000 + 100 = 1.100.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "with four fours only three count (400), four ones are 1,000 + 100 = 1,100."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "con cuatro cuatros solo cuentan tres (400), cuatro unos son 1.000 + 100 = 1.100."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "avec quatre quatre, seuls trois comptent (400), quatre as font 1 000 + 100 = 1 100."
          }
        }
      }
    },
    "Vier oder fünf Gleiche": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four or five of a kind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro o cinco iguales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre ou cinq dés identiques"
          }
        }
      }
    },
    "Es zählt der Drilling; weitere Würfel zählen nur, wenn es Einsen oder Fünfen sind – %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The triple counts; further dice only count if they are ones or fives – %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta el trío; los demás dados solo cuentan si son unos o cincos: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le brelan compte ; les autres dés ne comptent que s’ils sont des as ou des cinq – %@"
          }
        }
      }
    },
    " Zwei Drillinge in einem Wurf zählen beide, z. B. 2-2-2-4-4-4 = 600.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Two triples in one roll both count, e.g. 2-2-2-4-4-4 = 600."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Dos tríos en una tirada cuentan ambos, p. ej., 2-2-2-4-4-4 = 600."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Deux brelans dans un même lancer comptent tous les deux, p. ex. 2-2-2-4-4-4 = 600."
          }
        }
      }
    },
    "Keins": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune"
          }
        }
      }
    },
    "Experiment: ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experiment: "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimento: "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expérience : "
          }
        }
      }
    },
    "Das Sprachmodell wird noch geladen. Versuch es gleich noch einmal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language model is still loading. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de lenguaje aún se está cargando. Inténtalo de nuevo enseguida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle de langage est encore en cours de chargement. Réessaie dans un instant."
          }
        }
      }
    },
    "Apple Intelligence ist aus. Du kannst es in den Einstellungen deines %@s einschalten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is off. You can turn it on in the settings of your %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivado. Puedes activarlo en los ajustes de tu %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivé. Tu peux l’activer dans les réglages de ton %@."
          }
        }
      }
    },
    "Auf diesem Gerät nicht verfügbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponible sur cet appareil."
          }
        }
      }
    },
    "Apple Intelligence beantwortet Fragen zu euren eingestellten Regeln – auf dem Gerät, ohne Internet. Punkte rechnet die App selbst nach. Antworten können trotzdem falsch sein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence answers questions about your chosen rules – on the device, without internet. The app calculates the points itself. Answers can still be wrong."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence responde preguntas sobre las reglas elegidas, en el dispositivo y sin internet. Los puntos los calcula la propia app. Aun así, las respuestas pueden ser incorrectas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence répond aux questions sur vos règles choisies – sur l’appareil, sans internet. L’app calcule elle-même les points. Les réponses peuvent quand même être fausses."
          }
        }
      }
    },
    "Weiterwürfeln mit %lld Würfel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep rolling with %lld die"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir tirando con %lld dado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer avec %lld dé"
          }
        }
      }
    },
    "Weiterwürfeln mit %lld Würfeln": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep rolling with %lld dice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir tirando con %lld dados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer avec %lld dés"
          }
        }
      }
    },
    "1 Würfel ist offen, die würfelst du neu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 die is open, you roll it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay 1 dado abierto, que vuelves a tirar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 dé est ouvert, tu le relances."
          }
        }
      }
    },
    "%lld Würfel sind offen, die würfelst du neu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dice are open, you roll them again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay %lld dados abiertos, que vuelves a tirar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dés sont ouverts, tu les relances."
          }
        }
      }
    },
    "Standard 10.000": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard 10,000"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estándar 10.000"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard 10 000"
          }
        }
      }
    },
    "Wer 3 Nieten in Folge hat (3 Züge ohne Punkte), bekommt %@ Strafpunkte abgezogen. Danach zählt die Serie neu. Der Punktestand kann dadurch auch unter 0 fallen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever has 3 busts in a row (3 turns without points) has %@ penalty points deducted. After that the streak starts over. The score can even drop below 0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien acumula 3 fallos seguidos (3 turnos sin puntos) pierde %@ puntos de penalización. Después la racha vuelve a empezar. La puntuación puede incluso bajar de 0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui qui fait 3 zéros d’affilée (3 tours sans point) se voit retirer %@ points de pénalité. Ensuite, la série repart à zéro. Le score peut même passer sous 0."
          }
        }
      }
    },
    "Wer 3 Nieten in Folge hat (3 Züge ohne Punkte), bekommt die Strafpunkte abgezogen. Danach zählt die Serie neu. Der Punktestand kann dadurch auch unter 0 fallen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever has 3 busts in a row (3 turns without points) has the penalty points deducted. After that the streak starts over. The score can even drop below 0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien acumula 3 fallos seguidos (3 turnos sin puntos) pierde los puntos de penalización. Después la racha vuelve a empezar. La puntuación puede incluso bajar de 0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui qui fait 3 zéros d’affilée (3 tours sans point) se voit retirer les points de pénalité. Ensuite, la série repart à zéro. Le score peut même passer sous 0."
          }
        }
      }
    },
    "Gleichstand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empate"
          }
        },
