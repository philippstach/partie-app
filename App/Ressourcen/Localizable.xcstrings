            "value": "Borrar lista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer la liste"
          }
        }
      }
    },
    "Beim Schwimmen: keine Karte tauschen und an den Nächsten weitergeben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Schwimmen: don’t swap a card and pass to the next player."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Schwimmen: no cambiar ninguna carta y pasar al siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À Schwimmen : ne pas échanger de carte et passer au suivant."
          }
        }
      }
    },
    "Alle Daten löschen": {
      "localizations": {
