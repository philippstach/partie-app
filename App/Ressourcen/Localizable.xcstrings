          }
        }
      }
    },
    "Merken": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merken"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémoriser"
          }
        }
      }
    },
    "Von schwach nach stark: Nichts, Paar, zwei Paare, Drilling, kleine und große Straße, Full House, Vierling, Fünfling.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von schwach nach stark: Nichts, Paar, zwei Paare, Drilling, kleine und große Straße, Full House, Vierling, Fünfling."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From weak to strong: nothing, pair, two pairs, three of a kind, small and large straight, full house, four and five of a kind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De menos a más: nada, pareja, doble pareja, trío, escalera pequeña y grande, full, póker y repóker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du plus faible au plus fort : rien, paire, deux paires, brelan, petite et grande suite, full, carré, cinq identiques."
          }
        }
      }
    },
    "Wirfst du eine 1, verfallen alle Punkte dieser Runde und der Nächste ist dran.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirfst du eine 1, verfallen alle Punkte dieser Runde und der Nächste ist dran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll a 1 and all points of this round are lost; the next player goes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sale un 1, pierdes todos los puntos de la ronda y juega el siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu fais un 1, tu perds tous les points de la manche et le suivant joue."
          }
        }
      }
    },
    "Runden gewinnen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Runden gewinnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win rounds"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganar rondas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagner des manches"
          }
        }
      }
    },
    "Unten an einer Leiter kletterst du nach oben, oben auf einer Wolkenrutsche rutschst du nach unten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten an einer Leiter kletterst du nach oben, oben auf einer Wolkenrutsche rutschst du nach unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the bottom of a ladder you climb up; at the top of a cloud slide you slide down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al pie de una escalera subes; en lo alto de un tobogán de nubes bajas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au pied d’une échelle tu montes ; en haut d’un toboggan de nuages tu descends."
          }
        }
      }
    },
    "Vier Gleiche": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier Gleiche"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four of a kind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro iguales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre identiques"
          }
        }
      }
    },
    "Alle Karten werden verteilt. Paare in der Hand legst du sofort ab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Karten werden verteilt. Paare in der Hand legst du sofort ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All cards are dealt. Pairs in your hand are laid down at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reparten todas las cartas. Las parejas de tu mano se sueltan enseguida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les cartes sont distribuées. Les paires de ta main sont posées aussitôt."
          }
        }
      }
    },
    "Schlagen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendre"
          }
        }
      }
    },
    "Sammle drei oder vier gleiche Zahlen oder Reihen von mindestens drei Karten einer Farbe.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle drei oder vier gleiche Zahlen oder Reihen von mindestens drei Karten einer Farbe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect three or four of a kind, or runs of at least three cards of one suit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reúne tres o cuatro iguales, o escaleras de al menos tres cartas de un palo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rassemble trois ou quatre cartes identiques ou des suites d’au moins trois cartes d’une couleur."
          }
        }
      }
    },
    "Zieh nicht die dritte Seite eines Kästchens, sonst schenkst du es dem Gegner. Wer am Ende mehr Kästchen hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh nicht die dritte Seite eines Kästchens, sonst schenkst du es dem Gegner. Wer am Ende mehr Kästchen hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid drawing the third side of a box or you give it away. Most boxes at the end wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No traces el tercer lado de un cuadro o se lo regalas al rival. Gana quien tenga más cuadros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne trace pas le troisième côté d’une case, sinon tu l’offres à l’adversaire. Le plus de cases gagne."
          }
        }
      }
    },
    "Bei einer Sechs darfst du nochmal würfeln, dreimal hintereinander heißt aussetzen. Wer zuerst die 100 erreicht, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei einer Sechs darfst du nochmal würfeln, dreimal hintereinander heißt aussetzen. Wer zuerst die 100 erreicht, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A six lets you roll again, three in a row means you skip. The first to reach 100 wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un seis repites; tres seguidos significa perder el turno. Gana quien llegue primero a 100."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un six te fait rejouer, trois de suite te font passer. Le premier à 100 gagne."
          }
        }
      }
    },
    "Der Stern ist ein Joker. Genommene Würfel sind für die anderen weg. Gewertet werden vollständige Farben und Spalten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stern ist ein Joker. Genommene Würfel sind für die anderen weg. Gewertet werden vollständige Farben und Spalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The star is a wild. Dice you take are gone for the others. Completed colours and columns score."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La estrella es comodín. Los dados tomados ya no están para los demás. Puntúan colores y columnas completas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’étoile est un joker. Les dés pris ne sont plus disponibles. Les couleurs et colonnes complètes rapportent."
          }
        }
      }
    },
    "Kannst du nicht anlegen, passt du. Wer zuerst keine Karten mehr hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kannst du nicht anlegen, passt du. Wer zuerst keine Karten mehr hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you cannot build, you pass. The first player with no cards wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no puedes colocar, pasas. Gana quien se quede sin cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu ne peux pas compléter, tu passes. Le premier sans cartes gagne."
          }
        }
      }
    },
    "Der Fuchs springt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fuchs springt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fox jumps"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El zorro salta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le renard saute"
          }
        }
      }
    },
    "Lang (5 Samen, Ziel 31)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lang (5 Samen, Ziel 31)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long (5 seeds, goal 31)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Largo (5 semillas, meta 31)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Long (5 graines, but 31)"
          }
        }
      }
    },
    "Auch aus Mühlen schlagen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch aus Mühlen schlagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture from mills too"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturar también de molinos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendre aussi dans les moulins"
          }
        }
      }
    },
    "Reihum legt jeder seine oberste Karte offen in die Mitte.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reihum legt jeder seine oberste Karte offen in die Mitte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In turn, everyone lays their top card face up in the middle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por turnos, cada uno coloca su carta superior boca arriba en el centro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À tour de rôle, chacun pose sa carte du dessus face visible au milieu."
          }
        }
      }
    },
    "Bringe alle zehn Steine in die gegenüberliegende Ecke. Wer zuerst dort ist, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringe alle zehn Steine in die gegenüberliegende Ecke. Wer zuerst dort ist, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring all ten pieces to the opposite corner. The first to get there wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva las diez fichas a la esquina opuesta. Gana quien llegue primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amène les dix pions dans le coin opposé. Le premier arrivé gagne."
          }
        }
      }
    },
    "Stich spielen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stich spielen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playing a trick"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jugar una baza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouer un pli"
          }
        }
      }
    },
    "Gänse dürfen auch schräg ziehen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gänse dürfen auch schräg ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Geese may also move diagonally"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ocas también pueden moverse en diagonal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les oies peuvent aussi avancer en diagonale"
          }
        }
      }
    },
    "Mit einer Sechs raus": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einer Sechs raus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Out with a six"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir con un seis"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortir avec un six"
          }
        }
      }
    },
    "Alle Figuren starten im Haus. Würfelst du eine Sechs, setzt du eine Figur aufs Startfeld. Ohne Sechs hast du drei Versuche.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Figuren starten im Haus. Würfelst du eine Sechs, setzt du eine Figur aufs Startfeld. Ohne Sechs hast du drei Versuche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All pieces start at home. Roll a six to put one on the start square. Without a six you get three tries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las fichas empiezan en casa. Con un seis sacas una a la casilla de salida. Sin seis tienes tres intentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les pions commencent à la maison. Avec un six, tu en poses un sur la case de départ. Sans six, tu as trois essais."
          }
        }
      }
    },
    "Ziehen und rauswerfen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen und rauswerfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move and send home"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover y echar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancer et renvoyer"
          }
        }
      }
    },
    "Du ziehst eine Figur um die gewürfelte Zahl. Landest du auf einer fremden Figur, muss sie zurück ins Haus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ziehst eine Figur um die gewürfelte Zahl. Landest du auf einer fremden Figur, muss sie zurück ins Haus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move a piece by the number rolled. If you land on an opponent’s piece, it goes back home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueves una ficha según el número. Si caes sobre una rival, vuelve a casa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu avances un pion du nombre obtenu. Si tu tombes sur un pion adverse, il retourne à la maison."
          }
        }
      }
    },
    "Alle ins Ziel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle ins Ziel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All into the goal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas a la meta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous au but"
          }
        }
      }
    },
    "Bei einer Sechs würfelst du noch einmal. Wer zuerst alle Figuren in die Zielfelder bringt, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei einer Sechs würfelst du noch einmal. Wer zuerst alle Figuren in die Zielfelder bringt, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A six lets you roll again. The first to bring all pieces into the goal squares wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un seis tiras otra vez. Gana quien lleve primero todas sus fichas a la meta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un six te fait rejouer. Le premier à amener tous ses pions sur les cases d’arrivée gagne."
          }
        }
      }
    },
    "Zuerst eine 6 (Schiff), dann eine 5 (Kapitän), dann eine 4 (Mannschaft). Sie werden automatisch festgelegt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First a 6 (ship), then a 5 (captain), then a 4 (crew). They are locked in automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero un 6 (barco), luego un 5 (capitán), luego un 4 (tripulación). Se fijan automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’abord un 6 (navire), puis un 5 (capitaine), puis un 4 (équipage). Ils sont verrouillés automatiquement."
          }
        }
      }
    },
    "Wer in einer Runde die meiste Fracht hat, bekommt einen Punkt. Du darfst nach jedem Wurf mit Fertig aufhören.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever has the most cargo in a round gets a point. You may stop after any roll with Done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien tenga más carga en una ronda gana un punto. Puedes parar tras cualquier tirada con Listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui a le plus de cargaison dans une manche gagne un point. Tu peux t’arrêter après chaque lancer avec Terminé."
          }
        }
      }
    },
    "Würfle und ziehe so viele Felder, wie der Würfel zeigt. Bei einer 6 darfst du nochmal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll and move as many squares as the die shows. On a 6 you roll again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira el dado y avanza tantas casillas como indique. Con un 6 vuelves a tirar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance le dé et avance d’autant de cases. Sur un 6, tu rejoues."
          }
        }
      }
    },
    "Geht kein Zug mehr, zählen die offenen Zahlen als Punkte. Alle Zahlen zu bedeutet null Punkte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When no move is left, the open numbers count as points. All numbers closed means zero points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no queda ninguna jugada, los números abiertos suman puntos. Todos cerrados son cero puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand plus aucun coup n’est possible, les nombres ouverts comptent comme points. Tout fermé vaut zéro point."
          }
        }
      }
    },
    "Der Joker passt immer und wählt die neue Farbe. Wer zuerst keine Karten mehr hat, gewinnt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The joker always fits and picks the new colour. Whoever runs out of cards first wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comodín siempre se puede jugar y elige el nuevo color. Gana quien se quede primero sin cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le joker passe toujours et choisit la nouvelle couleur. Le premier sans cartes gagne."
          }
        }
      }
    },
    "Nicht zu früh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not too early"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No demasiado pronto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas trop tôt"
          }
        }
      }
    },
    "Wenige Punkte gewinnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fewest points win"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana quien tenga menos puntos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moins de points gagne"
          }
        }
      }
    },
    "Ziel: Feld 100": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goal: square 100"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta: casilla 100"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "But : case 100"
          }
        }
      }
    },
    "Zeigen beide dasselbe Bild, gehört dir das Paar und du darfst nochmal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If both show the same picture, the pair is yours and you go again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ambas muestran la misma imagen, la pareja es tuya y repites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les deux montrent la même image, la paire est à toi et tu rejoues."
          }
        }
      }
    },
    "Fracht zählt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo counts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta la carga"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La cargaison compte"
          }
        }
      }
    },
    "Karte, dann Stapel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card, then pile"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carta y luego pila"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Carte, puis pile"
          }
        }
      }
    },
    "Unten an einer Leiter kletterst du hinauf, oben auf einer Wolkenrutsche rutschst du hinunter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the bottom of a ladder you climb up, at the top of a cloud slide you slide down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al pie de una escalera subes; en lo alto de un tobogán de nubes bajas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au pied d’une échelle tu montes, en haut d’un toboggan de nuages tu descends."
          }
        }
      }
    },
    "Ablage beendet den Zug": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discarding ends your turn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar termina el turno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défausser termine le tour"
          }
        }
      }
    },
    "Sonst werden sie wieder umgedreht. Merke dir, wo was liegt – wer die meisten Paare hat, gewinnt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Otherwise they are turned back over. Remember where everything is – whoever has the most pairs wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, se vuelven a girar. Recuerda dónde está cada una: gana quien tenga más parejas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon elles sont retournées. Retiens où est quoi : celui qui a le plus de paires gagne."
          }
        }
      }
    },
    "Sprung lässt den Nächsten aussetzen, Wende kehrt die Richtung um, Zwei ziehen gibt dem Nächsten zwei Karten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip makes the next player miss a turn, Reverse flips the direction, Draw Two gives the next player two cards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto hace que el siguiente pierda el turno, Cambio invierte el sentido, Roba dos da dos cartas al siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saut fait passer le tour du suivant, Inversion change le sens, Pioche deux donne deux cartes au suivant."
          }
        }
      }
    },
    "Würfle und sieh dir die Augensumme an.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll and look at the total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira los dados y mira la suma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance les dés et regarde la somme."
          }
        }
      }
    },
    "Wer zu Unrecht drückt, muss eine Karte abgeben. Wer am Ende alle Karten hat, gewinnt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press by mistake and you give up a card. Whoever ends with all the cards wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien pulse sin motivo cede una carta. Gana quien al final tenga todas las cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui appuie à tort perd une carte. Celui qui a toutes les cartes à la fin gagne."
          }
        }
      }
    },
    "Gut merken": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember well"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A recordar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien mémoriser"
          }
        }
      }
    },
    "Klappe offene Zahlen von 1 bis 9 zu, deren Summe genau der Würfelsumme entspricht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close open numbers from 1 to 9 whose sum exactly matches the dice total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra números abiertos del 1 al 9 cuya suma coincida exactamente con la de los dados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rabats des nombres ouverts de 1 à 9 dont la somme égale exactement celle des dés."
          }
        }
      }
    },
    "Liegen zwei gleiche Bilder direkt übereinander, drücke so schnell du kannst auf Schnapp!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If two identical pictures lie right on top of each other, hit Snap! as fast as you can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si dos imágenes iguales quedan una sobre otra, pulsa ¡Ya! lo más rápido que puedas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si deux images identiques se superposent, appuie sur Tape ! le plus vite possible."
          }
        }
      }
    },
    "Auf einen leeren Stapel kommt die 1, dann die 2 und so weiter bis zur 10. Der Stern ersetzt jede Zahl.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An empty pile takes the 1, then the 2, and so on up to the 10. The star replaces any number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una pila vacía va el 1, luego el 2 y así hasta el 10. La estrella sustituye cualquier número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pile vide reçoit le 1, puis le 2, et ainsi de suite jusqu’au 10. L’étoile remplace n’importe quel nombre."
          }
        }
      }
    },
    "Tippe zuerst eine Karte an, dann den Stapel, auf den sie soll. Quellen: Vorrat, Hand oder Ablagen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a card first, then the pile it should go on. Sources: stock, hand or discard piles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca primero una carta y luego la pila donde debe ir. Origen: reserva, mano o descartes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche d’abord une carte, puis la pile visée. Sources : réserve, main ou défausses."
          }
        }
      }
    },
    "Passende Karte legen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a matching card"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega una carta que combine"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poser une carte assortie"
          }
        }
      }
    },
    "Reihenfolge würfeln": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll in order"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirar en orden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer dans l’ordre"
          }
        }
      }
    },
    "Zwei Karten aufdecken": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flip two cards"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubrir dos cartas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retourner deux cartes"
          }
        }
      }
    },
    "Dein Zug endet, wenn du eine Handkarte auf eine deiner drei Ablagen legst. Wer seinen Vorrat zuerst leert, gewinnt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your turn ends when you put a hand card on one of your three discard piles. Whoever empties their stock first wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu turno termina cuando pones una carta de la mano en uno de tus tres descartes. Gana quien vacíe antes su reserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton tour se termine quand tu poses une carte de ta main sur l’une de tes trois défausses. Le premier à vider sa réserve gagne."
          }
        }
      }
    },
    "Zahlen zuklappen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close numbers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar números"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rabattre les nombres"
          }
        }
      }
    },
    "Tippe nacheinander zwei verdeckte Karten an.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap two face-down cards one after the other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos cartas boca abajo, una tras otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche deux cartes face cachée l’une après l’autre."
          }
        }
      }
    },
    "Mit Besatzung zählen die übrigen zwei Würfel als Fracht, höchstens 12. Ohne Besatzung ist sie null.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a full crew the other two dice count as cargo, at most 12. Without a crew it is zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con tripulación completa, los otros dos dados cuentan como carga, máximo 12. Sin tripulación es cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un équipage complet, les deux autres dés comptent comme cargaison, 12 au maximum. Sans équipage, elle vaut zéro."
          }
        }
      }
    },
    "Wer als Erster das Feld 100 erreicht, gewinnt. Dreimal hintereinander eine 6 heißt aussetzen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first to reach square 100 wins. Three 6s in a row means you miss a turn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana quien llegue primero a la casilla 100. Tres 6 seguidos significan perder el turno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier à atteindre la case 100 gagne. Trois 6 de suite, et tu passes ton tour."
          }
        }
      }
    },
    "Lege eine Karte mit derselben Farbe oder Zahl wie die oberste. Passt nichts, ziehst du eine.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a card with the same colour or number as the top card. If nothing fits, draw one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega una carta del mismo color o número que la de arriba. Si ninguna encaja, roba una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose une carte de la même couleur ou du même nombre que celle du dessus. Si rien ne convient, pioche."
          }
        }
      }
    },
    "Mit „Sichern“ schreibst du die Runde gut. Wer zuerst das Ziel erreicht (im Mehr-Menü: 50, 100 oder 150 Punkte), gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Sichern“ schreibst du die Runde gut. Wer zuerst das Ziel erreicht (im Mehr-Menü: 50, 100 oder 150 Punkte), gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Bank” adds the round to your score. The first to reach the goal (More menu: 50, 100 or 150 points) wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con «Asegurar» sumas la ronda. Gana quien llegue primero a la meta (menú Más: 50, 100 o 150 puntos)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec « Sécuriser » tu ajoutes la manche. Le premier à atteindre le but (menu Plus : 50, 100 ou 150 points) gagne."
          }
        }
      }
    },
    "Standard: 100 Punkte": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard: 100 Punkte"
          }
