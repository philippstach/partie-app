            "value": "Petit (8 × 8)"
          }
        }
      }
    },
    "Du tauschst eine Karte oder alle drei mit der Mitte, schiebst oder klopfst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tauschst eine Karte oder alle drei mit der Mitte, schiebst oder klopfst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap one card or all three with the middle, pass or knock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambias una carta o las tres con el centro, pasas o golpeas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu échanges une ou trois cartes avec le centre, passes ou frappes."
          }
        }
      }
    },
    "Kette bilden": {
      "localizations": {
        "de": {
