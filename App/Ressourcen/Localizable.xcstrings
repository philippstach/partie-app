    "Regeln lassen sich in %@ noch nicht ansagen. Alles andere bleibt, wie es eingestellt ist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln lassen sich in %@ noch nicht ansagen. Alles andere bleibt, wie es eingestellt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules can’t be set by voice in %@ yet. Everything else stays as it is set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas de %@ aún no se pueden decir. Todo lo demás se queda como está ajustado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles de %@ ne peuvent pas encore être dites. Tout le reste reste comme réglé."
          }
        }
      }
    },
    "Apple Intelligence lädt noch. Dann kannst du die Regeln ansagen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence lädt noch. Dann kannst du die Regeln ansagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is still loading. Then you can say the rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence aún se está cargando. Después podrás decir las reglas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est encore en cours de chargement. Vous pourrez ensuite dire les règles."
          }
        }
      }
    },
