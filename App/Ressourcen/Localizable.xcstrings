    },
    "Die Frage steht im Kästchen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clue is in the box"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pista está en la casilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La définition est dans la case"
          }
        }
      }
    },
    "Der Pfeil zeigt, wohin das Wort läuft. Trag es Buchstabe für Buchstabe ein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The arrow shows where the word runs. Enter it letter by letter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La flecha indica hacia dónde va la palabra. Escríbela letra a letra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La flèche montre où va le mot. Écris-le lettre par lettre."
          }
        }
      }
    },
    "Tippe ein Feld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a square"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una casilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche une case"
          }
        }
      }
    },
    "Tippst du dasselbe Feld nochmal, wechselt die Richtung: waagerecht oder senkrecht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the same square again to switch direction: across or down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tocas la misma casilla otra vez, cambia la dirección: horizontal o vertical."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu touches de nouveau la même case, la direction change : horizontale ou verticale."
          }
        }
      }
    },
    "Hilfen ohne Strafe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hints without penalty"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayudas sin penalización"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aides sans pénalité"
          }
        }
      }
    },
    "Du kannst jederzeit Buchstaben aufdecken, prüfen oder mit Bleistift raten. Es gibt keinen Zeitdruck.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can reveal letters, check, or guess in pencil at any time. There is no time pressure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes revelar letras, comprobar o probar con lápiz en cualquier momento. No hay presión de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux à tout moment révéler des lettres, vérifier ou essayer au crayon. Il n’y a pas de pression de temps."
          }
        }
      }
    },
    "Prüfen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier"
          }
        }
      }
    },
    "Fragen, die dir unpassend vorkamen, merkt die App nur auf diesem Gerät.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clues that seemed off are only remembered on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app solo recuerda en este dispositivo las pistas que te parecieron raras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app ne retient que sur cet appareil les définitions qui t’ont paru bizarres."
          }
        }
      }
    },
    "Noch keine Fragen gemerkt. Im Spiel findest du „Frage merken“ im Menü oben rechts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No clues flagged yet. In the game, find “Flag clue” in the menu at the top right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no has marcado ninguna pista. En el juego encontrarás «Marcar pista» en el menú de arriba a la derecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune définition signalée pour l’instant. Dans le jeu, tu trouves « Signaler la définition » dans le menu en haut à droite."
          }
        }
      }
    },
