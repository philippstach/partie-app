    "Dame werden": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dame werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becoming a king"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coronar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devenir dame"
          }
        }
      }
    },
    "Du darfst lügen. Der Nächste kann „Gelogen!“ rufen, dann werden die Karten aufgedeckt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du darfst lügen. Der Nächste kann „Gelogen!“ rufen, dann werden die Karten aufgedeckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may lie. The next player can call “Liar!” and the cards are revealed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes mentir. El siguiente puede gritar «¡Mentira!» y se descubren las cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux mentir. Le suivant peut crier « Menteur ! » et les cartes sont retournées."
          }
        }
      }
    },
    "Bedrohst du den König so, dass er nicht entkommen kann, setzt du matt und gewinnst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedrohst du den König so, dass er nicht entkommen kann, setzt du matt und gewinnst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Threaten the king so it cannot escape and you checkmate and win."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si amenazas al rey de modo que no pueda escapar, das jaque mate y ganas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu menaces le roi sans qu’il puisse s’échapper, tu fais mat et tu gagnes."
          }
        }
      }
    },
    "Zwei aufdecken": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei aufdecken"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flip two"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubrir dos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retourner deux"
          }
        }
      }
    },
    "Von 1 bis 10 bauen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von 1 bis 10 bauen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build from 1 to 10"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construir del 1 al 10"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construire de 1 à 10"
          }
        }
      }
    },
    "Spiele eine Handkarte und sammle Tischkarten ein, sodass die Summe genau 15 ergibt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele eine Handkarte und sammle Tischkarten ein, sodass die Summe genau 15 ergibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a hand card and collect table cards so that the total is exactly 15."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega una carta y recoge cartas de la mesa de modo que sumen exactamente 15."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue une carte de ta main et ramasse des cartes de la table pour faire exactement 15."
          }
        }
      }
    },
    "Wer zuerst alle Schiffe des Gegners versenkt, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer zuerst alle Schiffe des Gegners versenkt, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first to sink all the opponent’s ships wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana quien hunda primero todos los barcos del rival."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier à couler tous les navires adverses gagne."
          }
        }
      }
    },
    "Haufen nehmen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haufen nehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking the pile"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevarse el montón"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendre la pile"
          }
        }
      }
    },
    "Springe über einen gegnerischen Stein und nimm ihn vom Brett. Je nach Regelart ist Schlagen Pflicht.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Springe über einen gegnerischen Stein und nimm ihn vom Brett. Je nach Regelart ist Schlagen Pflicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump over an opponent’s piece and remove it. Depending on the rule set, capturing is compulsory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta sobre una ficha rival y retírala. Según la variante, capturar es obligatorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saute par-dessus un pion adverse et retire-le. Selon la variante, la prise est obligatoire."
          }
        }
      }
    },
    "Kreuze bis zu so viele zusammenhängende Felder dieser Farbe an, wie der Zahlwürfel zeigt. Das erste Kreuz liegt in der mittleren Spalte.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreuze bis zu so viele zusammenhängende Felder dieser Farbe an, wie der Zahlwürfel zeigt. Das erste Kreuz liegt in der mittleren Spalte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross up to that many connected squares of that colour. The first cross goes in the middle column."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tacha hasta tantas casillas conectadas de ese color como marque el dado. La primera cruz va en la columna central."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coche jusqu’à autant de cases connectées de cette couleur que le dé. La première croix va dans la colonne du milieu."
          }
        }
      }
    },
    "Der Fuchs zieht in vier Richtungen oder springt über eine Gans und frisst sie.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fuchs zieht in vier Richtungen oder springt über eine Gans und frisst sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fox moves in four directions or jumps over a goose and eats it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El zorro se mueve en cuatro direcciones o salta sobre una oca y se la come."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le renard se déplace dans quatre directions ou saute par-dessus une oie et la mange."
          }
        }
      }
    },
    "Ihr zieht abwechselnd eine Linie zwischen zwei benachbarten Punkten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr zieht abwechselnd eine Linie zwischen zwei benachbarten Punkten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take turns drawing a line between two neighbouring dots."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por turnos trazáis una línea entre dos puntos vecinos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À tour de rôle, tracez un trait entre deux points voisins."
          }
        }
      }
    },
    "Du wirfst vier Münzen. Jede Seite mit Punkt zählt einen Schritt, also null bis vier.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirfst vier Münzen. Jede Seite mit Punkt zählt einen Schritt, also null bis vier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You throw four coins. Each side with a dot counts one step, so zero to four."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanzas cuatro monedas. Cada lado con punto cuenta un paso, de cero a cuatro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu lances quatre pièces. Chaque face avec un point vaut un pas, de zéro à quatre."
          }
        }
      }
    },
    "Klein (8 × 8)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein (8 × 8)"
          }
        },
        "en": {
