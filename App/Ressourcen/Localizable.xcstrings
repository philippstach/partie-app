        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déchiffre le code couleur de l’adversaire en peu d’essais."
          }
        }
      }
    },
    "Verbinde auf dem Sechseckbrett deine beiden Seiten vor dem Gegner.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your two sides on the hexagonal board before your opponent does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tus dos lados en el tablero hexagonal antes que tu rival."
