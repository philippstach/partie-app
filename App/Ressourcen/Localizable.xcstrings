    },
    "Partie kann dich an die Tagesaufgabe, angefangene Partien und Game-Center-Anfragen von Freunden erinnern. Das ist freiwillig.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie kann dich an die Tagesaufgabe, angefangene Partien und Game-Center-Anfragen von Freunden erinnern. Das ist freiwillig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie can remind you about the daily task, games in progress and Game Center requests from friends. This is optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie puede recordarte la tarea del día, las partidas empezadas y las solicitudes de amigos de Game Center. Es opcional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie peut te rappeler la tâche du jour, les parties en cours et les demandes d’amis Game Center. C’est facultatif."
          }
        }
      }
    },
    "Game Center?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Game Center?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ?"
          }
        }
      }
    },
    "Mit Game Center kannst du deine besten Zeiten und Punkte mit Freunden vergleichen und Erfolge sammeln. Das ist freiwillig und standardmäßig aus. Du kannst es jederzeit in den Einstellungen ändern.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Game Center kannst du deine besten Zeiten und Punkte mit Freunden vergleichen und Erfolge sammeln. Das ist freiwillig und standardmäßig aus. Du kannst es jederzeit in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Game Center you can compare your best times and scores with friends and collect achievements. It is optional and off by default. You can change it any time in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Game Center puedes comparar tus mejores tiempos y puntos con tus amigos y conseguir logros. Es opcional y está desactivado por defecto. Puedes cambiarlo en cualquier momento en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Game Center, compare tes meilleurs temps et scores avec tes amis et débloque des succès. C’est facultatif et désactivé par défaut. Tu peux le modifier à tout moment dans les Réglages."
          }
        }
      }
    },
    "Game Center eingeschaltet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center eingeschaltet"
