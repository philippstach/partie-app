    "Erlaube Partie in den iOS-Einstellungen den Zugriff auf die Kamera. Die Bilder bleiben auf deinem Gerät.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Partie in den iOS-Einstellungen den Zugriff auf die Kamera. Die Bilder bleiben auf deinem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Partie to use the camera in iOS Settings. The images stay on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Partie use la cámara en los ajustes de iOS. Las imágenes permanecen en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
