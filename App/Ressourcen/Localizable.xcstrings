          }
        }
      }
    },
    "keiner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "none"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ninguno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "aucun"
          }
        }
      }
    },
    "Ziffer %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Digit %1$lld"
          }
        },
        "es": {
