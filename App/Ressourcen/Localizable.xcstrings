            "value": "Les scores actuels seront perdus."
          }
        }
      }
    },
    "%lld Spiele für Familie, Freunde und dich allein. Karten, Würfel, Rätsel und mehr, alles in einer App. Wischen, um loszulegen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Spiele für Familie, Freunde und dich allein. Karten, Würfel, Rätsel und mehr, alles in einer App. Wischen, um loszulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@v1@ for family, friends and just you. Cards, dice, puzzles and more, all in one app. Swipe to get started."
          },
          "substitutions": {
            "v1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg game"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg games"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld juegos para la familia, los amigos y para ti solo. Cartas, dados, puzles y más, todo en una app. Desliza para empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld jeux pour la famille, les amis et toi tout seul. Cartes, dés, énigmes et plus encore, tout dans une seule app. Fais glisser pour commencer."
          }
        }
      }
    },
