    "Du wirfst bis zu dreimal. Die meiste Fracht der Runde gibt einen Punkt, nach fünf Runden gewinnt der meiste.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirfst bis zu dreimal. Die meiste Fracht der Runde gibt einen Punkt, nach fünf Runden gewinnt der meiste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to three throws. The most cargo in a round scores a point; most points after five rounds wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta tres tiradas. La mayor carga de la ronda da un punto; tras cinco rondas gana quien más tenga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à trois lancers. La plus grosse cargaison de la manche donne un point ; le plus de points après cinq manches gagne."
          }
        }
      }
    },
    "Summe 15": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Summe 15"
          }
        },
        "en": {
