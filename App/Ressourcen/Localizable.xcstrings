    "Partie ist Open Source: Den Quelltext kann jede und jeder lesen, prüfen und verbessern.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie ist Open Source: Den Quelltext kann jede und jeder lesen, prüfen und verbessern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie is open source: anyone can read, check and improve the source code."
          }
        },
        "es": {
