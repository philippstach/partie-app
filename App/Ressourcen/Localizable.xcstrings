          "stringUnit": {
            "state": "translated",
            "value": "Dos botones: seguir tirando con %lld dados o parar con 150"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux boutons : continuer avec %lld dés ou s’arrêter à 150"
          }
        }
      }
    },
    "Drei Punkte und die Regel-Karte": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three dots and the rules card"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres puntos y la tarjeta de reglas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois points et la carte des règles"
          }
        }
      }
    },
    "Beim Truco: Wette auf die höchste Punktsumme zweier Karten gleicher Farbe in der Hand.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Truco: a bet on the highest point total of two cards of the same suit in your hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el Truco: una apuesta sobre la mayor suma de puntos de dos cartas del mismo palo en la mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au Truco : un pari sur le total de points le plus élevé de deux cartes de même couleur en main."
          }
        }
      }
    },
    "%lld beendete Spiele. Mitspielende werden am Namen erkannt. Die Statistik bleibt auch, wenn beendete Spiele nicht behalten werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld finished games. Fellow players are recognised by name. The statistics are kept even if finished games are not kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld partidas terminadas. Los demás jugadores se reconocen por el nombre. Las estadísticas se conservan aunque no se guarden las partidas terminadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld parties terminées. Les autres joueurs sont reconnus par leur nom. Les statistiques sont conservées même si les parties terminées ne le sont pas."
          }
        }
      }
    },
    "Apple Intelligence": {
      "localizations": {
