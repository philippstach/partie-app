            "value": "Seguir o parar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer ou s’arrêter"
          }
        }
      }
    },
    "Jede Zahl nur einmal": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zahl nur einmal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every number only once"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada número una vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque chiffre une seule fois"
          }
        }
      }
    },
    "Ihr würfelt reihum mit drei Würfeln, bis zu dreimal. Einsen kannst du herauslegen und nur die übrigen neu werfen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr würfelt reihum mit drei Würfeln, bis zu dreimal. Einsen kannst du herauslegen und nur die übrigen neu werfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You roll in turn with three dice, up to three times. You can set aside ones and re-roll only the rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiráis por turnos con tres dados, hasta tres veces. Puedes apartar los unos y volver a tirar solo el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous lancez à tour de rôle trois dés, jusqu’à trois fois. Tu peux mettre les as de côté et relancer seulement les autres."
          }
        }
      }
    },
    "Die Zahl zählt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahl zählt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number counts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número cuenta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiffre compte"
          }
        }
      }
    },
    "Alle Lichter aus": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Lichter aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All lights off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las luces apagadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les lumières éteintes"
          }
        }
      }
    },
    "Stapel ziehen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stapel ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw from the stock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Robar del mazo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piocher"
          }
        }
      }
    },
    "Der Pfeil zeigt den Weg": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pfeil zeigt den Weg"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The arrow shows the way"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La flecha marca el camino"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La flèche montre le chemin"
          }
        }
      }
    },
    "Feld wählen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feld wählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a box"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir casilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir une case"
          }
        }
      }
    },
    "Die Mauer rückt langsam nach unten; erreicht sie den Schläger, ist das Spiel aus. Du hast drei Leben.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mauer rückt langsam nach unten; erreicht sie den Schläger, ist das Spiel aus. Du hast drei Leben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wall slowly moves down; if it reaches the paddle the game is over. You have three lives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El muro baja despacio; si llega a la pala, el juego termina. Tienes tres vidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mur descend lentement ; s’il atteint la raquette, la partie est finie. Tu as trois vies."
          }
        }
      }
    },
    "Tippe ein Feld an und schreibe den Buchstaben. Tippst du dasselbe Feld nochmal, wechselt die Richtung.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe ein Feld an und schreibe den Buchstaben. Tippst du dasselbe Feld nochmal, wechselt die Richtung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a square and type the letter. Tap the same square again to switch direction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una casilla y escribe la letra. Si vuelves a tocar la misma, cambia la dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche une case et saisis la lettre. Touche la même case encore une fois pour changer de sens."
          }
        }
      }
    },
    "Nie groß auf klein": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie groß auf klein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never big on small"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca grande sobre pequeño"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamais grand sur petit"
          }
        }
      }
    },
    "Pro Runde wird ein Buchstabe gezogen. Trage zu jeder Kategorie ein Wort ein, das mit diesem Buchstaben beginnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Runde wird ein Buchstabe gezogen. Trage zu jeder Kategorie ein Wort ein, das mit diesem Buchstaben beginnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One letter is drawn each round. Enter a word for each category that starts with that letter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cada ronda se saca una letra. Escribe una palabra por categoría que empiece con esa letra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À chaque manche, une lettre est tirée. Écris pour chaque catégorie un mot qui commence par cette lettre."
          }
        }
      }
    },
    "Schieben und drehen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schieben und drehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move and rotate"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover y girar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer et tourner"
          }
        }
      }
    },
    "Wische in eine Richtung: Dein Läufer geht geradeaus und hält erst vor einer Wand, an einer Abzweigung oder am Ausgang an.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische in eine Richtung: Dein Läufer geht geradeaus und hält erst vor einer Wand, an einer Abzweigung oder am Ausgang an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe in a direction: your runner goes straight and only stops at a wall, a junction or the exit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza en una dirección: tu corredor avanza recto y solo se detiene ante una pared, una bifurcación o la salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse dans une direction : ton coureur va tout droit et ne s’arrête qu’à un mur, une bifurcation ou la sortie."
          }
        }
      }
    },
    "Du würfelst mit fünf Würfeln und legst nach jedem Wurf mindestens einen Würfel mit Punkten raus: eine 1 zählt 100, eine 5 zählt 50.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du würfelst mit fünf Würfeln und legst nach jedem Wurf mindestens einen Würfel mit Punkten raus: eine 1 zählt 100, eine 5 zählt 50."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You roll five dice and after every roll set aside at least one scoring die: a 1 is worth 100, a 5 is worth 50."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiras cinco dados y tras cada tirada apartas al menos un dado que puntúe: un 1 vale 100, un 5 vale 50."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu lances cinq dés et mets de côté après chaque lancer au moins un dé qui marque : un 1 vaut 100, un 5 vaut 50."
          }
        }
      }
    },
    "Fülle das Quadrat mit den Zahlen von 1 bis zur Kantenlänge: in jeder Zeile und Spalte jede Zahl genau einmal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fülle das Quadrat mit den Zahlen von 1 bis zur Kantenlänge: in jeder Zeile und Spalte jede Zahl genau einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill the square with the numbers from 1 up to its side length: every number exactly once in each row and column."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena el cuadrado con los números del 1 hasta la longitud del lado: cada número exactamente una vez en cada fila y columna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplis le carré avec les nombres de 1 à la longueur du côté : chaque nombre exactement une fois par ligne et par colonne."
          }
        }
      }
    },
    "Die Mauer rückt vor": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mauer rückt vor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wall advances"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El muro avanza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mur avance"
          }
        }
      }
    },
    "Tipp legen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp legen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a guess"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar una propuesta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer une proposition"
          }
        }
      }
    },
    "Schalte „Notizen“ ein, um kleine Merkzahlen in ein Feld zu schreiben. Setzt du eine Zahl, verschwindet sie aus den Notizen der Nachbarn.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte „Notizen“ ein, um kleine Merkzahlen in ein Feld zu schreiben. Setzt du eine Zahl, verschwindet sie aus den Notizen der Nachbarn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Notes” to write small reminder numbers in a cell. When you place a number, it disappears from the notes of its neighbours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa «Notas» para escribir pequeños números de apoyo en una casilla. Al poner un número, desaparece de las notas de las vecinas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active « Notes » pour écrire de petits chiffres dans une case. Quand tu places un chiffre, il disparaît des notes des cases voisines."
          }
        }
      }
    },
    "Aus einer Reihe nehmen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus einer Reihe nehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take from one row"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coger de una fila"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendre dans une rangée"
          }
        }
      }
    },
    "Kante macht schräg": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kante macht schräg"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The edge makes it slant"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El borde la desvía"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bord la fait dévier"
          }
        }
      }
    },
    "Springen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Springen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumping"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saltar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauter"
          }
        }
      }
    },
    "Wer zuerst vier eigene Steine waagerecht, senkrecht oder diagonal in einer Reihe hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer zuerst vier eigene Steine waagerecht, senkrecht oder diagonal in einer Reihe hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first to get four of their own discs in a row – horizontally, vertically or diagonally – wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana quien consiga primero cuatro fichas propias en línea: horizontal, vertical o diagonal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier à aligner quatre de ses jetons – à l’horizontale, à la verticale ou en diagonale – gagne."
          }
        }
      }
    },
    "Fünferteile fallen in ein Feld. Ist eine Reihe lückenlos gefüllt, löst sie sich auf und bringt Punkte – mehrere Reihen zugleich bringen deutlich mehr.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünferteile fallen in ein Feld. Ist eine Reihe lückenlos gefüllt, löst sie sich auf und bringt Punkte – mehrere Reihen zugleich bringen deutlich mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five-square pieces fall into a field. A completely filled row disappears and scores points – several rows at once score much more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Piezas de cinco cuadros caen en un campo. Una fila completamente llena desaparece y da puntos; varias filas a la vez dan muchos más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des pièces de cinq carrés tombent dans un champ. Une ligne entièrement remplie disparaît et rapporte des points – plusieurs lignes à la fois en rapportent bien plus."
          }
        }
      }
    },
    "„Aufdecken“ und „Prüfen“ helfen dir weiter. Wer ganz ohne Hilfe löst, bekommt einen Stern.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aufdecken“ und „Prüfen“ helfen dir weiter. Wer ganz ohne Hilfe löst, bekommt einen Stern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Reveal” and “Check” help you along. Solve without any help and you earn a star."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Descubrir» y «Comprobar» te ayudan. Quien resuelve sin ninguna ayuda recibe una estrella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Révéler » et « Vérifier » t’aident. Qui résout sans aucune aide gagne une étoile."
          }
        }
      }
    },
    "Ziehe den Finger, um den Schläger zu bewegen – er folgt dir, so schnell er kann. Schlage den Ball zurück und lass ihn beim Gegner durch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe den Finger, um den Schläger zu bewegen – er folgt dir, so schnell er kann. Schlage den Ball zurück und lass ihn beim Gegner durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag your finger to move the paddle – it follows you as fast as it can. Hit the ball back and get it past your opponent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el dedo para mover la pala; te sigue todo lo rápido que puede. Devuelve la pelota y haz que pase al rival."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser le doigt pour bouger la raquette – elle te suit aussi vite qu’elle peut. Renvoie la balle et fais-la passer chez l’adversaire."
          }
        }
      }
    },
    "Nach 13 Runden gewinnt, wer die meisten Punkte hat. Ab 63 Punkten im oberen Block gibt es 35 Punkte Bonus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach 13 Runden gewinnt, wer die meisten Punkte hat. Ab 63 Punkten im oberen Block gibt es 35 Punkte Bonus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After 13 rounds the player with the most points wins. With 63 points in the upper section you get a 35-point bonus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras 13 rondas gana quien tenga más puntos. Con 63 puntos en el bloque superior hay 35 puntos de bonificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après 13 tours, celui qui a le plus de points gagne. À partir de 63 points dans la partie haute, tu reçois un bonus de 35 points."
          }
        }
      }
    },
    "Weiße Wolken tragen immer, blaue wandern hin und her, graue brechen nach dem Sprung weg. Die gelbe Feder schleudert dich besonders hoch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiße Wolken tragen immer, blaue wandern hin und her, graue brechen nach dem Sprung weg. Die gelbe Feder schleudert dich besonders hoch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "White clouds always hold, blue ones drift back and forth, grey ones break away after the jump. The yellow feather launches you extra high."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las nubes blancas siempre sostienen, las azules van de un lado a otro, las grises se rompen tras el salto. La pluma amarilla te lanza muy alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nuages blancs portent toujours, les bleus vont et viennent, les gris se brisent après le saut. La plume jaune te propulse très haut."
          }
        }
      }
    },
    "Im Modus „Klassisch“ gewinnt, wer das letzte Hölzchen nimmt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Modus „Klassisch“ gewinnt, wer das letzte Hölzchen nimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In “Classic” mode, whoever takes the last stick wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo «Clásico» gana quien coja el último palillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode « Classique », celui qui prend la dernière allumette gagne."
          }
        }
      }
    },
    "Nach jedem Zug erscheint eine neue 2 oder 4. Erreiche die 2048 – oder so viele Punkte wie möglich.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach jedem Zug erscheint eine neue 2 oder 4. Erreiche die 2048 – oder so viele Punkte wie möglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After every move a new 2 or 4 appears. Reach 2048 – or score as many points as you can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras cada movimiento aparece un 2 o un 4 nuevo. Llega al 2048 o consigue tantos puntos como puedas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après chaque coup, un nouveau 2 ou 4 apparaît. Atteins 2048 – ou marque autant de points que possible."
          }
        }
      }
    },
    "Kachel verschieben": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kachel verschieben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide a tile"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover una pieza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire glisser une tuile"
          }
        }
      }
    },
    "Tippe nacheinander zwei benachbarte Inseln an: einmal ergibt eine Brücke, zweimal eine doppelte, dreimal löscht sie.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe nacheinander zwei benachbarte Inseln an: einmal ergibt eine Brücke, zweimal eine doppelte, dreimal löscht sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap two neighbouring islands in a row: once makes a bridge, twice a double bridge, three times removes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos islas vecinas seguidas: una vez crea un puente, dos veces uno doble y tres veces lo borra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche deux îles voisines à la suite : une fois pour un pont, deux fois pour un pont double, trois fois pour l’effacer."
          }
        }
      }
    },
    "Funken liegen in Sackgassen und bringen 50 Punkte extra. Je kürzer dein Weg, desto mehr Bonus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funken liegen in Sackgassen und bringen 50 Punkte extra. Je kürzer dein Weg, desto mehr Bonus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparks lie in dead ends and give 50 extra points. The shorter your route, the bigger the bonus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las chispas están en callejones sin salida y dan 50 puntos extra. Cuanto más corto tu camino, mayor la bonificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étincelles se trouvent dans les impasses et rapportent 50 points de plus. Plus ton chemin est court, plus le bonus est grand."
          }
        }
      }
    },
    "Ein Tipp schaltet das Feld und seine vier Nachbarn um: an wird aus, aus wird an.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp schaltet das Feld und seine vier Nachbarn um: an wird aus, aus wird an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tap switches the square and its four neighbours: on becomes off, off becomes on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque cambia la casilla y sus cuatro vecinas: encendida pasa a apagada y al revés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toucher bascule la case et ses quatre voisines : allumé devient éteint et inversement."
          }
        }
      }
    },
    "Je weniger Züge, desto besser. Mit Tipp gelöste Rätsel zählen nicht für den Bestwert.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je weniger Züge, desto besser. Mit Tipp gelöste Rätsel zählen nicht für den Bestwert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fewer moves, the better. Puzzles solved with a hint don’t count for the best score."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuantos menos movimientos, mejor. Los puzles resueltos con pista no cuentan para la mejor marca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins il y a de coups, mieux c’est. Les grilles résolues avec un indice ne comptent pas pour le meilleur score."
          }
        }
      }
    },
    "Lege absteigend und abwechselnd rot und schwarz an, zum Beispiel die Herz-9 auf die Pik-10. Ganze passende Reihen darfst du gemeinsam verschieben.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege absteigend und abwechselnd rot und schwarz an, zum Beispiel die Herz-9 auf die Pik-10. Ganze passende Reihen darfst du gemeinsam verschieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build downwards, alternating red and black – for example the nine of hearts onto the ten of spades. You can move whole matching runs together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca en orden descendente y alternando rojo y negro, por ejemplo el 9 de corazones sobre el 10 de picas. Puedes mover juntas hileras completas que encajen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose en ordre décroissant en alternant rouge et noir, par exemple le 9 de cœur sur le 10 de pique. Tu peux déplacer ensemble des suites entières."
          }
        }
      }
    },
    "Eine Farbe, wenige Züge": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Farbe, wenige Züge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One colour, few moves"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un color, pocos movimientos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une couleur, peu de coups"
          }
        }
      }
    },
    "Wer zuerst die Zielpunkte erreicht, gewinnt – meist 10.000. Drei Nieten in Folge kosten Punkte.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer zuerst die Zielpunkte erreicht, gewinnt – meist 10.000. Drei Nieten in Folge kosten Punkte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first to reach the target score wins – usually 10,000. Three busts in a row cost points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana quien alcance primero la puntuación objetivo, normalmente 10.000. Tres fallos seguidos cuestan puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier à atteindre le score cible gagne – en général 10 000. Trois échecs d’affilée coûtent des points."
          }
        }
      }
    },
    "Wenige Züge": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenige Züge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Few moves"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocos movimientos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peu de coups"
          }
        }
      }
    },
    "Verlauf wiederherstellen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf wiederherstellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore the gradient"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar el degradado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablir le dégradé"
          }
        }
      }
    },
    "Du springst mit einem Stecker waagrecht oder senkrecht über einen Nachbarn in ein leeres Loch. Der übersprungene Stecker wird entfernt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du springst mit einem Stecker waagrecht oder senkrecht über einen Nachbarn in ein leeres Loch. Der übersprungene Stecker wird entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You jump a peg horizontally or vertically over a neighbour into an empty hole. The jumped peg is removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saltas con una clavija en horizontal o vertical sobre una vecina hasta un agujero vacío. La clavija saltada se retira."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sautes avec une cheville à l’horizontale ou à la verticale par-dessus une voisine vers un trou vide. La cheville sautée est retirée."
          }
        }
      }
    },
    "Hilfen und Stern": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilfen und Stern"
          }
        },
        "en": {
