          }
        }
      }
    },
    "Zwei gleiche Steine": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei gleiche Steine"
          }
        },
        "en": {
          "stringUnit": {
