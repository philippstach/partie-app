    },
    "Ausgang gefunden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit found"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salida encontrada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortie trouvée"
          }
        }
      }
    },
    "Tipp und Zurück": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hint and undo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pista y deshacer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indice et annuler"
          }
        }
      }
    },
    "Der Tipp zeigt einen guten Sprung, „Zurück“ nimmt Sprünge zurück. Du wählst zwischen den Brettern Kreuz (33 Löcher) und Europa (37 Löcher).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hint shows a good jump, “Back” takes jumps back. You choose between the Cross (33 holes) and Europe (37 holes) boards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pista muestra un buen salto y «Atrás» retira saltos. Eliges entre el tablero Cruz (33 agujeros) y Europa (37 agujeros)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indice montre un bon saut, « Retour » reprend des sauts. Tu choisis entre le plateau Croix (33 trous) et Europe (37 trous)."
          }
        }
      }
    },
    "Größe und Zurück": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size and undo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño y deshacer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille et annuler"
          }
        }
      }
    },
    "Im Menü wählst du das Feld von 3 × 3 bis 6 × 6. Zurück geht dreimal pro Spiel, der Tipp zeigt eine gute Richtung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the menu you choose the board from 3 × 3 to 6 × 6. You can undo three times per game; the hint shows a good direction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el menú eliges el campo de 3 × 3 a 6 × 6. Puedes deshacer tres veces por partida; la pista muestra una buena dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le menu, tu choisis la grille de 3 × 3 à 6 × 6. Tu peux annuler trois fois par partie ; l’indice montre une bonne direction."
          }
        }
      }
    },
    "Stufen und Tipp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Levels and hint"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveles y pista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveaux et indice"
          }
        }
      }
    },
    "Jede Stufe bringt ein größeres Labyrinth, ab Stufe 4 siehst du nur noch einen Ausschnitt. Ein Tipp zeigt die Richtung, kostet aber 25 Punkte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each level brings a bigger maze; from level 4 you only see a section. A hint shows the direction but costs 25 points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada nivel trae un laberinto mayor; desde el nivel 4 solo ves una parte. Una pista muestra la dirección, pero cuesta 25 puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque niveau apporte un labyrinthe plus grand ; dès le niveau 4, tu n’en vois qu’une partie. Un indice montre la direction mais coûte 25 points."
          }
        }
      }
    },
    "Im Menü wählst du Leicht bis Experte: mehr Inseln auf größerem Feld. Der Tipp setzt eine richtige Brücke, Rückgängig nimmt Züge zurück.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the menu you pick Easy to Expert: more islands on a bigger board. The hint places a correct bridge, Undo takes moves back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el menú eliges de Fácil a Experto: más islas en un campo mayor. La pista coloca un puente correcto y Deshacer retira jugadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le menu, tu choisis de Facile à Expert : plus d’îles sur une plus grande grille. L’indice pose un pont correct, Annuler reprend des coups."
          }
        }
      }
    },
    "Größe, Stufe, Muster": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size, level, pattern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño, nivel, patrón"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille, niveau, motif"
          }
        }
      }
    },
    "Im Menü stellst du Größe (3 × 3 bis 7 × 7), Schwierigkeit und Muster ein. Das Muster Plus, Diagonal oder Rund bestimmt, welche Nachbarn mitschalten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the menu you set size (3 × 3 to 7 × 7), difficulty and pattern. The pattern Plus, Diagonal or Round decides which neighbours toggle too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el menú ajustas tamaño (3 × 3 a 7 × 7), dificultad y patrón. El patrón Más, Diagonal o Redondo decide qué vecinas cambian también."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le menu, tu règles la taille (3 × 3 à 7 × 7), la difficulté et le motif. Le motif Plus, Diagonale ou Rond décide quelles voisines changent aussi."
          }
        }
      }
    },
    "Größe und Tipp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size and hint"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño y pista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille et indice"
          }
        }
      }
    },
    "Im Menü wählst du 3 × 3 bis 6 × 6. Der Tipp zeigt die nächste Kachel, Rückgängig nimmt Züge zurück.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the menu you pick 3 × 3 to 6 × 6. The hint shows the next tile, Undo takes moves back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el menú eliges de 3 × 3 a 6 × 6. La pista muestra la siguiente ficha y Deshacer retira jugadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le menu, tu choisis de 3 × 3 à 6 × 6. L’indice montre la prochaine tuile, Annuler reprend des coups."
          }
        }
      }
    },
    "Der Tipp-Knopf zeigt dir die nächste Richtung. Wer ihn nicht braucht, schafft die Stufe ohne Hilfe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hint button shows you the next direction. If you don’t need it, you clear the level unaided."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón de pista te muestra la siguiente dirección. Quien no lo necesita, supera el nivel sin ayuda."
          }
