          }
        }
      }
    },
    "Das App-Symbol ist das Bild von Partie auf deinem Home-Bildschirm. Die Symbole in der Spieleliste zeigen das Spielmaterial, die Farbe die Spielart.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das App-Symbol ist das Bild von Partie auf deinem Home-Bildschirm. Die Symbole in der Spieleliste zeigen das Spielmaterial, die Farbe die Spielart."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app icon is the picture of Partie on your Home Screen. The icons in the game list show the game material, the colour shows the type of game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El icono de la app es la imagen de Partie en tu pantalla de inicio. Los iconos de la lista de juegos muestran el material de juego y el color indica el tipo de juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’icône de l’app est l’image de Partie sur ton écran d’accueil. Les icônes de la liste de jeux montrent le matériel de jeu, la couleur indique le type de jeu."
          }
        }
      }
    },
    "Mitspielende legst du einmal unter „Spieler“ an. Danach stehen sie in jedem Spiel bereit, und die Statistik zählt mit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitspielende legst du einmal unter „Spieler“ an. Danach stehen sie in jedem Spiel bereit, und die Statistik zählt mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the people you play with once under “Players”. They are then available in every game and the statistics keep count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una sola vez a quienes juegan contigo en «Jugadores». Después estarán en todos los juegos y las estadísticas contarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une seule fois les personnes avec qui tu joues dans « Joueurs ». Elles sont ensuite disponibles dans chaque jeu et les statistiques comptent."
          }
        }
      }
    },
    "Entfernen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen"
          }
        },
        "en": {
