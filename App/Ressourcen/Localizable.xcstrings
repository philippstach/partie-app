            "value": "Ligne %lld, colonne %lld%@%@%@"
          }
        }
      }
    },
    "Aufeinanderfolgende Augen, zum Beispiel 1-2-3-4-5 (kleine Straße) oder 2-3-4-5-6 (große Straße).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consecutive pips, for example 1-2-3-4-5 (small straight) or 2-3-4-5-6 (large straight)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntos consecutivos, por ejemplo 1-2-3-4-5 (escalera pequeña) o 2-3-4-5-6 (escalera grande)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des points qui se suivent, par exemple 1-2-3-4-5 (petite suite) ou 2-3-4-5-6 (grande suite)."
          }
        }
      }
    },
    "%@ · ca. %lld Min.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · approx. %lld min"
          }
        },
        "es": {
