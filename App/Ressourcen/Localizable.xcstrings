    "Einser bis Sechser zählen die Würfel mit dieser Augenzahl. Ab 63 Punkten im oberen Block gibt es 35 Punkte Bonus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einser bis Sechser zählen die Würfel mit dieser Augenzahl. Ab 63 Punkten im oberen Block gibt es 35 Punkte Bonus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ones to Sixes count the dice showing that number. With 63 points or more in the upper section you get a 35 point bonus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De unos a seises se cuentan los dados con ese número. Con 63 puntos o más en el bloque superior hay un bonus de 35 puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du 1 au 6, on compte les dés portant ce chiffre. À partir de 63 points dans le bloc du haut, tu gagnes un bonus de 35 points."
          }
        }
      }
    },
