    },
    "1 beendetes Spiel. Mitspielende werden am Namen erkannt. Die Statistik bleibt auch, wenn beendete Spiele nicht behalten werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 finished game. Fellow players are recognised by name. The statistics are kept even if finished games are not kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 partida terminada. Los demás jugadores se reconocen por el nombre. Las estadísticas se conservan aunque no se guarden las partidas terminadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 partie terminée. Les autres joueurs sont reconnus par leur nom. Les statistiques sont conservées même si les parties terminées ne le sont pas."
          }
        }
      }
    },
