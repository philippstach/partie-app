    "Schickt deine besten Zeiten und Punkte an die Bestenlisten von Apple und schaltet Erfolge frei. Ohne Anmeldung bei Apple bleibt alles auf diesem Gerät.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schickt deine besten Zeiten und Punkte an die Bestenlisten von Apple und schaltet Erfolge frei. Ohne Anmeldung bei Apple bleibt alles auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends your best times and scores to Apple’s leaderboards and unlocks achievements. Without an Apple sign-in, everything stays on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía tus mejores tiempos y puntuaciones a las clasificaciones de Apple y desbloquea logros. Sin iniciar sesión en Apple, todo se queda en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie tes meilleurs temps et scores aux classements d’Apple et débloque des succès. Sans connexion Apple, tout reste sur cet appareil."
          }
        }
      }
    },
