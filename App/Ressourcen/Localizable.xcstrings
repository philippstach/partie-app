        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Atascado? «Pista» te muestra un movimiento, «Deshacer» retrocede movimientos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqué ? « Indice » vous montre un coup, « Annuler » revient en arrière."
