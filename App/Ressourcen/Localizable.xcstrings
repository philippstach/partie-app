      }
    },
    "Sonderzug beim Schach: König und Turm wechseln gleichzeitig die Plätze, um den König zu sichern.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A special chess move: king and rook swap places at the same time to protect the king."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Movimiento especial del ajedrez: el rey y la torre cambian de sitio a la vez para proteger al rey."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coup spécial aux échecs : le roi et la tour échangent leurs places en même temps pour mettre le roi à l’abri."
          }
        }
      }
    },
    "Die ausgelegten Kartenreihen beim Solitär, auf denen abwechselnd Rot und Schwarz absteigend angelegt wird.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rows of cards laid out in Solitaire, built downward in alternating red and black."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las hileras de cartas colocadas en el solitario, que se construyen en orden descendente alternando rojo y negro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les colonnes de cartes disposées au solitaire, sur lesquelles on pose en descendant en alternant rouge et noir."
          }
        }
      }
    },
    "%lld goldene Würfel, darüber zählt %@ hoch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld golden dice, above them a counter counting up to %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dados dorados y encima un contador que sube hasta %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dés dorés, au-dessus un compteur qui monte jusqu’à %@"
          }
        }
      }
    },
    "Alle Daten bleiben auf deinem Gerät. Partie hat keine Konten, keine Server und kein Tracking.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All data stays on your device. Partie has no accounts, no servers and no tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los datos permanecen en tu dispositivo. Partie no tiene cuentas, servidores ni seguimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les données restent sur ton appareil. Partie n’a ni compte, ni serveur, ni suivi."
          }
        }
      }
    },
    "Jeden Tag dasselbe Rätsel für alle. Die Serie zählt, wie viele Tage in Folge du gelöst hast.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same puzzle for everyone every day. The streak counts how many days in a row you have solved it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo puzle para todos cada día. La racha cuenta cuántos días seguidos lo has resuelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La même grille pour tout le monde chaque jour. La série compte combien de jours d’affilée tu l’as résolue."
          }
        }
      }
    },
    "Bluffen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluffing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Farol"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluffer"
          }
        }
      }
    },
    "Nicht verfügbar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponible"
          }
        }
      }
    },
    "Feld %lld%@%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Square %lld%@%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casilla %lld%@%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Case %lld%@%@"
          }
        }
      }
    },
    "Die App zeigt den nächsten sicheren Schritt. Kostet nichts, wird aber gezählt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app shows the next safe step. Costs nothing but is counted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app muestra el siguiente paso seguro. No cuesta nada, pero se cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app montre la prochaine étape sûre. Ne coûte rien, mais est comptée."
          }
        }
      }
    },
    "Pfeilrätsel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrow crossword"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crucigrama de flechas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mots fléchés"
          }
        }
      }
    },
    "Drei gleiche und zwei gleiche Würfel, zum Beispiel 4-4-4-2-2.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three of one kind and two of another, for example 4-4-4-2-2."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres dados iguales y dos iguales, por ejemplo 4-4-4-2-2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois dés identiques et deux autres identiques, par exemple 4-4-4-2-2."
          }
        }
      }
    },
    " und ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " and "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " y "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " et "
          }
        }
      }
    },
    "Einen gegnerischen Stein vom Brett nehmen, meist indem man auf sein Feld zieht oder über ihn springt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove an opponent’s piece from the board, usually by moving onto its square or jumping over it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar una ficha del rival del tablero, normalmente moviéndote a su casilla o saltando sobre ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer un pion adverse du plateau, en général en allant sur sa case ou en sautant par-dessus."
          }
        }
      }
    },
    "Der König steht im Schach und kann nicht mehr entkommen. Die Partie ist zu Ende.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The king is in check and can no longer escape. The game is over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rey está en jaque y ya no puede escapar. La partida ha terminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le roi est en échec et ne peut plus s’échapper. La partie est terminée."
          }
        }
      }
    },
    "Hinweiszahl": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clue number"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Número de pista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffre indice"
          }
        }
      }
    },
    "Kreuz, Pik, Herz, Karo – im spanischen Blatt Münzen, Kelche, Schwerter, Stäbe. Nicht die Druckfarbe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clubs, spades, hearts, diamonds – in the Spanish deck coins, cups, swords, batons. Not the colour of the ink."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tréboles, picas, corazones, diamantes; en la baraja española oros, copas, espadas, bastos. No el color de la tinta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trèfle, pique, cœur, carreau – dans le jeu espagnol deniers, coupes, épées, bâtons. Ce n’est pas la couleur d’impression."
          }
        }
      }
    },
    "Eine gegnerische Figur zurück auf den Start schicken, indem man ihr Feld betritt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send an opponent’s piece back to the start by landing on its square."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mandar una ficha del rival de vuelta a la salida cayendo en su casilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoyer un pion adverse au départ en tombant sur sa case."
          }
        }
      }
    },
    "Alle Daten löschen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all data?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar todos los datos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer toutes les données ?"
          }
        }
      }
    },
    "Ohne Apple Intelligence: Vorschlag nach Spielart, Spielerzahl, Zeit und Anspruch aus deinem Text.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Apple Intelligence: suggestion by type, number of players, time and difficulty from your text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin Apple Intelligence: sugerencia según tipo, número de jugadores, tiempo y dificultad a partir de tu texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans Apple Intelligence : suggestion selon le type, le nombre de joueurs, la durée et la difficulté d’après ton texte."
          }
        }
      }
    },
    "Weiter oder aufhören?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep going or stop?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguir o parar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer ou s’arrêter ?"
          }
        }
      }
    },
    "Farbe wünschen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a colour"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir un color"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir une couleur"
          }
        }
      }
    },
    "Hört jemand auf und lässt Würfel liegen, darfst du sie samt Punkten übernehmen und weiterwürfeln. Mit einer Niete ist aber alles weg.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If someone stops and leaves dice on the table, you may take them over along with the points and keep rolling. But a bust wipes it all out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si alguien para y deja dados en la mesa, puedes quedártelos con sus puntos y seguir tirando. Pero con un nulo lo pierdes todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si quelqu’un s’arrête et laisse des dés, tu peux les reprendre avec leurs points et continuer. Mais un raté efface tout."
          }
        }
      }
    },
    "Schock": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Schock"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Schock"
          }
        }
      }
    },
    "Beim Wendespiel: eingeschlossene gegnerische Steine umdrehen, damit sie die eigene Farbe zeigen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Reversi: flip trapped opponent pieces so they show your own colour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el Reversi: dar la vuelta a las fichas rivales atrapadas para que muestren tu propio color."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au Reversi : retourner les pions adverses encerclés pour qu’ils montrent ta couleur."
          }
        }
      }
    },
    "Säen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sowing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Semer"
          }
        }
      }
    },
    "Drei oder vier Karten gleichen Werts in verschiedenen Farben, zum Beispiel drei Damen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three or four cards of equal value in different suits, for example three queens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres o cuatro cartas del mismo valor en palos distintos, por ejemplo tres reinas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois ou quatre cartes de même valeur dans des couleurs différentes, par exemple trois dames."
          }
        }
      }
    },
    "Spielzeit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duración"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée de jeu"
          }
        }
      }
    },
    "Bei Stadt, Land, Fluss eine Spalte wie Tier oder Beruf, zu der ein Wort mit dem Buchstaben gesucht wird.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Stadt, Land, Fluss, a column such as animal or occupation for which a word starting with the letter is needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Stadt, Land, Fluss, una columna como animal u oficio para la que se busca una palabra con la letra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À Stadt, Land, Fluss, une colonne comme animal ou métier pour laquelle on cherche un mot commençant par la lettre."
          }
        }
      }
    },
    "Was liegt unter deinem Becher?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What’s under your cup?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué hay bajo tu cubilete?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu’y a-t-il sous ton gobelet ?"
          }
        }
      }
    },
    "Einmal reihum: Jeder Spieler war genau einmal am Zug. Viele Spiele zählen Punkte je Runde.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One go around the table: every player has had exactly one turn. Many games count points per round."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vuelta a la mesa: cada jugador ha tenido exactamente un turno. Muchos juegos cuentan puntos por ronda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tour de table : chaque joueur a joué exactement une fois. Beaucoup de jeux comptent les points par manche."
          }
        }
      }
    },
    "Alle punkten: weiter mit allen %lld!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All score: carry on with all %lld!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Todos puntúan: sigues con los %lld!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous comptent : on continue avec les %lld !"
          }
        }
      }
    },
    "Drei Nieten in Folge kosten %@ Punkte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three busts in a row cost %@ points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres nulos seguidos cuestan %@ puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois ratés d’affilée coûtent %@ points."
          }
        }
      }
    },
    "Trumpf": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trump"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Triunfo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atout"
          }
        }
      }
    },
    "150 gesichert oder weiterzocken?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank 150 or gamble on?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Asegurar 150 o seguir jugándotela?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sécuriser 150 ou tenter sa chance ?"
          }
        }
      }
    },
    "Welche Farbe wünschst du dir?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which colour do you wish for?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué color deseas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle couleur veux-tu ?"
          }
        }
      }
    },
    "Ein Feld als Mine oder als sicher kennzeichnen, ohne es aufzudecken.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark a cell as a mine or as safe without uncovering it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar una casilla como mina o como segura sin descubrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer une case comme mine ou comme sûre sans la découvrir."
          }
        }
      }
    },
    "ca. %lld Min.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "approx. %lld min"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "aprox. %lld min"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "env. %lld min"
          }
        }
      }
    },
    "Alles gelöscht. Beende Partie und öffne sie neu, damit alle Ansichten leer starten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything deleted. Quit Partie and open it again so all views start empty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo borrado. Cierra Partie y ábrela de nuevo para que todas las vistas empiecen vacías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est supprimé. Quitte Partie et rouvre-la pour que toutes les vues repartent à zéro."
          }
        }
      }
    },
    "Allein": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul"
          }
        }
      }
    },
    "Der Spieler am Zug hat keinen erlaubten Zug, steht aber nicht im Schach. Unentschieden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The player to move has no legal move but is not in check. A draw."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El jugador al que le toca mover no tiene ningún movimiento legal pero no está en jaque. Tablas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le joueur qui doit jouer n’a aucun coup légal mais n’est pas en échec. Partie nulle."
          }
        }
      }
    },
    "Wie oft du noch verlieren darfst, bevor die Partie endet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
