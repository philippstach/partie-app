    "Gilt nur für Spiele ohne verdeckte Karten. Bei geheimen Karten bleibt immer „Bereit“.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt nur für Spiele ohne verdeckte Karten. Bei geheimen Karten bleibt immer „Bereit“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only applies to games without hidden cards. With secret cards, “Ready” always stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para juegos sin cartas ocultas. Con cartas secretas siempre se mantiene «Listo»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour les jeux sans cartes cachées. Avec des cartes secrètes, « Prêt » reste toujours."
          }
        }
      }
    },
    "Gewinne Stiche und Punkte mit Mut und Bluff. Wer zuerst 15 Punkte hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewinne Stiche und Punkte mit Mut und Bluff. Wer zuerst 15 Punkte hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win tricks and points with nerve and bluffing. The first to reach 15 points wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana bazas y puntos con valor y faroles. Gana el primero en llegar a 15 puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remporte des plis et des points avec audace et bluff. Le premier à atteindre 15 points gagne."
          }
        }
      }
    },
    "Versenke als Erster alle fünf Schiffe des Gegners.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versenke als Erster alle fünf Schiffe des Gegners."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to sink all five of your opponent’s ships."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en hundir los cinco barcos del rival."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à couler les cinq navires de ton adversaire."
          }
        }
      }
    },
    "Lege alle Paare ab und lass den einzelnen Pechvogel bei den anderen. Wer ihn am Ende hat, verliert.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege alle Paare ab und lass den einzelnen Pechvogel bei den anderen. Wer ihn am Ende hat, verliert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay down all your pairs and pass the lone Unlucky Bird on. Whoever is left holding it loses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarta todas tus parejas y no te quedes con el Pechvogel. Quien lo tenga al final pierde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose toutes tes paires et ne reste pas avec le Pechvogel seul. Celui qui le garde à la fin perd."
          }
        }
      }
    },
    "Bringe als Erster vier deiner Steine waagerecht, senkrecht oder diagonal in eine Reihe.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringe als Erster vier deiner Steine waagerecht, senkrecht oder diagonal in eine Reihe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to line up four of your discs horizontally, vertically or diagonally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en alinear cuatro de tus fichas en horizontal, vertical o diagonal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à aligner quatre de tes jetons à l’horizontale, à la verticale ou en diagonale."
          }
        }
      }
    },
    "Werde alle Karten los, ohne beim Mogeln erwischt zu werden. Wer zuerst keine hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werde alle Karten los, ohne beim Mogeln erwischt zu werden. Wer zuerst keine hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get rid of all your cards without being caught cheating. The first with no cards left wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quédate sin cartas sin que te pillen mintiendo. Gana el primero que se quede sin ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défausse toutes tes cartes sans te faire prendre à tricher. Le premier sans cartes gagne."
          }
        }
      }
    },
    "Schiebe alle Kisten auf die markierten Plätze, um die Stufe zu lösen, und löse so viele Stufen wie möglich.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiebe alle Kisten auf die markierten Plätze, um die Stufe zu lösen, und löse so viele Stufen wie möglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push all crates onto the marked spots to solve the level, and solve as many levels as you can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja todas las cajas a los lugares marcados para resolver el nivel, y resuelve cuantos niveles puedas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousse toutes les caisses sur les emplacements marqués pour réussir le niveau, et réussis-en autant que possible."
          }
        }
      }
    },
    "Bringe als Erster alle deine zehn Steine in die gegenüberliegende Ecke.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringe als Erster alle deine zehn Steine in die gegenüberliegende Ecke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to bring all ten of your pieces into the opposite corner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en llevar tus diez fichas a la esquina opuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à amener tes dix pions dans le coin opposé."
          }
        }
      }
    },
    "Bringe alle Karten nach Farben aufsteigend vom Ass bis zum König auf die vier Ablagen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringe alle Karten nach Farben aufsteigend vom Ass bis zum König auf die vier Ablagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move all cards to the four foundations, each suit in order from ace to king."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva todas las cartas a las cuatro bases, cada palo en orden del as al rey."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amène toutes les cartes sur les quatre fondations, chaque couleur dans l’ordre de l’as au roi."
          }
        }
      }
    },
    "Lege als Erster alle deine Steine an die Kette. Kommt niemand mehr weiter, gewinnt, wer die wenigsten Augen hat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege als Erster alle deine Steine an die Kette. Kommt niemand mehr weiter, gewinnt, wer die wenigsten Augen hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to play all your tiles onto the chain. If nobody can move, the fewest pips wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en colocar todas tus fichas en la cadena. Si nadie puede seguir, gana quien tenga menos puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à poser toutes tes pièces sur la chaîne. Si personne ne peut jouer, celui qui a le moins de points gagne."
          }
        }
      }
    },
    "Tausche die Kacheln, bis sie wieder den sanften Farbverlauf bilden, mit möglichst wenigen Zügen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tausche die Kacheln, bis sie wieder den sanften Farbverlauf bilden, mit möglichst wenigen Zügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap the tiles until they form the smooth colour gradient again, using as few moves as possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercambia las fichas hasta que formen de nuevo el degradado suave, con la menor cantidad de movimientos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échange les tuiles jusqu’à retrouver le dégradé de couleurs, en un minimum de coups."
          }
        }
      }
    },
    "Finde möglichst viele Paare. Wer am Ende die meisten hat, gewinnt; allein brauchst du wenige Versuche.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde möglichst viele Paare. Wer am Ende die meisten hat, gewinnt; allein brauchst du wenige Versuche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find as many pairs as you can. Whoever has the most at the end wins; playing alone, use as few tries as possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra el mayor número de parejas. Gana quien tenga más al final; solo, necesita pocos intentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve le plus de paires possible. Celui qui en a le plus à la fin gagne ; seul, utilise peu d’essais."
          }
        }
      }
    },
    "Lege alle deine Karten in die Reihen an und sei der Erste ohne Karten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege alle deine Karten in die Reihen an und sei der Erste ohne Karten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add all your cards to the rows and be the first with no cards left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca todas tus cartas en las filas y sé el primero en quedarte sin ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose toutes tes cartes dans les rangées et sois le premier sans cartes."
          }
        }
      }
    },
    "Bluffe und rate besser als die anderen. Wer als Letzter noch Würfel hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluffe und rate besser als die anderen. Wer als Letzter noch Würfel hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluff and guess better than the others. The last player with dice left wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Farolea y adivina mejor que los demás. Gana el último que conserve dados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluffe et devine mieux que les autres. Le dernier joueur qui a encore des dés gagne."
          }
        }
      }
    },
    "Fülle die Felder so, dass jede Zeile und Spalte zu ihren Zahlen passt. Dann erscheint das Bild.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fülle die Felder so, dass jede Zeile und Spalte zu ihren Zahlen passt. Dann erscheint das Bild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill in the squares so every row and column matches its numbers. Then the picture appears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena las casillas de modo que cada fila y columna coincida con sus números. Entonces aparece la imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplis les cases pour que chaque ligne et chaque colonne corresponde à ses nombres. L’image apparaît alors."
          }
        }
      }
    },
    "Sammle Tischkarten mit der Summe 15 und hole die meisten Punkte. Es gewinnt, wer am Ende mehr Punkte hat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle Tischkarten mit der Summe 15 und hole die meisten Punkte. Es gewinnt, wer am Ende mehr Punkte hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect table cards that add up to 15 and score the most points. Whoever has more points at the end wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recoge cartas de la mesa que sumen 15 y consigue más puntos. Gana quien tenga más puntos al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramasse des cartes de la table dont la somme fait 15 et marque le plus de points. Celui qui a le plus de points à la fin gagne."
          }
        }
      }
    },
    "Sei der Erste mit 100 Punkten. Würfle mutig, aber sichere rechtzeitig, bevor eine 1 alles löscht.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei der Erste mit 100 Punkten. Würfle mutig, aber sichere rechtzeitig, bevor eine 1 alles löscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to reach 100 points. Roll boldly, but bank in time before a 1 wipes out your turn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en llegar a 100 puntos. Tira con valentía, pero asegura a tiempo antes de que un 1 lo borre todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à atteindre 100 points. Lance avec audace, mais mets tes points à l’abri avant qu’un 1 ne les efface."
          }
        }
      }
    },
    "Färbe das ganze Feld in einer einzigen Farbe, bevor deine Züge aufgebraucht sind.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbe das ganze Feld in einer einzigen Farbe, bevor deine Züge aufgebraucht sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the whole board a single colour before you run out of moves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta todo el tablero de un solo color antes de que se acaben tus movimientos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorie tout le plateau d’une seule couleur avant d’avoir épuisé tes coups."
          }
        }
      }
    },
    "Bilde Kombinationen und schließe mit möglichst wenig Restpunkten. Wer 100 Punkte erreicht, scheidet aus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilde Kombinationen und schließe mit möglichst wenig Restpunkten. Wer 100 Punkte erreicht, scheidet aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Form melds and go out with as few leftover points as possible. Reach 100 points and you are out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma combinaciones y cierra con los menos puntos sobrantes posible. Quien llega a 100 puntos queda eliminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forme des combinaisons et ferme avec le moins de points restants possible. Qui atteint 100 points est éliminé."
          }
        }
      }
    },
    "Bilde Mühlen und nimm dem Gegner Steine weg, bis er nur noch zwei hat oder nicht mehr ziehen kann.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilde Mühlen und nimm dem Gegner Steine weg, bis er nur noch zwei hat oder nicht mehr ziehen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Form mills and remove enemy stones until your opponent has only two left or cannot move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma molinos y quita fichas al rival hasta que le queden solo dos o no pueda mover."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forme des moulins et retire les pions adverses jusqu’à ce qu’il n’en reste que deux ou qu’il ne puisse plus bouger."
          }
        }
      }
    },
    "Würfle Schiff, Kapitän und Mannschaft und dazu möglichst viel Fracht. Nach fünf Runden gewinnt, wer die meisten Punkte hat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Würfle Schiff, Kapitän und Mannschaft und dazu möglichst viel Fracht. Nach fünf Runden gewinnt, wer die meisten Punkte hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll ship, captain and crew plus as much cargo as possible. After five rounds, the player with the most points wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saca barco, capitán y tripulación y la mayor carga posible. Tras cinco rondas gana quien tenga más puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtiens navire, capitaine et équipage, plus un maximum de cargaison. Après cinq manches, celui qui a le plus de points gagne."
          }
        }
      }
    },
    "Sei der Erste, der die Zielpunkte erreicht (meist 10.000). Würfle klug und schreibe rechtzeitig gut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei der Erste, der die Zielpunkte erreicht (meist 10.000). Würfle klug und schreibe rechtzeitig gut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to reach the target score (usually 10,000). Roll wisely and bank your points in time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en alcanzar los puntos objetivo (normalmente 10.000). Tira con cabeza y anota a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à atteindre le score cible (en général 10 000). Lance avec malice et mets tes points à l’abri à temps."
          }
        }
      }
    },
    "Finde den Weg von links oben zum Ausgang rechts unten, möglichst kurz und mit Funken, und sammle so Punkte.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde den Weg von links oben zum Ausgang rechts unten, möglichst kurz und mit Funken, und sammle so Punkte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your way from the top left to the exit at the bottom right, as short as possible and with sparks, to score points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra el camino desde arriba a la izquierda hasta la salida abajo a la derecha, lo más corto posible y con chispas, para sumar puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve le chemin du coin en haut à gauche jusqu’à la sortie en bas à droite, le plus court possible et avec des étincelles, pour marquer des points."
          }
        }
      }
    },
    "Gänse: Kreise den Fuchs ein, bis er nicht mehr ziehen kann. Fuchs: Friss die Gänse, bis nur noch drei übrig sind.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gänse: Kreise den Fuchs ein, bis er nicht mehr ziehen kann. Fuchs: Friss die Gänse, bis nur noch drei übrig sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Geese: surround the fox until it cannot move. Fox: eat geese until only three are left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocas: rodea al zorro hasta que no pueda moverse. Zorro: cómete las ocas hasta que solo queden tres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oies : encercle le renard jusqu’à ce qu’il ne puisse plus bouger. Renard : mange les oies jusqu’à ce qu’il n’en reste que trois."
          }
        }
      }
    },
    "Bringe als Erster alle sieben Steine über den Weg hinaus. Schlage Gegner im mittleren Streifen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringe als Erster alle sieben Steine über den Weg hinaus. Schlage Gegner im mittleren Streifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to bring all seven pieces along the path and off the board. Capture rivals in the middle lane."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en sacar las siete fichas del recorrido. Captura a los rivales en la franja central."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à faire sortir tes sept pions du parcours. Capture tes adversaires dans la bande centrale."
          }
        }
      }
    },
    "Verschmilz gleiche Zahlen, bis du die 2048 erreichst, oder sammle so viele Punkte wie möglich, bis nichts mehr geht.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschmilz gleiche Zahlen, bis du die 2048 erreichst, oder sammle so viele Punkte wie möglich, bis nichts mehr geht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge equal numbers to reach 2048, or score as many points as you can until no moves are left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusiona números iguales hasta llegar a 2048, o suma tantos puntos como puedas hasta que no queden movimientos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionne les nombres identiques jusqu’à atteindre 2048, ou marque le plus de points possible jusqu’à ce qu’il n’y ait plus de coup."
          }
        }
      }
    },
    "Setze den ganzen Turm auf den rechten Stab, mit möglichst wenigen Zügen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze den ganzen Turm auf den rechten Stab, mit möglichst wenigen Zügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the whole tower to the right peg in as few moves as possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva toda la torre a la varilla derecha con la menor cantidad de movimientos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace toute la tour sur la tige de droite en un minimum de coups."
          }
        }
      }
    },
    "Klappe die Zahlen 1 bis 9 zu. Wer am Ende die wenigsten Punkte aus offenen Zahlen hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klappe die Zahlen 1 bis 9 zu. Wer am Ende die wenigsten Punkte aus offenen Zahlen hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shut the numbers 1 to 9. The player with the fewest points from open numbers at the end wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra los números del 1 al 9. Gana quien tenga menos puntos de números abiertos al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rabats les nombres de 1 à 9. Celui qui a le moins de points en nombres restés ouverts à la fin gagne."
          }
        }
      }
    },
    "Erobere als Erster 25 Samen aus den gegnerischen Mulden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erobere als Erster 25 Samen aus den gegnerischen Mulden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to capture 25 seeds from your opponent’s pits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en capturar 25 semillas de los hoyos del rival."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à capturer 25 graines dans les trous de ton adversaire."
          }
        }
      }
    },
    "Lege Sätze und Folgen aus und werde als Erster alle Karten los. Die anderen bekommen Strafpunkte.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Sätze und Folgen aus und werde als Erster alle Karten los. Die anderen bekommen Strafpunkte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay down sets and runs and be the first to get rid of all your cards. The others get penalty points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja tríos y escaleras y sé el primero en quedarte sin cartas. Los demás reciben puntos de penalización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose des brelans et des suites et sois le premier sans cartes. Les autres reçoivent des points de pénalité."
          }
        }
      }
    },
    "Finde zu jedem Buchstaben passende Wörter für alle Kategorien und hole nach fünf Runden die meisten Punkte.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde zu jedem Buchstaben passende Wörter für alle Kategorien und hole nach fünf Runden die meisten Punkte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a matching word in every category for each letter and score the most points after five rounds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra una palabra válida en cada categoría para cada letra y consigue más puntos tras cinco rondas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve un mot valable dans chaque catégorie pour chaque lettre et obtiens le plus de points après cinq manches."
          }
        }
      }
    },
    "Habe am Ende mehr Steine deiner Farbe auf dem Brett als dein Gegner.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Habe am Ende mehr Steine deiner Farbe auf dem Brett als dein Gegner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have more pieces of your colour on the board than your opponent at the end."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten al final más fichas de tu color en el tablero que tu rival."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aie à la fin plus de pions de ta couleur sur le plateau que ton adversaire."
          }
        }
      }
    },
    "Bringe als Erster alle vier Steine einmal um den Ring ins Ziel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringe als Erster alle vier Steine einmal um den Ring ins Ziel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to get all four of your stones once around the ring and home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en llevar tus cuatro piedras una vuelta completa al anillo hasta la meta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à amener tes quatre pierres une fois autour de l’anneau jusqu’à l’arrivée."
          }
        }
      }
    },
    "Verbinde mit einer durchgehenden Kette deine beiden Seiten des Feldes, bevor es dein Gegner schafft.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde mit einer durchgehenden Kette deine beiden Seiten des Feldes, bevor es dein Gegner schafft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link your two sides of the board with an unbroken chain before your opponent does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tus dos lados del tablero con una cadena continua antes que tu rival."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relie tes deux côtés du plateau par une chaîne continue avant ton adversaire."
          }
        }
      }
    },
    "Errate das versteckte Wort, bevor alle 8 Ballons geplatzt sind.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Errate das versteckte Wort, bevor alle 8 Ballons geplatzt sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guess the hidden word before all 8 balloons have popped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adivina la palabra oculta antes de que revienten los 8 globos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devine le mot caché avant que les 8 ballons aient éclaté."
          }
        }
      }
    },
    "Entferne alle Steine vom Brett, indem du immer zwei gleiche freie Steine antippst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne alle Steine vom Brett, indem du immer zwei gleiche freie Steine antippst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear every tile from the board by tapping pairs of matching free tiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita todas las fichas del tablero tocando siempre dos fichas libres iguales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire toutes les tuiles du plateau en touchant à chaque fois deux tuiles libres identiques."
          }
        }
      }
    },
    "Würfle besser als die anderen, damit du keine Deckel bekommst. Wer zwei Hälften oder das Finale verliert, verliert die Partie.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Würfle besser als die anderen, damit du keine Deckel bekommst. Wer zwei Hälften oder das Finale verliert, verliert die Partie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll better than the others so you do not take any tokens. Whoever loses two halves or the final loses the game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira mejor que los demás para no llevarte fichas. Quien pierda dos mitades o la final pierde la partida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance mieux que les autres pour ne pas recevoir de jetons. Qui perd deux manches ou la finale perd la partie."
          }
        }
      }
    },
    "Sammle am Ende mehr Steine in deinem Haus als dein Gegner.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle am Ende mehr Steine in deinem Haus als dein Gegner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect more stones in your store than your opponent by the end."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reúne al final más piedras en tu almacén que tu rival."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récolte à la fin plus de pierres dans ta maison que ton adversaire."
          }
        }
      }
    },
    "Vermeide Herzen und die Pik-Dame, sie zählen Minuspunkte. Bei 50 Punkten endet das Spiel, die wenigsten Punkte gewinnen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeide Herzen und die Pik-Dame, sie zählen Minuspunkte. Bei 50 Punkten endet das Spiel, die wenigsten Punkte gewinnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid hearts and the queen of spades, they cost points. The game ends at 50 points and the fewest points win."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita los corazones y la dama de picas, restan puntos. El juego acaba al llegar a 50 y gana quien tenga menos puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évite les cœurs et la dame de pique, ils coûtent des points. La partie s’arrête à 50 points et le moins de points gagne."
          }
        }
      }
    },
    "Gewinne durch die höhere Karte alle Karten des Gegners. Wer am Ende alle hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewinne durch die höhere Karte alle Karten des Gegners. Wer am Ende alle hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win all your opponent’s cards with the higher card. Whoever ends up with all of them wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana todas las cartas del rival con la carta más alta. Gana quien al final las tenga todas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagne toutes les cartes de l’adversaire avec la carte la plus haute. Celui qui les a toutes à la fin gagne."
          }
        }
      }
    },
    "Setze den gegnerischen König matt: Er steht im Schach und kann nicht mehr entkommen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze den gegnerischen König matt: Er steht im Schach und kann nicht mehr entkommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkmate the enemy king: put it in check so it has no escape."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da jaque mate al rey rival: ponlo en jaque sin que pueda escapar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mets le roi adverse échec et mat : il est en échec et ne peut plus s’échapper."
          }
        }
      }
    },
    "Drücke bei zwei gleichen Bildern als Erster auf Schnapp und sammle so alle Karten. Wer alle hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke bei zwei gleichen Bildern als Erster auf Schnapp und sammle so alle Karten. Wer alle hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be first to press Snap when two matching pictures show and win the pile. Whoever ends up with all the cards wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa primero Snap cuando salgan dos imágenes iguales y llévate el montón. Gana quien consiga todas las cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie le premier sur Snap quand deux images identiques apparaissent et gagne la pile. Celui qui a toutes les cartes gagne."
          }
        }
      }
    },
    "Kreuze auf deinem Bogen passende Farbfelder an. Wer am Ende die meisten Punkte hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreuze auf deinem Bogen passende Farbfelder an. Wer am Ende die meisten Punkte hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross off matching colored squares on your sheet. The player with the most points at the end wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tacha casillas de color en tu hoja con los dados. Gana quien tenga más puntos al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coche des cases de couleur sur ta feuille grâce aux dés. Celui qui a le plus de points à la fin gagne."
          }
        }
      }
    },
    "Werde so schnell wie möglich alle Karten los, indem du eins höher oder niedriger anlegst. Wer zuerst keine hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werde so schnell wie möglich alle Karten los, indem du eins höher oder niedriger anlegst. Wer zuerst keine hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get rid of all your cards as fast as you can by playing one higher or lower. The first with no cards wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quédate sin cartas lo más rápido posible jugando una más alta o más baja. Gana el primero que lo logre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défausse tes cartes le plus vite possible en posant une carte plus haute ou plus basse d’un cran. Le premier sans cartes gagne."
          }
        }
      }
    },
    "Ordne die Kacheln der Reihe nach von 1 an, mit der Lücke unten rechts, in möglichst wenigen Zügen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordne die Kacheln der Reihe nach von 1 an, mit der Lücke unten rechts, in möglichst wenigen Zügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange the tiles in order from 1 with the gap at the bottom right, in as few moves as possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena las fichas desde el 1 con el hueco abajo a la derecha, con la menor cantidad de movimientos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Range les tuiles dans l’ordre à partir de 1, avec le trou en bas à droite, en un minimum de coups."
          }
        }
      }
    },
    "Sammle in einer Farbe möglichst nah an 31 Punkte. Wer die niedrigste Hand hat, verliert ein Leben; wer übrig bleibt, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle in einer Farbe möglichst nah an 31 Punkte. Wer die niedrigste Hand hat, verliert ein Leben; wer übrig bleibt, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect close to 31 points in one suit. The lowest hand loses a life; the last player left wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reúne cerca de 31 puntos en un palo. La mano más baja pierde una vida; gana quien quede al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réunis près de 31 points dans une couleur. La main la plus faible perd une vie ; le dernier en jeu gagne."
          }
        }
      }
    },
    "Würfle in jeder der fünf Runden die beste Pokerhand. Wer am Ende die meisten Punkte hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Würfle in jeder der fünf Runden die beste Pokerhand. Wer am Ende die meisten Punkte hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll the best poker hand in each of the five rounds. The player with the most points at the end wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saca la mejor mano de póker en cada una de las cinco rondas. Gana quien tenga más puntos al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais la meilleure main de poker à chacune des cinq manches. Celui qui a le plus de points à la fin gagne."
          }
        }
      }
    },
    "Fülle das Quadrat so, dass in jeder Zeile und Spalte jede Zahl einmal steht und alle Ungleichheitszeichen stimmen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fülle das Quadrat so, dass in jeder Zeile und Spalte jede Zahl einmal steht und alle Ungleichheitszeichen stimmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill the square so each number appears once in every row and column and all inequality signs hold."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena el cuadrado de modo que cada número aparezca una vez en cada fila y columna y se cumplan todos los signos de desigualdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplis le carré pour que chaque nombre apparaisse une fois par ligne et par colonne et que tous les signes d’inégalité soient respectés."
          }
        }
      }
    },
    "Werde deine Karten als Erster los. Dafür bekommst du die Punkte der Karten des Gegners.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werde deine Karten als Erster los. Dafür bekommst du die Punkte der Karten des Gegners."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to get rid of all your cards. You score the points of your opponent’s cards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en quedarte sin cartas. Ganas los puntos de las cartas del rival."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à te débarrasser de toutes tes cartes. Tu marques les points des cartes de l’adversaire."
          }
        }
      }
    },
    "Werde deine Karten als Erster los. Wer keine Karten mehr hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werde deine Karten als Erster los. Wer keine Karten mehr hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to get rid of all your cards. Whoever has no cards left wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en quedarte sin cartas. Quien se queda sin ellas gana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à te débarrasser de toutes tes cartes. Qui n’a plus de cartes gagne."
          }
        }
      }
    },
    "Fülle alle Felder mit den Lösungswörtern, die die Fragen in den Pfeilfeldern verlangen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fülle alle Felder mit den Lösungswörtern, die die Fragen in den Pfeilfeldern verlangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill every square with the answers that the clues in the arrow squares ask for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena todas las casillas con las respuestas que piden las pistas de las casillas con flecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplis toutes les cases avec les réponses que demandent les indices des cases à flèche."
          }
        }
      }
    },
    "Verbinde alle Inseln mit Brücken, sodass jede Insel genau ihre Zahl an Brücken hat und alle zusammenhängen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde alle Inseln mit Brücken, sodass jede Insel genau ihre Zahl an Brücken hat und alle zusammenhängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect all islands with bridges so each island has exactly its number of bridges and all islands are linked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Une todas las islas con puentes: cada isla debe tener justo su número de puentes y todas deben quedar conectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relie toutes les îles par des ponts : chaque île doit avoir exactement son nombre de ponts, et toutes doivent être reliées."
          }
        }
      }
    },
    "Fülle das ganze Gitter mit den Zahlen 1 bis 9, sodass jede in jeder Zeile, Spalte und jedem 3×3-Kästchen einmal steht.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fülle das ganze Gitter mit den Zahlen 1 bis 9, sodass jede in jeder Zeile, Spalte und jedem 3×3-Kästchen einmal steht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill the whole grid with 1 to 9 so each number appears once in every row, column and 3×3 box."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena toda la cuadrícula con los números del 1 al 9 de modo que cada uno aparezca una vez en cada fila, columna y cuadro de 3×3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplis toute la grille avec les chiffres de 1 à 9 pour que chacun apparaisse une fois par ligne, par colonne et par carré de 3×3."
          }
        }
      }
    },
    "Knacke den geheimen Farbcode des Computers in höchstens zehn Versuchen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knacke den geheimen Farbcode des Computers in höchstens zehn Versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crack the computer’s secret colour code in ten tries or fewer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descifra el código secreto de colores del ordenador en diez intentos como máximo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvre le code couleur secret de l’ordinateur en dix essais au maximum."
          }
        }
      }
    },
    "Komm mit deinen Karten näher an 21 als die Bank, ohne darüber zu kommen. So gewinnst du Chips.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komm mit deinen Karten näher an 21 als die Bank, ohne darüber zu kommen. So gewinnst du Chips."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get closer to 21 than the bank without going over. That wins you chips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acércate más a 21 que la banca sin pasarte. Así ganas fichas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapproche-toi plus de 21 que la banque sans le dépasser. Tu gagnes ainsi des jetons."
          }
        }
      }
    },
    "Sei der Erste, der das Feld 100 erreicht. Leitern bringen dich hoch, Wolkenrutschen runter.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei der Erste, der das Feld 100 erreicht. Leitern bringen dich hoch, Wolkenrutschen runter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to reach square 100. Ladders take you up, cloud slides take you down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en llegar a la casilla 100. Las escaleras te suben y los toboganes de nube te bajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à atteindre la case 100. Les échelles te font monter, les toboggans de nuage te font descendre."
          }
        }
      }
    },
    "Fülle in 13 Runden die Wertungstabelle mit möglichst vielen Punkten. Wer am Ende die meisten hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fülle in 13 Runden die Wertungstabelle mit möglichst vielen Punkten. Wer am Ende die meisten hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill the score sheet over 13 rounds with as many points as possible. The player with the most points at the end wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena la tabla de puntuación en 13 rondas con tantos puntos como puedas. Gana quien tenga más al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplis la grille de score en 13 manches avec un maximum de points. Celui qui en a le plus à la fin gagne."
          }
        }
      }
    },
    "Bringe alle deine Steine ins Heimfeld und trage sie als Erster ab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringe alle deine Steine ins Heimfeld und trage sie als Erster ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring all your checkers home and be the first to bear them all off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva todas tus fichas a tu zona de casa y sé el primero en sacarlas todas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramène tous tes pions dans ton jan intérieur et sois le premier à les sortir tous."
          }
        }
      }
    },
    "Bluffe geschickt und verliere keine Leben. Wer als Letzter noch Leben hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluffe geschickt und verliere keine Leben. Wer als Letzter noch Leben hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluff cleverly and avoid losing lives. The last player with lives left wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Farolea con astucia y evita perder vidas. Gana el último que conserve vidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluffe habilement et évite de perdre des vies. Le dernier joueur qui a encore des vies gagne."
          }
        }
      }
    },
    "Hole mit deinen Stichen mehr als 60 der 120 Augen. Wer das schafft, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hole mit deinen Stichen mehr als 60 der 120 Augen. Wer das schafft, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Win tricks worth more than 60 of the 120 points. Whoever does, wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana bazas por más de 60 de los 120 puntos. Quien lo logre, gana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remporte des plis valant plus de 60 des 120 points. Qui y arrive gagne."
          }
        }
      }
    },
    "Klassisch gewinnst du, wenn du das letzte Hölzchen nimmst. Im Modus Pechvogel verliert, wer es nehmen muss.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klassisch gewinnst du, wenn du das letzte Hölzchen nimmst. Im Modus Pechvogel verliert, wer es nehmen muss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Classic you win by taking the last stick. In Unlucky mode, whoever has to take it loses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Clásico gana quien toma el último palito. En el modo Cenizo pierde quien tiene que tomarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode Classique, tu gagnes en prenant la dernière allumette. En mode Malchanceux, celui qui doit la prendre perd."
          }
        }
      }
    },
    "Decke alle Felder ohne Mine auf, ohne auf eine Mine zu tippen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Decke alle Felder ohne Mine auf, ohne auf eine Mine zu tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uncover every square that has no mine, without tapping a mine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre todas las casillas sin mina sin tocar ninguna mina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvre toutes les cases sans mine sans jamais toucher une mine."
          }
        }
      }
    },
    "Sammle vier gleiche Karten und lege die Hand auf. Wer als Letzter aufliegt, ist der Esel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle vier gleiche Karten und lege die Hand auf. Wer als Letzter aufliegt, ist der Esel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect four of a kind and put your hand down. The last to do so is the donkey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reúne cuatro cartas iguales y pon la mano sobre la mesa. El último en hacerlo es el burro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rassemble quatre cartes identiques et pose la main. Le dernier à le faire est l’âne."
          }
        }
      }
    },
    "Bringe als Erster alle deine Figuren in die Zielfelder und wirf fremde Figuren zurück ins Haus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringe als Erster alle deine Figuren in die Zielfelder und wirf fremde Figuren zurück ins Haus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to bring all your pieces to the finish squares, sending rivals back home on the way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en llevar todas tus fichas a las casillas de meta y manda a las rivales de vuelta a casa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à amener tous tes pions sur les cases d’arrivée, en renvoyant ceux des rivaux à la maison."
          }
        }
      }
    },
    "Springe über Stecker und entferne sie, bis nur noch einer übrig ist. Je weniger, desto besser.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Springe über Stecker und entferne sie, bis nur noch einer übrig ist. Je weniger, desto besser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump over pegs and remove them until only one is left. The fewer left, the better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta sobre las clavijas y quítalas hasta que quede solo una. Cuantas menos queden, mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saute par-dessus les chevilles et retire-les jusqu’à ce qu’il n’en reste qu’une. Moins il en reste, mieux c’est."
          }
        }
      }
    },
    "Schließe mehr Kästchen als dein Gegner. Wer die vierte Seite zieht, bekommt das Kästchen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe mehr Kästchen als dein Gegner. Wer die vierte Seite zieht, bekommt das Kästchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close more boxes than your opponent. Whoever draws the fourth side takes the box."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra más cuadros que tu rival. Quien traza el cuarto lado se queda el cuadro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme plus de cases que ton adversaire. Qui trace le quatrième côté gagne la case."
          }
        }
      }
    },
    "Triff in elf Runden mit deinen Würfen die Zielzahlen 2 bis 12. Wer am Ende die meisten Punkte hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Triff in elf Runden mit deinen Würfen die Zielzahlen 2 bis 12. Wer am Ende die meisten Punkte hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hit the target numbers 2 to 12 with your rolls over eleven rounds. The player with the most points at the end wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acierta con tus tiradas los números objetivo del 2 al 12 en once rondas. Gana quien tenga más puntos al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atteins avec tes lancers les nombres cibles de 2 à 12 en onze manches. Celui qui a le plus de points à la fin gagne."
          }
        }
      }
    },
    "Schlage alle gegnerischen Steine oder sperre sie so ein, dass dein Gegner nicht mehr ziehen kann.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlage alle gegnerischen Steine oder sperre sie so ein, dass dein Gegner nicht mehr ziehen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture all of your opponent’s pieces or block them so they can no longer move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura todas las fichas del rival o bloquéalas para que ya no pueda mover."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture tous les pions de ton adversaire ou bloque-les pour qu’il ne puisse plus jouer."
          }
        }
      }
    },
    "Erreiche in jeder Runde als Erster 21 Punkte. Wer nach sechs Runden die meisten Runden gewonnen hat, siegt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreiche in jeder Runde als Erster 21 Punkte. Wer nach sechs Runden die meisten Runden gewonnen hat, siegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to reach 21 points in each round. Whoever wins the most of the six rounds wins the game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en llegar a 21 puntos en cada ronda. Gana quien consiga más de las seis rondas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à atteindre 21 points à chaque manche. Celui qui gagne le plus de manches sur six l’emporte."
          }
        }
      }
    },
    "Fülle alle weißen Felder mit Ziffern von 1 bis 9, sodass jede Summe stimmt und keine Ziffer darin doppelt vorkommt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fülle alle weißen Felder mit Ziffern von 1 bis 9, sodass jede Summe stimmt und keine Ziffer darin doppelt vorkommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill every white cell with digits 1 to 9 so that each sum is correct and no digit repeats within it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena todas las casillas blancas con cifras del 1 al 9 de modo que cada suma sea correcta y no se repita ninguna cifra en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplis toutes les cases blanches avec des chiffres de 1 à 9 pour que chaque somme soit juste, sans chiffre répété dans une même somme."
          }
        }
      }
    },
    "Baue die Stapel von 1 bis 10 und leere als Erster deinen Vorrat. Wer das schafft, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baue die Stapel von 1 bis 10 und leere als Erster deinen Vorrat. Wer das schafft, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build the piles from 1 to 10 and be the first to empty your stock pile. Whoever does, wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construye los montones del 1 al 10 y sé el primero en vaciar tu reserva. Quien lo logre, gana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construis les piles de 1 à 10 et sois le premier à vider ta réserve. Qui y arrive gagne."
          }
        }
      }
    },
    "Ø Dauer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avg. duration"
          }
        },
        "es": {
