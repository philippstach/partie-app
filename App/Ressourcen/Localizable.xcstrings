    "Bitte prüfe die Augen, bevor du den Wurf übernimmst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte prüfe die Augen, bevor du den Wurf übernimmst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please check the pips before you confirm the roll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba los puntos antes de confirmar la tirada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie les points avant de valider le lancer."
          }
        }
      }
    },
    "Mit Kamera lesen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Kamera lesen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read with camera"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer con la cámara"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire avec l’appareil photo"
          }
        }
      }
    },
    "Fotografiere die Würfel von oben. Du kannst jeden Wert danach noch ändern.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere die Würfel von oben. Du kannst jeden Wert danach noch ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo of the dice from above. You can still change every value afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una foto de los dados desde arriba. Después puedes cambiar cada valor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographie les dés d’en haut. Tu peux ensuite modifier chaque valeur."
          }
        }
      }
    },
    "Keine Würfel erkannt. Lege sie einzeln auf eine einfarbige Fläche, fotografiere von oben und versuche es noch einmal, oder tippe die Augen ein.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Würfel erkannt. Lege sie einzeln auf eine einfarbige Fläche, fotografiere von oben und versuche es noch einmal, oder tippe die Augen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No dice recognised. Place them apart on a plain surface, photograph from above and try again, or type in the pips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se reconocieron dados. Colócalos separados sobre una superficie lisa, haz la foto desde arriba e inténtalo de nuevo, o escribe los puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dé reconnu. Pose-les séparément sur une surface unie, photographie d’en haut et réessaie, ou saisis les points."
          }
        }
      }
    },
    "Nicht alle Würfel erkannt. Ergänze die fehlenden mit den Zifferntasten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht alle Würfel erkannt. Ergänze die fehlenden mit den Zifferntasten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not all dice recognised. Fill in the missing ones with the number keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se reconocieron todos los dados. Completa los que faltan con las teclas numéricas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les dés n’ont pas été reconnus. Complète les manquants avec les touches numériques."
          }
        }
      }
    },
