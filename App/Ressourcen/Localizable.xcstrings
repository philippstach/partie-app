    "Wirf alle Würfel und lege mindestens einen mit Punkten raus: Eine 1 zählt 100, eine 5 zählt 50.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirf alle Würfel und lege mindestens einen mit Punkten raus: Eine 1 zählt 100, eine 5 zählt 50."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll all dice and set aside at least one that scores: a 1 is worth 100, a 5 is worth 50."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira todos los dados y aparta al menos uno que puntúe: un 1 vale 100, un 5 vale 50."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez tous les dés et mettez de côté au moins un dé qui marque : un 1 vaut 100, un 5 vaut 50."
          }
        }
      }
    },
    "Drilling und Straße": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drilling und Straße"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Triples and straight"
          }
        },
        "es": {
