    "Tippe den Würfel oder den Knopf „Würfeln“. Mit einer 6 kommt eine Figur aus dem Haus und du würfelst nochmal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe den Würfel oder den Knopf „Würfeln“. Mit einer 6 kommt eine Figur aus dem Haus und du würfelst nochmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the die or the Roll button. With a 6 a piece leaves the house and you roll again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el dado o el botón Tirar. Con un 6 sale una ficha de la casa y vuelves a tirar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche le dé ou le bouton Lancer. Avec un 6, un pion sort de la maison et tu relances."
          }
        }
      }
    },
    "Tippe eine leuchtende Figur an. Landest du auf einer fremden Figur, muss sie zurück ins Haus.": {
      "localizations": {
        "de": {
