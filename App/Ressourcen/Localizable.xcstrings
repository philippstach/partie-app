          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un crucigrama en el que las pistas están dentro de la cuadrícula y una flecha indica la dirección de la respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des mots croisés dont les définitions sont dans la grille et dont une flèche indique le sens de la réponse."
          }
        }
      }
    },
    "Würfelbilder mit ihren Punkten": {
