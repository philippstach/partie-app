    "Tipp: %@%@ gegen den Joker in Auslage %lld tauschen – tippe die Auslage an.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: swap %@%@ for the joker in meld %lld – tap the meld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: cambia %@%@ por el comodín de la combinación %lld; toca la combinación."
