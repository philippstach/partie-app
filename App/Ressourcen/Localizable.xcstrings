      }
    },
    "Zeile %lld, Spalte %lld%@%@%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Row %lld, column %lld%@%@%@"
          }
        },
        "es": {
