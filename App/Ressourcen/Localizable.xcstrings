    "Kästchen schließen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kästchen schließen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close a box"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar un cuadro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer une case"
          }
        }
      }
    },
    "Die Hand füllt sich auf fünf auf. Wer zuerst keine Karten mehr hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hand füllt sich auf fünf auf. Wer zuerst keine Karten mehr hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your hand refills to five. The first player with no cards wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mano se rellena hasta cinco. Gana quien se quede sin cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta main se remplit à cinq. Le premier sans cartes gagne."
          }
        }
      }
    },
    "Sonst drehen sie sich um. Merke dir, wo was liegt: Die meisten Paare gewinnen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonst drehen sie sich um. Merke dir, wo was liegt: Die meisten Paare gewinnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Otherwise they flip back. Remember where things are: most pairs wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, se vuelven a girar. Recuerda dónde está cada una: gana quien tenga más parejas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon elles se retournent. Mémorise où elles sont : le plus de paires gagne."
          }
        }
      }
    },
    "Glauben oder zweifeln": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glauben oder zweifeln"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Believe or doubt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creer o dudar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Croire ou douter"
          }
        }
      }
    },
    "Beide decken gleichzeitig die oberste Karte auf. Die höhere (Ass am höchsten) gewinnt beide.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide decken gleichzeitig die oberste Karte auf. Die höhere (Ass am höchsten) gewinnt beide."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both flip their top card at the same time. The higher one (ace highest) wins both."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos descubren su carta de arriba a la vez. La más alta (el as la mayor) se lleva ambas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux retournent leur carte du dessus. La plus haute (l’as est le plus fort) gagne les deux."
          }
        }
      }
    },
    "Lege ein bis vier Karten verdeckt ab und behaupte, es seien Karten des geforderten Rangs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege ein bis vier Karten verdeckt ab und behaupte, es seien Karten des geforderten Rangs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay one to four cards face down and claim they are cards of the required rank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon de una a cuatro cartas boca abajo y afirma que son del valor pedido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose une à quatre cartes face cachée et affirme que ce sont des cartes du rang demandé."
          }
        }
      }
    },
    "Blau verbindet die obere mit der unteren Kante, Rot die linke mit der rechten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blau verbindet die obere mit der unteren Kante, Rot die linke mit der rechten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blue connects top and bottom, red connects left and right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Azul une el borde superior con el inferior, rojo el izquierdo con el derecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleu relie le haut et le bas, rouge relie la gauche et la droite."
          }
        }
      }
    },
    "Diagonal ziehen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagonal ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move diagonally"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover en diagonal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancer en diagonale"
          }
        }
      }
    },
    "Vorrat und Ablagen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorrat und Ablagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stock and discards"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserva y descartes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
