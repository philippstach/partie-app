          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuadrícula más pequeña de 6 × 6 casillas con los números del 1 al 6: ideal para niños y para empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une grille plus petite de 6 × 6 cases avec les chiffres de 1 à 6 – idéale pour les enfants et pour débuter."
          }
        }
      }
    },
    "Wie das klassische Sudoku, aber auch die beiden Diagonalen enthalten jede Zahl einmal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie das klassische Sudoku, aber auch die beiden Diagonalen enthalten jede Zahl einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Like classic Sudoku, but the two diagonals also contain every number once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como el sudoku clásico, pero las dos diagonales también contienen cada número una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme le sudoku classique, mais les deux diagonales contiennent aussi chaque chiffre une fois."
          }
        }
      }
    },
    "Auch die beiden Diagonalen enthalten jede Zahl von 1 bis 9 genau einmal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch die beiden Diagonalen enthalten jede Zahl von 1 bis 9 genau einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two diagonals also contain every number from 1 to 9 exactly once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dos diagonales también contienen cada número del 1 al 9 exactamente una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux diagonales contiennent aussi chaque chiffre de 1 à 9 exactement une fois."
          }
        }
      }
    },
    "Die Zahlen 1 bis 6 stehen in jeder Zeile, Spalte und jedem Kästchen aus 3 × 2 Feldern genau einmal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlen 1 bis 6 stehen in jeder Zeile, Spalte und jedem Kästchen aus 3 × 2 Feldern genau einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The numbers 1 to 6 appear exactly once in each row, column and box of 3 × 2 cells."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números del 1 al 6 aparecen exactamente una vez en cada fila, columna y caja de 3 × 2 casillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chiffres de 1 à 6 apparaissent exactement une fois dans chaque ligne, colonne et bloc de 3 × 2 cases."
          }
        }
      }
    },
    "Tippe ein Feld an und dann unten die Zahl. Der Stift merkt dir Möglichkeiten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe ein Feld an und dann unten die Zahl. Der Stift merkt dir Möglichkeiten."
