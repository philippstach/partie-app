    "Partie meldet sich nur mit den Arten, die du hier angeschaltet lässt. Ausschalten löscht alle geplanten Mitteilungen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie meldet sich nur mit den Arten, die du hier angeschaltet lässt. Ausschalten löscht alle geplanten Mitteilungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie only sends the kinds you leave switched on here. Switching off removes all scheduled notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie solo envía los tipos que dejes activados aquí. Al desactivar se eliminan todas las notificaciones programadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie n’envoie que les types que tu laisses activés ici. Désactiver supprime toutes les notifications prévues."
          }
        }
      }
    },
