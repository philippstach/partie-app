    "Mit „Sichern“ schreibst du die Runde gut. Wer zuerst 100 Punkte hat, gewinnt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Sichern“ schreibst du die Runde gut. Wer zuerst 100 Punkte hat, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Bank” adds the round to your score. The first to 100 points wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con «Asegurar» sumas la ronda a tu puntuación. Gana quien llegue antes a 100."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec « Sécuriser » tu ajoutes la manche à ton score. Le premier à 100 points gagne."
          }
        }
      }
    },
    "Mulde wählen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulde wählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a pit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir un hoyo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir un trou"
          }
        }
      }
    },
    "Pro Runde liegen drei Farb- und drei Zahlwürfel. Nimm einen Farbwürfel und einen Zahlwürfel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Runde liegen drei Farb- und drei Zahlwürfel. Nimm einen Farbwürfel und einen Zahlwürfel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each round has three colour and three number dice. Take one of each."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ronda hay tres dados de color y tres de número. Toma uno de cada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque manche a trois dés couleur et trois dés nombre. Prends-en un de chaque."
          }
        }
      }
    },
    "Rundenzahl würfeln": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rundenzahl würfeln"
          }
