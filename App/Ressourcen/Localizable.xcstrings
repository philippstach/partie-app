    "Ziel: Alle Karten nach Farben von Ass bis König auf die Ziele legen. Die Zellen parken Karten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goal: Move all cards to the foundations by suit, from Ace to King. The cells park cards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo: llevar todas las cartas a las fundaciones por palos, del As al Rey. Las celdas guardan cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "But : placer toutes les cartes sur les fondations par couleur, de l’As au Roi. Les cellules mettent des cartes de côté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel: Alle Karten nach Farben von Ass bis König auf die Ziele legen. Die Zellen parken Karten."
          }
        }
      }
    },
    "Ziel: Alle Karten nach Farben von Ass bis König auf die Ziele legen. Jede offene Karte darfst du samt allem darauf verschieben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goal: Move all cards to the foundations by suit, from Ace to King. You can move any face-up card together with everything on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo: llevar todas las cartas a las fundaciones por palos, del As al Rey. Puedes mover cualquier carta boca arriba con todo lo que tiene encima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "But : placer toutes les cartes sur les fondations par couleur, de l’As au Roi. Vous pouvez déplacer toute carte visible avec tout ce qui la recouvre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel: Alle Karten nach Farben von Ass bis König auf die Ziele legen. Jede offene Karte darfst du samt allem darauf verschieben."
          }
        }
      }
    },
    "Ziel: Alle Karten nach Farben von Ass bis König auf die vier Ziele legen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goal: Move all cards to the four foundations by suit, from Ace to King."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo: llevar todas las cartas a las cuatro fundaciones por palos, del As al Rey."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "But : placer toutes les cartes sur les quatre fondations par couleur, de l’As au Roi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel: Alle Karten nach Farben von Ass bis König auf die vier Ziele legen."
          }
        }
      }
    },
    "Ziel: Die obersten Spaltenkarten auf die Ablage legen – einen Wert höher oder tiefer. Auf einen König geht nichts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goal: Play the top column cards onto the waste pile – one higher or lower. Nothing goes on a King."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo: jugar las cartas superiores de las columnas al descarte, un valor más alto o más bajo. Sobre un Rey no va nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "But : jouer les cartes du haut des colonnes sur la défausse, d’une valeur au-dessus ou en dessous. Rien ne va sur un Roi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel: Die obersten Spaltenkarten auf die Ablage legen – einen Wert höher oder tiefer. Auf einen König geht nichts."
          }
        }
      }
    },
    "Ziel: Karten auf die Ablage legen, die einen Wert höher oder niedriger sind.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goal: Play cards one higher or one lower than the waste card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo: jugar cartas un valor más alto o más bajo que la carta del descarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "But : jouer des cartes d’une valeur supérieure ou inférieure à celle de la défausse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel: Karten auf die Ablage legen, die einen Wert höher oder niedriger sind."
          }
        }
      }
    },
    "Ziel: Paare entfernen, die zusammen 13 ergeben. Ein König geht allein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goal: Remove pairs that add up to 13. A King goes alone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo: quitar parejas que sumen 13. Un Rey se quita solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "But : retirer les paires dont la somme fait 13. Un Roi part seul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel: Paare entfernen, die zusammen 13 ergeben. Ein König geht allein."
          }
        }
      }
    },
    "Ziel: Reihen von König bis Ass in einer Farbe bilden – sie wandern von selbst ab.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goal: Build runs from King to Ace in one suit – they clear by themselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo: formar secuencias del Rey al As en un palo; se retiran solas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "But : former des suites du Roi à l’As dans une couleur ; elles partent toutes seules."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel: Reihen von König bis Ass in einer Farbe bilden – sie wandern von selbst ab."
          }
        }
      }
    },
