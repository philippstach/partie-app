    "regel.rausPflicht.info": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einer 6 musst du eine Figur aus dem Haus holen, wenn das geht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a 6 you must bring a piece out of home if you can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un 6 tienes que sacar una ficha de casa si puedes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un 6, tu dois sortir un pion de la maison si tu peux."
          }
        }
      }
    },
    "regel.rauswerfen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rauswerfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knocking out"
          }
