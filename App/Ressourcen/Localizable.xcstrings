            "state": "translated",
            "value": "%@ · aprox. %lld min"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · env. %lld min"
          }
        }
      }
    },
    "%@: %lld Partien, %lld Siege, Siegquote %lld Prozent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld games, %lld wins, win rate %lld percent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld partidas, %lld victorias, tasa de victorias %lld por ciento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : %lld parties, %lld victoires, taux de victoire %lld pour cent"
          }
        }
      }
    },
    "Jede 1 bringt 100, jede 5 bringt 50. Drei Gleiche bringen Augenzahl × 100, drei Einsen 1.000. Eine Straße aus allen Würfeln bringt 1.000.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every 1 scores 100, every 5 scores 50. Three of a kind score the face value × 100, three ones 1,000. A straight using all the dice scores 1,000."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 1 vale 100 y cada 5 vale 50. Tres iguales valen el número × 100, tres unos 1.000. Una escalera con todos los dados vale 1.000."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque 1 rapporte 100, chaque 5 rapporte 50. Trois dés identiques rapportent la valeur × 100, trois 1 rapportent 1 000. Une suite avec tous les dés rapporte 1 000."
          }
        }
      }
    },
    "Tipp: ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hint: "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pista: "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indice : "
          }
        }
      }
    },
    "App-Symbol": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App icon"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Icono de la app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Icône de l’app"
          }
        }
      }
    },
    "Nach jedem Wurf legst du mindestens einen Würfel mit Punkten raus. Gezählt wird nur, was in einem Wurf fällt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After every roll you set aside at least one scoring die. Only what falls in a single roll counts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de cada tirada apartas al menos un dado que puntúe. Solo cuenta lo que sale en una misma tirada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après chaque lancer, tu mets de côté au moins un dé qui compte. Seul ce qui tombe dans un même lancer est compté."
          }
        }
      }
    },
