    },
    "Tippe erst den Stab, von dem du nimmst, dann den Zielstab. Du darfst immer nur die oberste Scheibe nehmen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe erst den Stab, von dem du nimmst, dann den Zielstab. Du darfst immer nur die oberste Scheibe nehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the peg you take from, then the target peg. You may only take the top disc."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca primero el palo del que coges y luego el de destino. Solo puedes coger el disco de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche d’abord le piquet de départ, puis celui d’arrivée. Tu ne peux prendre que le disque du dessus."
          }
        }
      }
    },
    "Bis zur 2048": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zur 2048"
          }
        },
        "en": {
