    "Löscht Siege und Serien. Meilensteine, Rätsel und Tagesserie bleiben.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht Siege und Serien. Meilensteine, Rätsel und Tagesserie bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes wins and streaks. Milestones, puzzles and daily streak stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra victorias y rachas. Los logros, acertijos y la racha diaria se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les victoires et séries. Succès, énigmes et série quotidienne sont conservés."
          }
        }
      }
    },
