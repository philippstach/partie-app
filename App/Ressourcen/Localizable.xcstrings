    "Blendet die Spiele aus, die du unter „Spiele für Kinder“ abwählst. Ausschalten und Ändern der Auswahl verlangt Face ID oder den Gerätecode.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Spiele aus, die du unter „Spiele für Kinder“ abwählst. Ausschalten und Ändern der Auswahl verlangt Face ID oder den Gerätecode."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides the games you deselect under “Games for kids”. Switching it off or changing the selection requires Face ID or the device passcode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta los juegos que desmarques en «Juegos para niños». Desactivarlo o cambiar la selección requiere Face ID o el código del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les jeux que tu décoches sous « Jeux pour enfants ». Le désactiver ou modifier la sélection demande Face ID ou le code de l’appareil."
          }
        }
      }
    },
