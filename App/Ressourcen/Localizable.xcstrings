        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una línea, el %@ solo está en una caja. Se descarta del resto de esa caja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans une ligne, le %@ n’apparaît que dans un bloc. Il est éliminé du reste de ce bloc."
          }
        }
      }
    },
    "Jeder Schritt lässt sich zurücknehmen, auch Notizen – beliebig oft.": {
