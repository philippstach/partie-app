    "Tipp: Das kann nicht stimmen – anzweifeln lohnt sich.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Das kann nicht stimmen – anzweifeln lohnt sich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: This cannot be true – calling it is worth it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: Esto no puede ser cierto – conviene dudar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil : Ce n’est pas possible – contester vaut la peine."
          }
        }
      }
    },
    "Tipp: Die Ansage ist nur zu etwa %lld %% wahr – anzweifeln lohnt sich.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Die Ansage ist nur zu etwa %lld %% wahr – anzweifeln lohnt sich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: The claim is only about %lld %% likely – calling it is worth it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: La afirmación solo es cierta en un %lld %% – conviene dudar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil : L’affirmation n’est vraie qu’à environ %lld %% – contester vaut la peine."
          }
