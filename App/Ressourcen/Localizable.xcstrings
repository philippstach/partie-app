    "Chance auf die Zielzahl %lld im nächsten Wurf: %lld Prozent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chance of rolling the target number %lld on the next throw: %lld percent"
