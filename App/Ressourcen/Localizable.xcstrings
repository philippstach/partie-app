    "Partie ist mit Apples Bausteinen gebaut (Swift, SwiftUI, Swift Charts). Keine fremden Bibliotheken, keine Werbung, kein Tracking.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie ist mit Apples Bausteinen gebaut (Swift, SwiftUI, Swift Charts). Keine fremden Bibliotheken, keine Werbung, kein Tracking."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie is built with Apple’s own frameworks (Swift, SwiftUI, Swift Charts). No third-party libraries, no ads, no tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie está hecha con los componentes de Apple (Swift, SwiftUI, Swift Charts). Sin bibliotecas externas, sin anuncios, sin seguimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie est conçue avec les composants d’Apple (Swift, SwiftUI, Swift Charts). Aucune bibliothèque tierce, aucune publicité, aucun suivi."
          }
        }
      }
    },
