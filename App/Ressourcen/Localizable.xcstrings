    },
    "Bei Brettspielen für zwei Personen am selben Gerät steht ein Band mit Namen und Hinweis auch auf dem Kopf für die Person gegenüber.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Brettspielen für zwei Personen am selben Gerät steht ein Band mit Namen und Hinweis auch auf dem Kopf für die Person gegenüber."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In board games for two people on one device, a bar with name and hint also appears upside down for the person opposite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En juegos de tablero para dos personas en el mismo dispositivo, aparece una barra con el nombre y la indicación también boca abajo para quien está enfrente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les jeux de plateau à deux sur le même appareil, une barre avec le nom et l’indication s’affiche aussi à l’envers pour la personne en face."
          }
        }
      }
    },
    "Gegenübersitzende spielen zusammen. Ein fertiger Spieler setzt aus, sein Partner spielt weiter. Das Team gewinnt, sobald beide alle Figuren im Ziel haben.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegenübersitzende spielen zusammen. Ein fertiger Spieler setzt aus, sein Partner spielt weiter. Das Team gewinnt, sobald beide alle Figuren im Ziel haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Players sitting opposite each other play together. A finished player sits out while their partner keeps playing. The team wins as soon as both have all pieces home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quienes se sientan enfrente juegan juntos. Quien termina se salta turnos y su compañero sigue jugando. El equipo gana cuando ambos tienen todas las fichas en la meta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les joueurs assis face à face jouent ensemble. Un joueur arrivé passe son tour, son partenaire continue. L’équipe gagne dès que les deux ont toutes leurs pions à l’arrivée."
          }
        }
      }
    },
