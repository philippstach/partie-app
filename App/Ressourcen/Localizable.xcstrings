    "Wer ein Spiel abbricht, nachdem er schon geraten hat, verliert es. So lässt sich die Serie nicht durch Abbrechen retten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting a game after you have already guessed counts as a loss, so you can’t save your streak by quitting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien abandona una partida después de haber adivinado, la pierde. Así no se puede salvar la racha abandonando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner une partie après avoir déjà deviné la fait perdre. On ne peut donc pas sauver sa série en abandonnant."
          }
        }
      }
    },
