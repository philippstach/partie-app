        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque joueur doit avoir un nom."
          }
        }
      }
    },
    "Setzt diese Partie fort": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt diese Partie fort"
          }
        },
