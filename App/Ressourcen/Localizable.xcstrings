            "state": "translated",
            "value": "Un joueur : toi contre la gravité."
          }
        }
      }
    },
    "Ziehen: verschieben · Tippen: drehen · Nach unten ziehen: schneller": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag: move · Tap: rotate · Drag down: faster"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastrar: mover · Tocar: girar · Arrastrar abajo: más rápido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisser : déplacer · Toucher : tourner · Glisser vers le bas : plus vite"
          }
        }
      }
    },
    "Finger ziehen bewegt deinen Schläger – Kante lenkt steiler": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
