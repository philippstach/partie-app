    "setup.hausHinweis": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Haus, um die Farbe zu wählen: erst einen Spieler, dann einen freien Platz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a home to choose the colour: first a player, then a free spot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una casa para elegir el color: primero un jugador, luego un sitio libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche une maison pour choisir la couleur : d’abord un joueur, puis une place libre."
