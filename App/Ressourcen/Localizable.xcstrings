        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca todas las cartas por palos del as al rey en los cuatro montones de destino, o despeja la mesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez toutes les cartes par couleur, de l’as au roi, sur les quatre fondations, ou videz la table."
          }
        }
      }
