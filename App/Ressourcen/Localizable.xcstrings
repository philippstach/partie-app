    "Fast jede Partie ist lösbar. Lass die Zellen nicht zu früh volllaufen und leere lieber eine Spalte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost every deal can be won. Don’t fill the cells too early; empty a column instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi todas las partidas se pueden ganar. No llenes las celdas demasiado pronto; mejor vacía una columna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presque toutes les donnes sont gagnables. Ne remplissez pas les cellules trop tôt ; videz plutôt une colonne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast jede Partie ist lösbar. Lass die Zellen nicht zu früh volllaufen und leere lieber eine Spalte."
          }
        }
      }
    },
