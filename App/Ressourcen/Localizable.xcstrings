    "„Sofort zeigen“ vergleicht jede Zahl mit der Lösung. „Nur Konflikte“ markiert doppelte Zahlen in Zeile, Spalte oder Box.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Sofort zeigen“ vergleicht jede Zahl mit der Lösung. „Nur Konflikte“ markiert doppelte Zahlen in Zeile, Spalte oder Box."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Show immediately” compares every number with the solution. “Conflicts only” marks duplicate numbers in a row, column or box."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Mostrar al instante» compara cada número con la solución. «Solo conflictos» marca números repetidos en fila, columna o caja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Afficher tout de suite » compare chaque chiffre à la solution. « Conflits uniquement » marque les doublons dans une ligne, colonne ou bloc."
          }
        }
      }
    },
