    "Hast du alle Würfel rausgelegt, darfst du mit allen wieder würfeln. Die Punkte bleiben dir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have set aside all the dice, you may roll them all again. You keep the points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si has apartado todos los dados, puedes volver a tirarlos todos. Conservas los puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu as mis tous les dés de côté, tu peux tous les relancer. Tu gardes les points."
          }
        }
      }
    },
    "Einzelne Kapitel": {
      "localizations": {
