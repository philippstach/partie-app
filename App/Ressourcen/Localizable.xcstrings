            "value": "Eine Spielzeit-Grenze stellst du in iOS unter Einstellungen > Bildschirmzeit ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You set a play-time limit in iOS under Settings > Screen Time."
